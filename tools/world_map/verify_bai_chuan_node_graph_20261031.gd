extends SceneTree

func _initialize() -> void:
	var graph = load("res://gdscripts/world/BaiChuanNodeGraph.gd").new()
	assert(graph.load_layout())
	assert(graph.positions.size() == 444 and graph.edge_km.size() == 575)
	assert(graph.node_for_runtime_id("east_woods") == "bc_place_070")
	assert(graph.runtime_id_for_node("bc_place_001") == "yuxu_xianzong_core")
	assert(graph.node_for_runtime_id("guanshan_prefecture") == "")
	assert(is_equal_approx(graph.hours_for_km(40,100),24.0))
	assert(is_equal_approx(graph.hours_for_km(40,200),12.0))
	var route: Array[String] = graph.shortest_path("bc_place_001","bc_place_003")
	assert(route.size() > 1 and route[0] == "bc_place_001" and route[-1] == "bc_place_003")
	assert(graph.path_km(route) > 0.0 and graph.path_km(route) < INF)
	var reversed: Array[String] = route.duplicate()
	reversed.reverse()
	assert(is_equal_approx(graph.path_km(route),graph.path_km(reversed)))
	assert(graph.shortest_path("missing","bc_place_001").is_empty())
	var travel = load("res://gdscripts/world/BaiChuanNodeTravel.gd").new()
	assert(travel.initialize("bc_place_001"))
	var preview: Dictionary = travel.preview("bc_place_003",100)
	assert(is_equal_approx(preview.hours, graph.hours_for_km(preview.kilometres,100)))
	var path: Array[String] = []
	path.assign(preview.path)
	assert(travel.begin(path))
	var first: Dictionary = travel.next_step(100)
	assert(not travel.commit_step("invalid") and travel.current_node == "bc_place_001")
	assert(travel.commit_step(first.to))
	var saved: Dictionary = travel.persistent_state()
	var restored = load("res://gdscripts/world/BaiChuanNodeTravel.gd").new()
	assert(restored.initialize("bc_place_001") and restored.restore_state(saved))
	assert(restored.current_node == first.to and restored.next_step(100) == travel.next_step(100))
	var invalid := {"current_node":first.to,"remaining_route":[first.to,"missing"]}
	assert(not restored.restore_state(invalid) and restored.current_node == first.to)
	print("BAICHUAN_NODE_GRAPH_OK")
	quit()
