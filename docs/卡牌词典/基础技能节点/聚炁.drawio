        <mxCell id="title" value="人物技能节点 · 炁根脉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5efdf;strokeColor=#9a8967;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="420" height="72" as="geometry"/></mxCell>
        <mxCell id="source" value="本源枢纽&#xa;炁根脉&#xa;灵慧 ≥ 8&#xa;术法造诣 ≥ 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e0cd;strokeColor=#8a7553;fontSize=17;" vertex="1" parent="1"><mxGeometry x="72" y="228" width="260" height="180" as="geometry"/></mxCell>
        <mxCell id="main" value="技能名：聚炁&#xa;资源路径：res://resources/activeskills/聚炁.tres&#xa;类型：术诀&#xa;关键词：无&#xa;耗费：体力 1、法力 0&#xa;目标：自身&#xa;效果：获得炁 2&#xa;来源：人物技能节点网·炁根脉&#xa;描述：凝炁于内，以候周天。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="640" height="300" as="geometry"/></mxCell>
        <mxCell id="note" value="公共炁规则&#xa;炁不是法力或费用。达到当前法力上限两倍时，清空炁并将法力恢复至上限，随后结算周天效果。&#xa;一次获得事件最多结算一次周天；超额炁清除；法力上限为 0 时不触发。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c4a95d;fontSize=16;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1120" y="198" width="310" height="228" as="geometry"/></mxCell>
        <mxCell id="edge1" value="参悟后收入技能库" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="source" target="main"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge2" value="依照" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="main" target="note"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
