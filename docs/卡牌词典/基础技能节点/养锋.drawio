        <mxCell id="title" value="人物技能卡 · 剑式初传授予" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5efdf;strokeColor=#9a8967;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="520" height="72" as="geometry"/></mxCell>
        <mxCell id="source" value="剑式初传节点&#xa;体魄 ≥ 6&#xa;剑道造诣 ≥ 6&#xa;一次解锁四招" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e0cd;strokeColor=#8a7553;fontSize=17;" vertex="1" parent="1"><mxGeometry x="55" y="255" width="245" height="190" as="geometry"/></mxCell>
        <mxCell id="main" value="技能名：养锋&#xa;资源路径：res://resources/activeskills/剑修基础/养锋.tres&#xa;类型：守御&#xa;关键词：剑、&lt;u&gt;剑意&lt;/u&gt;&#xa;耗费：体力 1、法力 0&#xa;目标：自身&#xa;效果：获得1层&lt;u&gt;剑意&lt;/u&gt;&#xa;来源：剑式初传节点（四招同时解锁）&#xa;描述：以气血固本，养剑锋与剑意。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1"><mxGeometry x="370" y="185" width="650" height="310" as="geometry"/></mxCell>
        <mxCell id="note" value="参悟后收入技能库&#xa;需由玩家手动装配。&#xa;&#xa;剑意上限10层；战斗结束时清除。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c4a95d;fontSize=16;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1080" y="185" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="edge1" value="统一节点授予" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="source" target="main"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge2" value="剑意上限" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="main" target="note"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
