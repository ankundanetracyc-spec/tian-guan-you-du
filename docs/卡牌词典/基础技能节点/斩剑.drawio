  <diagram id="node-sword-cut" name="斩剑">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="人物技能卡 · 剑式初传授予" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5efdf;strokeColor=#9a8967;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="28" width="520" height="72" as="geometry"/></mxCell>
        <mxCell id="source" value="剑式初传节点&#xa;体魄 ≥ 6&#xa;剑道造诣 ≥ 6&#xa;一次解锁四招" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e0cd;strokeColor=#8a7553;fontSize=17;" vertex="1" parent="1"><mxGeometry x="72" y="228" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="main" value="技能名：斩剑&#xa;资源路径：res://resources/activeskills/剑修基础/斩剑.tres&#xa;类型：攻伐&#xa;关键词：剑&#xa;耗费：体力 1、法力 0&#xa;目标：相邻1名敌人&#xa;出手分类：近身&#xa;效果：造成 A 点物理伤害。A=round(4 + 体魄×0.45 + 剑道造诣×0.55)&#xa;来源：人物技能节点网·剑修脉面&#xa;描述：斩击相邻敌人，以剑锋试其所学。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="640" height="360" as="geometry"/></mxCell>
        <mxCell id="note" value="同节点授予&#xa;斩剑、养锋、格剑、尽锋&#xa;参悟后收入技能库，需手动装配。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c4a95d;fontSize=16;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1120" y="198" width="310" height="180" as="geometry"/></mxCell>
        <mxCell id="edge1" value="参悟后收入技能库" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="source" target="main"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge2" value="四招同授" style="endArrow=block;html=1;strokeColor=#8a7553;fontSize=15;" edge="1" parent="1" source="main" target="note"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
