        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：回锋添痕&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/折枝剑谱/回锋添痕.tres&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：自身&lt;br&gt;触发：敌方攻击自身&lt;/div&gt;&lt;br&gt;状态关联：剑痕、外伤、折损、化解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="676" height="290" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="自动打出并获得化解&#xA;化解：max(1, floor(剑道造诣/6) + floor(体魄/10))&#xA;攻击者+1剑痕&#xA;攻击者有折损：化解+1并刷新折损&#xA;剑势中且攻击者有外伤：+1折损" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="230" y="480" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="role" value="定位：在敌方回合重新施加剑痕&#xA;守中回锋，重新添痕&#xA;避免摧枝一剑结算后无痕可用，并让较高体魄提高化解伤害的能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
