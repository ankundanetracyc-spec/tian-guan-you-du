        <mxCell id="title" value="回锋添痕&#xA;折枝剑谱 / 裂柯卷 / 主修习得*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1">
