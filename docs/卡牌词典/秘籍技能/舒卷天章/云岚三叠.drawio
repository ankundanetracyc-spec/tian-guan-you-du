<mxfile host="app.diagrams.net">
  <diagram name="云岚三叠">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main" value="云岚三叠&#10;关键词：剑、剑意&#10;耗费：体力 2&#10;目标：指定1名敌方&#10;出手方式：近身&#10;效果：造成A点（A=round(5 + 体魄×0.40 + 剑道造诣×0.50)）物理伤害。首段命中后，以C（C=clamp(40% + 本次行动开始时剑意层数×5% + 剑道造诣×0.5%,40%,80%)）概率追加攻击；追加攻击命中后，依次以D（D=max(0%,C−20个百分点)）、E（E=max(0%,C−40个百分点)）概率继续追加，最多追加3段。任一概率判定失败、攻击未命中或目标离场，后续攻击停止。每段追加攻击均攻击原目标，造成B点（B=round(2 + 体魄×0.20 + 剑道造诣×0.30 + max(本次行动开始时剑意层数−6,0))）物理伤害。；；；；。&#10;冷却：无" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="850" height="272" as="geometry" />
        </mxCell>
        <mxCell id="player-rules-entry" value="本图为详细版：效果后以括号列出公式；游戏内可设置简略／详细。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee8d8;strokeColor=#9a8967;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="404" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="云岚三叠 · 规则详解" id="page-rules">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:left;&quot;&gt;云岚三叠&lt;br&gt;资源路径：res://resources/activeskills/舒卷天章/云岚三叠.tres&lt;br&gt;关键词：剑、剑意&lt;br&gt;耗费：体力 2&lt;br&gt;目标：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;效果：造成A点物理伤害。首段命中后，以C概率追加攻击；追加攻击命中后，依次以D、E概率继续追加，最多追加3段。任一概率判定失败、攻击未命中或目标离场，后续攻击停止。每段追加攻击均攻击原目标，造成B点物理伤害。计算公式：A=round(5 + 体魄×0.40 + 剑道造诣×0.50)；B=round(2 + 体魄×0.20 + 剑道造诣×0.30 + max(本次行动开始时剑意层数−6,0))；C=clamp(40% + 本次行动开始时剑意层数×5% + 剑道造诣×0.5%,40%,80%)；D=max(0%,C−20个百分点)；E=max(0%,C−40个百分点)。&lt;br&gt;冷却：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="850" height="272" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>