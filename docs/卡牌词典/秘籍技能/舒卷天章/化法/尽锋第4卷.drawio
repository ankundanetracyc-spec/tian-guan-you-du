<mxfile host="app.diagrams.net">
  <diagram name="尽锋化法">
    <mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：尽锋&lt;br&gt;&lt;br&gt;化法追加：若本次行动开始时剑意已达到心法要求，且尽锋首段命中，心法追加的每段攻击伤害提高20%。尽锋命中后消耗剑意，不取消本次行动已触发的追加攻击。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="850" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
