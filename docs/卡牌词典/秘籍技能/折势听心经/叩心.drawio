  <diagram id="kouxin-notes" name="策划说明">
    <mxGraphModel dx="1500" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="叩心｜策划说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebe6d6;strokeColor=#857c61;fontSize=22;" vertex="1">
          <mxGeometry x="490" y="24" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="details" parent="1" value="状态：未开放提案，尚无运行资源。&#xa;来源卷章：折势听心经第二卷察势。&#xa;拟资源路径：res://resources/activeskills/折势听心经/叩心.tres&#xa;占格：1×1；可摆1份。&#xa;耗费：体力1、法力0；不占用灵识。&#xa;目标：所选行锁定的敌方目标；目标失效时按现行规则跳过，不改选。&#xa;&#xa;现有字段候选：&#xa;board_tempo_multiplier = 1.10&#xa;composure_pressure_coefficient = 0.55&#xa;&#xa;节奏倍率按新版行内交锋公式读取；定力冲击按整招占格总数及体力费用沿用现有公式，覆盖系数为0.55。效果不创建新状态，也不直接造成额外行动；定力归零后的失神按现行战斗规则。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1">
          <mxGeometry x="180" y="145" width="1140" height="610" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
