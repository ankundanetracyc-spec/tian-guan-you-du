          <mxGeometry x="130" y="180" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="card" parent="1" value="关键词：无&#xa;耗费：体力1、法力0&#xa;目标：本行锁定的敌方目标&#xa;出手方式：近身&#xa;出手节奏：本招出手值 = 人物当前有效速度 × 1.10 + 招式主属性加成；当前行出手值较高的招式先施展。&#xa;&#xa;效果：&#xa;造成A点近身物理伤害。定力冲击系数为0.55。&#xa;&#xa;计算来源：&#xa;A = round(6 + 体魄×0.40 + 体道造诣×0.30)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=20;" vertex="1">
          <mxGeometry x="450" y="150" width="700" height="510" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" source="source" target="card" edge="1" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
