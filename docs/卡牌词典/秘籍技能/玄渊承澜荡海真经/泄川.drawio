          <mxGeometry x="617" y="20" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="main" value="技能名：泄川&#xA;关键词：潮汐、炁&#xA;耗费：体力 1、法力 0&#xA;目标：自身&#xA;条件：潮汐不少于10层&#xA;效果：潮汐下降6层，获得炁2层。退潮经过潮汐节点时，立即结算对应节点效果。&#xA;使用次数：每轮1次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="634" height="209" as="geometry" />
        </mxCell>
        
        
        
        
        
        
        
        
