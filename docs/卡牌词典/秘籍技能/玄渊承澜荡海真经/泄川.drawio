          <mxGeometry x="617" y="20" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="main" value="状态：待审设计，未接入运行时。&#xA;来源：玄渊承澜荡海真经·第一卷·承澜。&#xA;条件10层与消耗6层、获得炁2层沿用水行主案。&#xA;卷章化法单列于秘籍图谱，不改写本技能卡基础效果。&#xA;待定：潮汐上限与运行时接入；本卡只调用公共潮汐与炁。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1">
