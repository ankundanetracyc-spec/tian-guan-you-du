<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="baihai-heart" name="百骸衍枝化生">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="768" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="card" value="心法被动：百骸衍枝化生&#10;关键词：气血、应对、化解&#10;效果：自身气血层数达到3层时显化第1只手臂，达到7层时显化第2只，最多显化2只。每次近身物理攻击结算时，每只显化手臂追加一段A（A=round(1 + 气血层数×0.20 + 体魄×0.12 + 体道造诣×0.20)）点（A=round(1 + 气血层数×0.15 + 体魄×0.10 + 体道造诣×0.15)）物理伤害；气血层数变化后立即重新判定显化状态。双臂显化时，受到近身物理攻击并进入伤害结算前，每个来袭技能至多判定一次，以B（B=clamp(30% + 4%×(自身气血层数−攻击者气血层数) + 0.5%×自身体魄 + 1%×体道造诣 − 0.5%×攻击者体魄, 5%, 80%)）概率自动应对并获得C层（C=round(1 + 气血层数×0.20 + 体魄×0.10 + 体道造诣×0.20)）化解；触发后，本次来袭攻击结算完毕时气血层数降低1层，并触发气血层数降低时的回复效果。&#10;主修额外效果：每段手臂追加攻击伤害提高20%。&#10;第一、二卷；第三卷起；；。&#10;显化门槛：第一卷5层；第二卷4层；第三卷4／8层；第四卷3／7层。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="48" width="1260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="player-rules-entry" value="本图为详细版：效果后以括号列出公式；游戏内可设置简略／详细。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee8d8;strokeColor=#9a8967;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="baihai-heart-rules" name="百骸衍枝化生 · 规则详解">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="card" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：百骸衍枝化生&lt;br&gt;资源路径：res://resources/activeskills/百骸衍枝化生宝册/心法.tres&lt;br&gt;关键词：气血、应对、化解&lt;br&gt;效果：自身&lt;u&gt;气血&lt;/u&gt;层数达到3层时显化第1只手臂，达到7层时显化第2只，最多显化2只。每次近身物理攻击结算时，每只显化手臂追加一段A点物理伤害；&lt;u&gt;气血&lt;/u&gt;层数变化后立即重新判定显化状态。双臂显化时，受到近身物理攻击并进入伤害结算前，每个来袭技能至多判定一次，以B概率自动&lt;u&gt;应对&lt;/u&gt;并获得C层&lt;u&gt;化解&lt;/u&gt;；触发后，本次来袭攻击结算完毕时&lt;u&gt;气血&lt;/u&gt;层数降低1层，并触发气血层数降低时的回复效果。&lt;br&gt;主修额外效果：每段手臂追加攻击伤害提高20%。&lt;br&gt;计算公式：第一、二卷A=round(1 + 气血层数×0.15 + 体魄×0.10 + 体道造诣×0.15)；第三卷起A=round(1 + 气血层数×0.20 + 体魄×0.12 + 体道造诣×0.20)；B=clamp(30% + 4%×(自身气血层数−攻击者气血层数) + 0.5%×自身体魄 + 1%×体道造诣 − 0.5%×攻击者体魄, 5%, 80%)；C=round(1 + 气血层数×0.20 + 体魄×0.10 + 体道造诣×0.20)。&lt;br&gt;显化门槛：第一卷5层；第二卷4层；第三卷4／8层；第四卷3／7层。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="48" width="1260" height="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>