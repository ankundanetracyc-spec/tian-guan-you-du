  <diagram id="baihai-cuishan-huafa" name="血臂撼岳化法">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="card" value="&lt;div style=&quot;text-align:left;&quot;&gt;技能名：血臂撼岳（百骸衍枝化生宝册化法）&lt;br&gt;资源路径：res://resources/activeskills/百骸衍枝化生宝册/化法/摧山.tres&lt;br&gt;类型：攻伐&lt;br&gt;关键词：气血&lt;br&gt;耗费：体力2、法力0&lt;br&gt;目标与射程：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;伤害类型：物理&lt;br&gt;原技能效果：造成A点物理伤害。&lt;br&gt;化法追加：至少一只手臂显化时，本技能额外追加一段A点物理伤害。&lt;br&gt;计算公式：A=round(7 + 体魄×0.55 + 体道造诣×0.25)。&lt;br&gt;使用次数：不限&lt;br&gt;冷却：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="1060" height="540" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
