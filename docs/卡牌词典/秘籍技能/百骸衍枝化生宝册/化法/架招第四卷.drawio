        <mxCell id="1" parent="0" />
        <mxCell id="card" value="化法&#10;适用范围：架招&#10;&#10;化法追加：显化至少一只手臂时，本次架招额外获得化解1层；第二只手臂显化时，额外获得B层（B=min(round(架招基础化解层数×0.20),20)）化解；本次架招实际抵消至少1点物理伤害后，若自身气血未满，获得气血1层。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="48" width="1260" height="620" as="geometry" />
        </mxCell>
        <mxCell id="player-rules-entry" value="本图为详细版：效果后以括号列出公式；游戏内可设置简略／详细。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee8d8;strokeColor=#9a8967;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
