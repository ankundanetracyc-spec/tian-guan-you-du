<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="taihe-huafa-koushan" name="乘势再攻·返元">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="card" value="&lt;div style=&quot;text-align:left;&quot;&gt;技能名：乘势再攻（太和感物养元宝册·第四卷化法）&lt;br&gt;资源路径：res://resources/activeskills/太和感物养元宝册/化法/叩山.tres&lt;br&gt;类型：攻伐&lt;br&gt;关键词：应对、僵直&lt;br&gt;耗费：体力1、法力0&lt;br&gt;目标：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;伤害类型：物理&lt;br&gt;原技能效果：造成A点物理伤害。目标以&lt;u&gt;应对&lt;/u&gt;技能应对此次攻击时，追加一段攻击；初始攻击段未造成伤害时，再追加一段攻击。两项条件分别判定，同时满足时各追加一段。&lt;br&gt;化法追加：每段由《乘势再攻》追加的攻击命中后，独立判定B；判定通过时使目标获得C层&lt;u&gt;僵直&lt;/u&gt;。&lt;br&gt;计算公式：A=round(8 + 体魄×0.65 + 体道造诣×0.2)；B=clamp(15% + 施加者体魄×1% − 目标体魄×0.75% + 卡牌境界修正 + 高境界修正, 0%, 99%)×跨境界削减倍率；C=floor(clamp(60 + (施加者体魄−目标体魄)×3, 0, 120)×跨境界削减倍率)。&lt;br&gt;使用次数：不限&lt;br&gt;冷却：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="42" width="1300" height="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
