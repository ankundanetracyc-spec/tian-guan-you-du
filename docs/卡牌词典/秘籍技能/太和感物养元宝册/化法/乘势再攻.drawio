<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17">
  <diagram id="taihe-huafa-koushan" name="乘势再攻·返元">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="card" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：乘势再攻&lt;br&gt;&lt;br&gt;化法追加：每段由《乘势再攻》追加的攻击命中后，独立判定B；判定通过时使目标获得C层&lt;u&gt;僵直&lt;/u&gt;。&lt;br&gt;计算公式：B=clamp(15% + 施加者体魄×1% − 目标体魄×0.75% + 卡牌境界修正 + 高境界修正,0%,99%)×跨境界削减倍率；C=floor(clamp(60 + (施加者体魄−目标体魄)×3,0,120)×跨境界削减倍率)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="100" y="42" width="1300" height="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
