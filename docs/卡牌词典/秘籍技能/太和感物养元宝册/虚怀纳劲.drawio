        <mxCell id="1" parent="0" />
        <mxCell id="card" value="&lt;div style=&quot;text-align:left;&quot;&gt;技能名：虚怀纳劲&lt;br&gt;资源路径：res://resources/activeskills/太和感物养元宝册/涵虚.tres&lt;br&gt;关键词：护盾、应对&lt;br&gt;耗费：体力1、法力0&lt;br&gt;目标：自身；位于行动队列队首且受到敌方攻击时触发&lt;br&gt;效果：获得A点&lt;u&gt;护盾&lt;/u&gt;。&lt;br&gt;计算公式：A=round(4 + 体魄×0.20 + min(体魄×0.20,神魂×0.20))。&lt;br&gt;使用次数：不限&lt;br&gt;冷却：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7eee4;strokeColor=#769078;fontSize=18;align=left;spacingLeft=18;spacingTop=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="48" width="1260" height="430" as="geometry" />
        </mxCell>
