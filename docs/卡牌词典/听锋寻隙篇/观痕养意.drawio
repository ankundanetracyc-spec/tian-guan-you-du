  <diagram id="guanhen-yangyi" name="观痕养意">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="760">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：观痕养意&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/听锋寻隙篇/观痕养意.tres&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;/div&gt;&lt;br&gt;来源：听锋寻隙篇 / 观隙卷&lt;br&gt;描述：场上存在带有剑痕的敌人时获得1层剑意；每名带有剑痕的敌人恢复2点精力，最多计算3名。&lt;br&gt;状态关联：剑意、剑痕、外伤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="689" height="290" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="关键词：消耗&#xA;场上有带剑痕敌人：获得1层剑意&#xA;每名带剑痕敌人：恢复2点精力&#xA;最多计算3名敌人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="170" y="420" width="240" height="101" as="geometry" />
        </mxCell>
        <mxCell id="role" value="主要作用：将已经施加的剑痕转为精力和剑意收益&#xA;不会消耗剑痕，也不会制造外伤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="420" width="333" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
