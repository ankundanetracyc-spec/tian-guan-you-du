  <diagram id="forest-wolf-bite" name="撕咬">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1716" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：撕咬&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/妖兽/林地凶狼/撕咬.tres&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：体力 1、法力 0、灵识 0&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：round(7 + 体魄×0.7 + 敏捷×0.8)&lt;br&gt;实时：准备 144 帧、收招 96 帧、冷却 240 帧&lt;/div&gt;&lt;br&gt;来源：林地凶狼基础技能库&lt;br&gt;描述：扑近撕咬指定敌人。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="760" height="300" as="geometry" />
        </mxCell>
        <mxCell id="left" value="来源/前置&#xA;来源分类：妖兽技能&#xA;来源兽种：林地凶狼&#xA;基础技能库：林地凶狼&#xA;前置：无" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="170" width="260" height="140" as="geometry" /></mxCell>
        <mxCell id="right" value="群猎联动&#xA;主动攻击结算后，其他存活的同阵营林地凶狼获得逐猎&#xA;逐猎由种族天赋处理，不占技能槽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="170" width="330" height="155" as="geometry" /></mxCell>
        <mxCell id="bottom" value="状态/关键词/条件&#xA;关键词：无&#xA;状态：无&#xA;主动技由敌方实时队列规划&#xA;物理攻击会触发群猎本能联动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="470" width="340" height="145" as="geometry" /></mxCell>
        <mxCell id="timing" value="时序与目标&#xA;目标类型：单体敌方&#xA;准备：144 帧&#xA;收招：96 帧&#xA;冷却：240 帧" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="470" width="350" height="145" as="geometry" /></mxCell>
        <mxCell id="e1" value="来源" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="left" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="联动" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="right"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="条件" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="bottom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="时序" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="main" target="timing"><mxGeometry relative="1" as="geometry" /></mxCell>
