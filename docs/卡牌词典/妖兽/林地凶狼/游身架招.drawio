<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="forest-wolf-guard" name="游身架招">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1716" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：游身架招&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/妖兽/林地凶狼/游身架招.tres&lt;br&gt;类型：守御牌&lt;br&gt;关键词：应对&lt;br&gt;耗费：体力 0、法力 0、灵识 0&lt;br&gt;目标：自身&lt;br&gt;应对条件：on_physical_attacked&lt;br&gt;效果：获得 2 + floor(min(体魄×0.25,神魂×0.30)) 层化解&lt;br&gt;时序：匹配来袭提前触发；否则行动条满时空放&lt;/div&gt;&lt;br&gt;来源：林地凶狼基础技能库&lt;br&gt;描述：当前槽遇到匹配来袭时立即触发；敌方物理攻击自身时自动打出。&lt;br&gt;应对触发时按本卡所列费用结算原效果；未触发应对时空放，不消耗体力、法力或使用次数，不产生效果。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="470" y="105" width="860" height="330" as="geometry" />
        </mxCell>
        <mxCell id="left" value="来源/前置&#xA;来源分类：妖兽技能&#xA;来源兽种：林地凶狼&#xA;基础技能库：林地凶狼&#xA;前置：无" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="260" height="140" as="geometry" /></mxCell>
        <mxCell id="right" value="群猎联动&#xA;响应本身不触发逐猎；仅主动攻击结算后触发群猎本能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1410" y="170" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="bottom" value="触发与限制&#xA;只检查当前槽，不持招等待&#xA;匹配物理攻击时先于攻击结算&#xA;只作用于自身，不使用法力或战斗手牌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="390" height="150" as="geometry" /></mxCell>
        <mxCell id="timing" value="状态效果&#xA;状态：化解&#xA;化解在受到伤害时消耗" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="950" y="480" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="e1" value="来源" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="left" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="联动" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="right"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="触发" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="bottom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="状态" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="main" target="timing"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
