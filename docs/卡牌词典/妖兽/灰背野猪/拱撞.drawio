        <mxCell id="main" value="卡牌名：拱撞（A=round(15 + 体魄×1.2)）。&#10;关键词：无&#10;耗费：体力 1、法力 0、灵识 0&#10;目标：单体敌人&#10;伤害类型：物理&#10;伤害：A点。&#10;实时：准备 144 帧、收招 96 帧、冷却 240 帧&#10;&#10;来源：灰背野猪基础技能库&#10;描述：以獠牙猛力拱击指定敌人。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="760" height="300" as="geometry" />
        </mxCell>
