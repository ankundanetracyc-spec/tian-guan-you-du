          <mxGeometry x="150" y="170" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="right" value="变种/替换&#10;迅蹄野猪：疾拱替换部分拱撞&#10;精英：不增加技能，仅提高最终属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1350" y="170" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bottom" value="状态/关键词/条件&#10;关键词：无&#10;状态：无&#10;主动技由敌方实时队列规划&#10;不使用法力、灵识或战斗手牌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="510" y="470" width="330" height="145" as="geometry" />
