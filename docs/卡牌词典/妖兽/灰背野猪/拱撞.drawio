        <mxCell id="timing" value="时序与目标&#10;目标类型：单体敌方&#10;准备：144 帧&#10;收招：96 帧&#10;冷却：240 帧" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
