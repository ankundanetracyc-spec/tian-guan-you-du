<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="hushen" name="护身符"><mxGraphModel page="1" pageWidth="900" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="card" value="护身符&#10;体力1、法力0；消耗一张&#10;目标：自身&#10;护盾：薄效6／良效9／优效13／极效18／满效24&#10;首次读到检查一次，未能施用则保留。&#10;使用后留下符痕，仍占原格；整理时可移出或补符。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee9d9;strokeColor=#557f70;fontSize=22;align=left;spacing=24;" vertex="1" parent="1"><mxGeometry x="70" y="60" width="750" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hushen_notes" name="策划说明"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="note" value="2026-11-09首轮候选。权威参数与使用流程见 docs/plans/百工技艺/制符/符箓首轮战斗接入候选_20261109.md。&#10;资源：res://resources/activeskills/符箓成品/hushen_{0..4}.tres。&#10;一块真实成符，占格1×2可旋转。无新增属性、资源、状态或额外行动；不作为复命、周天或化法目标。&#10;制造造诣只影响制作结果，不在战斗追加倍率。旧雷击/爆炎不沿用。" style="whiteSpace=wrap;html=0;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="850" height="280" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
