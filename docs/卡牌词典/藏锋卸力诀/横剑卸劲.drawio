        <mxCell id="1" parent="0" />
        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：横剑卸劲&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/藏锋卸力诀/横剑卸劲.tres&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：自身&lt;/div&gt;&lt;br&gt;来源：藏锋卸力诀 / 卸锋卷&lt;br&gt;描述：敌方攻击自身时自动打出并获得化解；至少化解1点伤害后获得借力，使下一张由玩家主动打出的剑术攻击牌精力消耗减少3点。&lt;br&gt;状态关联：借力、化解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="740" height="290" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="关键词：应对&#xA;触发：敌方攻击自身&#xA;化解：至少1 + 剑道造诣÷8取整 + 体魄÷12取整&#xA;至少化解1点伤害：获得借力&#xA;借力：下一张主动剑术攻击精力消耗-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="150" y="400" width="399" height="120" as="geometry" />
        </mxCell>
        <mxCell id="role" value="主要作用：把敌人的攻击转为下一次剑术攻击的减耗&#xA;适合与高精力消耗的重剑招式配合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="750" y="400" width="346" height="72" as="geometry" />
