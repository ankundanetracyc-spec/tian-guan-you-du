        <mxCell id="title" value="踏云穿锋&#xA;流云剑经 / 行云卷 / 习得*2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1">
