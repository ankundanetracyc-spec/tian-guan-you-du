  <diagram id="yunxingdishi" name="云行递锋">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="云行递锋&#xA;流云剑经 / 叠云卷 / 化法加入*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="670" y="20" width="343" height="71" as="geometry" />
        </mxCell>
        <mxCell id="main" value="&lt;div style=&quot;text-align:center;&quot;&gt;卡牌名：云行递锋&lt;/div&gt;&lt;div style=&quot;text-align:left;&quot;&gt;资源路径：res://resources/activeskills/流云剑经/云行递锋.tres&lt;br&gt;类型：遁身牌&lt;br&gt;关键词：消耗&lt;br&gt;耗费：精力 2、法力 1&lt;br&gt;目标：自身&lt;/div&gt;&lt;br&gt;来源：流云剑经 / 叠云卷&lt;br&gt;描述：云行递锋，剑随身转。移动1格；本次自身行动期间下一张由玩家主动打出的剑术攻击牌命中后追加一次追击；处于流云剑势时，下一次自身行动开始时少消耗1层剑意。&lt;br&gt;状态关联：剑意、流云剑势" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="740" height="290" as="geometry" />
        </mxCell>
        <mxCell id="left" value="来源/前置&#xA;来源秘籍：流云剑经&#xA;来源卷：叠云卷&#xA;化法加入数量：1&#xA;基础技能库额外加入 云行递锋*1&#xA;取消化法后移除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="190" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="right" value="流派定位&#xA;同系：流云剑经&#xA;定位：移动后让下一次主动剑术攻击追加追击，并降低剑势的维持消耗&#xA;出招顺序：遁身 -&gt; 出剑 -&gt; 追击 -&gt; 维持剑势&#xA;不替代主修习得牌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1355" y="190" width="300" height="148" as="geometry" />
        </mxCell>
        <mxCell id="bottom" value="状态/关键词/条件&#xA;关键词：消耗&#xA;移动1格&#xA;本次自身行动期间下一张由玩家主动打出的剑术攻击牌命中后，追加1次流云追击&#xA;这次追击不会再次触发追击&#xA;处于流云剑势：下一次自身行动开始时维持消耗-1剑意，最低为0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="424" height="132" as="geometry" />
        </mxCell>
        <mxCell id="note" value="数值摘要&#xA;位移：1格&#xA;追击：下一张剑攻击命中后触发1次&#xA;下一次自身行动开始时维持：剑意消耗-1&#xA;消耗资源：法力1 + 精力14&#xA;化法加入数量：1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="470" width="240" height="132" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="化法加入" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="left" target="main">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="定位" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="状态/条件" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="main" target="bottom">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="数值" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="main" target="note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
