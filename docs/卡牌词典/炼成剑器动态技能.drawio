<mxfile host="app.diagrams.net"><diagram name="炼成剑器动态技能" id="forged-sword"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="summon" value="御用·器名&#xa;体力1，法力0；目标自身&#xa;器体=本器BodyMaximum&#xa;在场灵识=本器SpiritRequired&#xa;只召出，不造成伤害" style="rounded=0;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="310" height="180" as="geometry"/></mxCell><mxCell id="use" value="御使·器名（同一技能位置）&#xa;体力1，法力1，临时灵识1&#xa;物伤=summon物伤值；无视本剑锋锐点物防&#xa;自身护盾=summon护盾值&#xa;有伤害单个敌方，否则自身；剑关键词&#xa;结束归还临时灵识，离场归还在场占用" style="rounded=0;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="470" y="80" width="440" height="180" as="geometry"/></mxCell><mxCell id="edge" edge="1" parent="1" source="summon" target="use" value="召出成功后同槽变换"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="direct" value="借器·器名&#xa;体力1，法力1，临时灵识1&#xa;物伤=direct物伤值；自身护盾=direct护盾值&#xa;有伤害单个敌方，否则自身；剑关键词&#xa;不要求器体在场；实际使用已装备本剑时忽略锋锐点物防&#xa;无正数能力则不生成对应技能&#xa;无额外行动、返费、限次或冷却" style="rounded=0;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="440" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
