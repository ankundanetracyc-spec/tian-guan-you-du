        <mxCell id="role" value="主要作用：让剑术攻击与下一次遁身衔接&#xA;推荐顺序：身随剑转 → 剑术攻击 → 惊鸿掠步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="410" width="346" height="72" as="geometry" />
