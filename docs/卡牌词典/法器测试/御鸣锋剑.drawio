  <diagram name="御·鸣锋剑">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="940">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="技能名：御·鸣锋剑&#10;&#10;关键词：增伤&#10;耗费：见召唤、御使分支或原技能说明&#10;目标：单个敌方（御使）；自身（召唤）&#10;效果：&#10;召唤：体力1，法力0；器体12，在场占灵识2。&#10;御使：体力1，法力1；基础物理伤害10，忽略20%物防。&#10;首次成功召唤只入场，后续队列执行才御使。&#10;使用次数：测试样本不限&#10;冷却：0回合" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=20;fillColor=#f4eddf;strokeColor=#54655a;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="880" height="570" as="geometry" />
        </mxCell>
        <mxCell id="3" value="仅开发测试样本，不是正式平衡数据。&#10;外祭技能占1个技能栏位；召唤与每次御使各占1个行动位。&#10;召唤失败后的御使不转成召唤；崩解及任意离场后本场禁用。&#10;法器化法在秘籍化法之后追加，同一技能最多关联1件内炼法器。" style="whiteSpace=wrap;html=0;align=left;fontSize=18;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="880" height="160" as="geometry" />
        </mxCell>
        <mxCell id="player-rules-entry" value="本图为详细版：效果后以括号列出公式；游戏内可设置简略／详细。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee8d8;strokeColor=#9a8967;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
