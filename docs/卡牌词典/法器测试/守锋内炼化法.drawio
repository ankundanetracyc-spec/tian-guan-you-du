<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="守锋剑内炼化法">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="化法&#10;适用范围：架招&#10;&#10;化法追加：实际架招的化解层数增加2；未触发应对时不追加。" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=20;fillColor=#f4eddf;strokeColor=#54655a;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="880" height="570" as="geometry" />
        </mxCell>
        <mxCell id="3" value="仅开发测试样本，不是正式平衡数据。&#10;外祭技能占1个技能栏位；召唤与每次御使各占1个行动位。&#10;召唤失败后的御使不转成召唤；崩解及任意离场后本场禁用。&#10;法器化法在秘籍化法之后追加，同一技能最多关联1件内炼法器。" style="whiteSpace=wrap;html=0;align=left;fontSize=18;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="880" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
