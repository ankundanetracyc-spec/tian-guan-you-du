  <diagram id="mingwei-baoyuan" name="明微抱元经">
    <mxGraphModel dx="3570" dy="585" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="明微抱元经 " vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="蕴神秘籍 / 仅可主修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主神魂攻杀；照痕定标、定影锁魂、见隙破抗、烛微收束" vertex="1">
          <mxGeometry height="118" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：照形&#xa;卷章ID：zhao_xing&#xa;顺序：1&#xa;定位：观其形，定其魂；神魂定标入门&#xa;学成可修至：云息三层&#xa;学习条件：&#xa;灵根：任意&#xa;路径：未确定或蕴神&#xa;境界：凡人境界及以上&#xa;研读属性：灵慧≥5；神魂≥5；术法造诣≥4&#xa;学会永久属性：灵慧+2，神魂+1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+18%&lt;br&gt;心境回复+18%" vertex="1">
          <mxGeometry height="82" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;纳气基础技能库 + 照形*1&lt;br&gt;灵击*1 -&amp;gt; 留痕*1" vertex="1">
          <mxGeometry height="82" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：抱元观微 *1、照形 *1、留痕 *1&lt;br&gt;&lt;br&gt;抱元观微：&lt;br&gt;类型：心法牌&lt;br&gt;关键词：固有&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：进入持续整场战斗的抱元观微；每次自身行动开始后，首次造成神魂伤害命中时，向受击目标施加 1层自身来源的照痕。&lt;br&gt;说明：此牌固定出现在初始手牌。它只提供定标能力，不提供本经专属的伤害增益、物理追击或会心。&lt;br&gt;&lt;br&gt;照形：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 1、法力 2&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 5 + 神魂×0.55 + 灵慧×0.30，再 × 取限（0.75, 1.45, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 28) × 0.60)。&lt;br&gt;效果：命中后向目标施加 1层自身来源的照痕；若该目标没有自身来源的照痕，改为施加 2层。&lt;br&gt;描述：先照其形，再察其隙。&lt;br&gt;&lt;br&gt;留痕：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 4&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 8 + 神魂×0.80 + 灵慧×0.30，再 × 取限（0.65, 1.65, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 20) × 0.95)。&lt;br&gt;效果：命中后向目标施加 1层自身来源的照痕；若该目标已有自身来源的照痕，则改为施加 2层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：返照&#xa;卷章ID：fan_zhao&#xa;顺序：2&#xa;定位：应对反震，转入中段神魂攻杀&#xa;学成可修至：云息六层&#xa;学习条件：&#xa;灵根：任意&#xa;路径：蕴神&#xa;境界：云息三层及以上&#xa;前置：已学照形&#xa;研读属性：灵慧≥6；神魂≥6；术法造诣≥5&#xa;学会永久属性：灵慧+0.5，神魂+1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+15%&lt;br&gt;法力回复+15%" vertex="1">
          <mxGeometry height="82" width="260" x="410" y="685" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;纳气基础技能库 + 返照*1&lt;br&gt;灵击*1 -&amp;gt; 回光*1" vertex="1">
          <mxGeometry height="82" width="280" x="1360" y="685" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：返照 *1、回光 *1&lt;br&gt;&lt;br&gt;返照：&lt;br&gt;类型：守御牌&lt;br&gt;关键词：应对&lt;br&gt;耗费：精力 1、法力 1&lt;br&gt;目标：攻击者；由应对触发对象决定&lt;br&gt;伤害类型：神魂&lt;br&gt;反震伤害公式：5 + 神魂×0.55 + 灵慧×0.20&lt;br&gt;效果：反震最终伤害 = 基础神魂伤害 × 神魂对抗系数；攻击者带有自身来源的至少 1层照痕时，敌方攻击自身将触发反震；攻击者精准固定 -8，并受到反震伤害；向攻击者额外施加 1层自身来源的照痕。若该攻击者的自身来源照痕因此达到 3层，其本次攻击最终伤害 ×0.75。&lt;br&gt;&lt;br&gt;回光：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 6&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 12 + 神魂×1.05 + 灵慧×0.35，再 × 取限（0.60, 1.85, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 16) × 1.20)。&lt;br&gt;效果：结算伤害时，若目标的自身来源照痕恰为 2层，最终伤害额外 ×1.25；若恰为 3层，最终伤害额外 ×1.40；两项额外倍率互斥。回光不移除照痕。&lt;br&gt;描述：回照已留之痕，使神魂裂隙在层层映照中加深。&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：定影&#xa;卷章ID：ding_ying&#xa;顺序：3&#xa;定位：三痕锁魂，放大神魂伤害窗口&#xa;学成可修至：云息九层&#xa;学习条件：&#xa;灵根：任意&#xa;路径：蕴神&#xa;境界：云息六层及以上&#xa;前置：已学返照&#xa;研读属性：灵慧≥8；神魂≥8；术法造诣≥7&#xa;学会永久属性：神魂+1.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+18%&lt;br&gt;心境回复+18%" vertex="1">
          <mxGeometry height="82" width="270" x="400" y="996" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;纳气基础技能库 + 定影*1&lt;br&gt;聚息*1 -&amp;gt; 息轮*1" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：定影 *1、息轮 *1&lt;br&gt;&lt;br&gt;定影：&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 1、法力 5&lt;br&gt;目标：单体敌人&lt;br&gt;条件：目标拥有至少 3层自身来源的照痕&lt;br&gt;效果：消耗自身施加在目标身上的 3层照痕，使目标获得定影，持续至该目标下一次行动结束：不能移动、行动速度固定 -12、精准固定 -8；其受到的下一次神魂伤害倍率 ×1.35。&lt;br&gt;&lt;br&gt;息轮：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：消耗&lt;br&gt;耗费：精力 2、法力 5&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 9 + 神魂×0.85 + 灵慧×0.25，再 × 取限（0.65, 1.45, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 18) × 1.05)。&lt;br&gt;效果：若目标处于定影，最终伤害再 ×1.35。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：烛微&#xa;卷章ID：zhu_wei&#xa;顺序：4&#xa;定位：烛照魂隙，以高额神魂伤害收束&#xa;学成可修至：云息十三层&#xa;学习条件：&#xa;灵根：任意&#xa;路径：蕴神&#xa;境界：云息九层及以上&#xa;前置：已学定影&#xa;研读属性：灵慧≥10；神魂≥10；术法造诣≥9&#xa;学会永久属性：灵慧+0.5，神魂+1.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+22%&lt;br&gt;灵识恢复+20%" vertex="1">
          <mxGeometry height="82" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;纳气基础技能库 + 烛微*1&lt;br&gt;护元*1 -&amp;gt; 见隙*1" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：烛微 *1、见隙 *1&lt;br&gt;&lt;br&gt;烛微：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 3、法力 10&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 16 + 神魂×1.65 + 灵慧×0.65，再 × 取限（0.55, 1.75, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 12) × 1.50)。&lt;br&gt;效果：若目标处于定影，最终伤害再 ×1.60；若同时拥有魂隙，再 ×1.50。本次攻击不移除定影。&lt;br&gt;&lt;br&gt;见隙：&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 1、法力 4&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：神魂&lt;br&gt;伤害公式：最终伤害 = 7 + 神魂×0.65 + 灵慧×0.25，再 × 取限（0.70, 1.35, 1 + (攻击方神魂 - 受击方神魂) / (攻击方神魂 + 受击方神魂 + 18) × 0.80)。&lt;br&gt;效果：命中后向目标施加 1层自身来源的照痕；若目标处于定影，令其获得魂隙，持续至该目标下一次行动结束：下一次神魂伤害结算时，受击方神魂按原神魂×0.80参与该招式的神魂对抗公式计算。&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;属性汇总&lt;br&gt;学会永久属性：灵慧+3，神魂+5&lt;br&gt;纳气累计：修炼效率+70%，心境回复+33%，法力回复+15%，灵识恢复+20%&lt;br&gt;战斗主链：照形定标 → 留痕攻魂 → 返照反震 → 定影锁魂 → 见隙破隙 → 烛微收束。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;状态与增益&lt;br&gt;&lt;br&gt;抱元观微&lt;br&gt;自身心法；持续整场战斗。自身行动开始后，首次造成神魂伤害命中时，向受击目标施加1层自身来源的照痕。&lt;br&gt;&lt;br&gt;照痕&lt;br&gt;敌方来源型减益；每名施术者基础上限3层，只放大该施术者造成的神魂伤害；熟练度升级卡牌可提高自身来源上限；定影只消耗自身施加的3层。&lt;br&gt;&lt;br&gt;定影&lt;br&gt;敌方状态；持续至目标下一次行动结束。不能移动，行动速度-12，精准-8；下一次受到的神魂伤害×1.35。&lt;br&gt;&lt;br&gt;魂隙&lt;br&gt;敌方状态；仅对处于定影的目标施加，持续至目标下一次行动结束。下一次神魂伤害按目标原神魂×0.65结算。&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
