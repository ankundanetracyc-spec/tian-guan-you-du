<?xml version="1.0" encoding="utf-8"?>
<mxfile host="Electron" agent="Codex">
  <diagram id="cangfeng-xieli" name="藏锋卸力诀">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="藏锋卸力诀&#xA;仅辅修 · 守御剑诀 · 体魄/剑道造诣" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="600" height="79" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="秘籍定位&#xA;可作主修：否　可作辅修：是　无可修炼至的境界&#xA;适用条件：受到攻击、成功化解、护盾或借力　提供效果：降低下一张主动剑术攻击的精力消耗、提高精准、施加剑痕或获得剑意&#xA;适合搭配：重剑、流云、折枝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="900" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="第一卷：卸锋卷&#xA;顺序：1&#xA;学习要求：有灵根；体魄≥8；剑道造诣≥8&#xA;研读值：64&#xA;学会永久属性：体魄+1.5，剑道造诣+1&#xA;习得：横剑卸劲*1、借力还锋*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="400" height="138" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="横剑卸劲&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：应对&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：攻击者；由敌方攻击自身时的应对触发&lt;br&gt;触发时机：敌方攻击自身时自动触发&lt;br&gt;化解：max(1, floor(剑道造诣/8) + floor(体魄/12))&lt;br&gt;至少化解1点伤害：获得借力&lt;br&gt;借力：下一张由玩家主动打出的剑术攻击牌精力消耗-3，保留至下一次自身行动结束" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="500" height="214" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="借力还锋&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：8 + 剑道造诣×0.42 + 体魄×0.20&lt;br&gt;拥有护盾、化解或借力：精准+6&lt;br&gt;消耗借力后命中：向目标施加1剑痕" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="500" height="176" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="第二卷：守中卷&#xA;顺序：2&#xA;学习要求：已学卸锋卷；体魄≥12；剑道造诣≥12&#xA;研读值：96&#xA;学会永久属性：体魄+1.5，剑道造诣+1&#xA;习得：藏锋待发*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="850" width="400" height="138" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="藏锋待发&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;获得护盾：5 + 剑道造诣×0.18 + 体魄×0.18&lt;br&gt;护盾保留到自身下一次自身行动开始：获得1剑意&lt;br&gt;奖励守住，不无条件同时提供防御与爆发" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="900" width="500" height="176" as="geometry" />
        </mxCell>
        <mxCell id="combo" value="常用出招顺序&#xA;横剑卸劲成功化解 → 获得借力 → 借力还锋减耗、提高精准并留痕&#xA;藏锋待发 → 护盾留存 → 下回合获得剑意&#xA;与其他秘籍搭配：重剑可用借力降低下一次重击的精力消耗；流云可借此继续出招；折枝可借反制重新施加剑痕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1760" y="620" width="410" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="rule" target="v1" style="endArrow=block;html=1;" value="学习第一卷">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="v1" target="v2" style="endArrow=block;html=1;" value="满足前置">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1_left" parent="1" vertex="1" value="纳气&#xA;护心+4&#xA;物理防御+2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;">
          <mxGeometry x="570" y="420" width="270" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v1_right" parent="1" vertex="1" value="化法&#xA;格剑*1 → 横剑卸劲*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;">
          <mxGeometry x="1400" y="410" width="330" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v2_left" parent="1" vertex="1" value="纳气&#xA;护心+4&#xA;精准+2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;">
          <mxGeometry x="570" y="890" width="270" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v2_right" parent="1" vertex="1" value="化法&#xA;基础技能库额外加入 藏锋待发*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;">
          <mxGeometry x="1400" y="880" width="330" height="64" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" vertex="1" value="属性与路线汇总&#xA;学会永久属性：体魄+3，剑道造诣+2&#xA;纳气合计：护心+8，物理防御+2，精准+2&#xA;化法合计：替换1张格剑，额外加入1张藏锋待发" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;">
          <mxGeometry x="1780" y="360" width="390" height="99" as="geometry" />
        </mxCell>
        <mxCell id="ev1l" parent="1" edge="1" source="v1" target="v1_left" value="纳气" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev1r" parent="1" edge="1" source="v1" target="v1_right" value="化法" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev2l" parent="1" edge="1" source="v2" target="v2_left" value="纳气" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev2r" parent="1" edge="1" source="v2" target="v2_right" value="化法" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1" parent="1" edge="1" source="v1" target="c1" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" parent="1" edge="1" source="v2" target="c3" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1b" parent="1" edge="1" source="v1" target="c2" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="状态与关联&amp;#xA;化解：敌方攻击自身时触发，成功后获得借力。&amp;#xA;借力：自身增益；下一张主动剑术攻击精力耗费-3。&amp;#xA;护盾：先承受伤害，留存至自身下一次行动开始可转为剑意。">
          <mxGeometry x="1760" y="850" width="410" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
