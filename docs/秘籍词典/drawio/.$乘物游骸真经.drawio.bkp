        <mxCell id="e13" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="纳气"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_cards" value="习得"><mxGeometry relative="1" as="geometry" /></mxCell>
