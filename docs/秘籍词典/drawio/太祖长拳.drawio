        <mxCell id="title" value="太祖长拳&#xA;凡人武学 / 仅辅修 / 体修·拳脚 / 朴实扎实近身" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="620" y="20" width="520" height="74" as="geometry" />
        </mxCell>
        <mxCell id="overview" value="秘籍总览&#xA;只能辅修，不能作为主修功法&#xA;凡人也可学习，不要求灵根与修仙境界&#xA;四卷依次学习，每卷研读值满后学会该卷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="520" height="99" as="geometry" />
        </mxCell>
        <mxCell id="base" value="当前资源表现&#xA;四卷学完永久获得：体魄+1，体道造诣+1&#xA;装备辅修获得：体魄+0.5&#xA;招式按卷解锁：太祖长拳、进步崩拳、架梁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="310" width="520" height="99" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="第一卷：起手卷&#xA;研读值：24&#xA;学习要求：体魄≥2；体道造诣≥1&#xA;学会永久属性：体魄+0.25；体道造诣+0.25&#xA;习得：太祖长拳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
