<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="canglang-xinyin-lu" name="沧浪心印录">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="沧浪心印录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：周天溢出的炁可化为附着于技能的念；念不消耗，达到门槛后会把成长继续传给队列中的后续技能。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：溢川成念&lt;br&gt;卷章ID：yi_chuan_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：以周天溢炁为技能留下心印&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：回澜照影&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：沧浪遗响&lt;br&gt;习得：回澜照影&lt;br&gt;&lt;br&gt;沧浪遗响：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：自身技能获得炁并触发周天时，溢炁=周天前炁总量－当前周天阈值（最低为0）。溢炁至少2层时，来源技能获得念1；每次周天最多赋念1层。炁来源无法追溯至技能时，不赋念。先清空炁并恢复法力，再赋念。&lt;br&gt;主修额外效果：来源技能已有念3层或以上时，其成功结算后，给后方首个来自其他术法槽且尚未结算的主动技能赋念1。每个来源技能每回合最多触发一次；没有合法接收技能时保留本次触发机会。赋念不施展技能，也不继续传播。&lt;br&gt;&lt;br&gt;回澜照影：&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽前方或后方最近的、来自其他术法槽的主动技能实例&lt;br&gt;效果：本招式自身念为0—2层时，给本招式所在行动槽后方第一个来自其他术法槽的主动技能赋念 1；自身念达到3层时，改为给本招式所在行动槽前方最近的一个、来自其他术法槽的主动技能实例赋念 1。目标不存在时行动落空，不支付资源、不消耗次数。赋念不消耗念、不施展目标技能，也不触发其他赋念效果&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：回澜照影&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽前方或后方最近的、来自其他术法槽的主动技能实例&lt;br&gt;原技能效果：本招式自身念为0—2层时，给本招式所在行动槽后方第一个来自其他术法槽的主动技能赋念 1；自身念达到3层时，改为给本招式所在行动槽前方最近的一个、来自其他术法槽的主动技能实例赋念 1。赋念不消耗念、不施展目标技能，也不触发其他赋念效果。&lt;br&gt;化法追加：本招式念不少于1层时，原效果的目标技能额外获得念1层；每轮最多触发1次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：双流并转&lt;br&gt;卷章ID：shuang_liu_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：提高溢炁化念的效率&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：yi_chuan_1&lt;br&gt;研读属性：灵慧≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：沧海寄音&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="340" x="850" y="890" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：沧海寄音&lt;br&gt;&lt;br&gt;沧海寄音：&lt;br&gt;类型：术诀&lt;br&gt;关键词：循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方尚未结算的主动技能&lt;br&gt;效果：本招式自身念为0—2时，给本招式所在行动槽后方第一个来自其他术法槽的主动技能赋念 1；自身念达到3层时，改为给本招式所在行动槽后方最近的至多 2 个、来自不同术法槽的主动技能实例各赋念 1。后续技能不足 2 个时只赋给现有技能。赋念不消耗念、不立即施展目标技能。没有后续主动技能时本行动落空，不支付资源、不消耗次数&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="260" width="740" x="-400" y="890" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：沧海寄音&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方尚未结算的主动技能&lt;br&gt;原技能效果：本招式自身念为0—2时，给本招式所在行动槽后方第一个来自其他术法槽的主动技能赋念 1；自身念达到3层时，改为给本招式所在行动槽后方最近的至多 2 个、来自不同术法槽的主动技能实例各赋念 1。后续技能不足 2 个时只赋给现有技能。赋念不消耗念、不立即施展目标技能。&lt;br&gt;化法追加：本招式念不少于3层时，原效果的每个合法目标各额外获得念1层。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="290" x="1360" y="890" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：余音及邻&lt;br&gt;卷章ID：fan_yin_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：让念数足够的技能继续滋养后续技能&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：shuang_liu_2&lt;br&gt;研读属性：灵慧≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1390" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法沿用上一卷。&lt;br&gt;习得：无新增战斗技能&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="120" width="740" x="-400" y="1390" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：潮生万窍&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在术法槽左右相邻术法槽中的主动技能实例&lt;br&gt;原技能效果：本招式自身念为0—2层时，给左右相邻术法槽中念较少的一侧赋念 1；两侧念相同时，两侧各赋念 1。自身念达到3层时，改为给两侧各赋念 1。缺少一侧时只处理存在的一侧；没有相邻主动技能时行动落空，不支付资源、不消耗次数。赋念不消耗念、不施展目标技能，也不触发其他赋念效果。&lt;br&gt;化法追加：本招式念不少于3层时，额外令念较少的一侧获得念1层；念相等时赋予左侧。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1390" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：潮生两岸&lt;br&gt;卷章ID：nian_man_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：让高念术法把周天成长分授给后续行动槽中的术法&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：fan_yin_3&lt;br&gt;研读属性：灵慧≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +1&lt;br&gt;&lt;br&gt;习得：潮生万窍&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="1930" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：沧浪遗响&lt;br&gt;&lt;br&gt;沧浪遗响：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：自身技能获得炁并触发周天时，溢炁=周天前炁总量－当前周天阈值（最低为0）；每满2层溢炁，来源技能获得念1，每次周天最多赋念2层。若来源技能赋念前已有念6层或以上，则改为将本次应赋的念分给后方尚未结算的术法，每项1层、最多两项。炁来源无法追溯至技能时，不赋念。先清空炁并恢复法力，再赋念。来源技能达到念3层后的下一次成功结算时，给后方首个尚未结算的术法赋念1；每个来源技能本场最多触发一次。&lt;br&gt;主修额外效果：来源技能已有念3层或以上时，其成功结算后，给后方首个来自其他术法槽且尚未结算的主动技能赋念1。每个来源技能每回合最多触发一次；没有合法接收技能时保留本次触发机会。赋念不施展技能，也不继续传播。&lt;br&gt;&lt;br&gt;习得：潮生万窍&lt;br&gt;&lt;br&gt;潮生万窍：&lt;br&gt;类型：术诀&lt;br&gt;关键词：循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在术法槽左右相邻术法槽中的主动技能实例&lt;br&gt;效果：本招式自身念为0—2层时，给左右相邻术法槽中念较少的一侧赋念 1；两侧念相同时，两侧各赋念 1。自身念达到3层时，改为给两侧各赋念 1。缺少一侧时只处理存在的一侧；没有相邻主动技能时行动落空，不支付资源、不消耗次数。赋念不消耗念、不施展目标技能，也不触发其他赋念效果&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="740" x="-400" y="1930" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：潮生万窍&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在术法槽左右相邻术法槽中的主动技能实例&lt;br&gt;原技能效果：本招式自身念为0—2层时，给左右相邻术法槽中念较少的一侧赋念 1；两侧念相同时，两侧各赋念 1。自身念达到3层时，改为给两侧各赋念 1。缺少一侧时只处理存在的一侧；没有相邻主动技能时行动落空，不支付资源、不消耗次数。赋念不消耗念、不施展目标技能，也不触发其他赋念效果。&lt;br&gt;化法追加：本招式念不少于3层时，两侧各额外获得念1层；缺少一侧时仅处理存在的一侧。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1930" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：以周天溢炁给术法赋念，再由高念术法向后续行动槽中的术法传念。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;精准 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="890" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1390" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +15%&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="1930" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;炁与周天&lt;/b&gt;&lt;br&gt;炁跨轮保留，战斗结束清零；达到当前法力上限两倍时立即清空全部炁、法力回满，再结算周天效果；超额炁不保留。单次炁获得事件最多触发一次周天。&lt;br&gt;&lt;b&gt;结算顺序&lt;/b&gt;&lt;br&gt;技能支付最终费用并结算基础效果与化法；再结算来源明确的炁获得。达到阈值时先清炁、回满法力，再结算周天心法。法力实际支付为0不算支付法力。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;实战循环示例&lt;/b&gt;&lt;br&gt;例：法力上限为2，周天阈值为4。行动槽1中的回澜照影若在结算前已有炁3，再获得炁3，则周天前总量为6、溢炁2；清炁并回满法力后，回澜照影获得念1。术法达到念3后，下一次成功结算可把念1传给后续第一个包含主动术法的未结算行动槽。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界与触发顺序&lt;/b&gt;&lt;br&gt;念与炁是两种不同机制：炁决定周天，念附着于技能且战斗结束清零。周天清炁时先保存本次溢炁数，再结算法力回满与赋念。所有念效果都不消耗念；只有明确写有触发条件的技能会读取念。追加伤害不触发产炁、赋念或其他技能效果，防止递归。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑代价与限制&lt;/b&gt;&lt;br&gt;前期需要累计多次周天才能让技能达到念阈；念只强化明确读取念的技能，不直接提高整套技能。若赋念时没有后续技能，转授机会会落空。" vertex="1"><mxGeometry height="620" width="430" x="1660" y="820" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
