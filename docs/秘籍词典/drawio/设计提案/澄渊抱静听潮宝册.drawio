  <diagram id="chengyuan-tingchao-review-rules" name="澄渊抱静听潮宝册 · 规则详解">
    <mxGraphModel dx="1249" dy="614" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2600" math="0" shadow="0">
