<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device" modified="2026-10-11T12:00:00.000Z">
  <diagram id="xuanlai-fanzhen-milu" name="玄籁返真秘录">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="玄籁返真秘录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：行动槽中的技能按镜像次序依次成功结算，才会把念赋给回文中心；技能本身不复现，构筑重点是战前排队。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：三声返照&lt;br&gt;卷章ID：san_sheng_fan_zhao_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：以A—B—A三行动回文给中心技能赋念&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5；神魂≥5&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：回声入骨&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：玄籁回章&lt;br&gt;习得：回声入骨&lt;br&gt;&lt;br&gt;玄籁回章：&lt;br&gt;类型：心法&lt;br&gt;关键词：循环、爆发&lt;br&gt;效果：检查本角色已锁定的行动队列。若连续3个行动槽中的主动技能依次为A→B→A，且两个A均来自同一术法槽、B来自另一术法槽，则三项按序成功结算后，给B赋念1。每回合只处理最早完成的一组。休整、吐纳、空位、跳过或结算失败都会打断序列。&lt;br&gt;主修额外效果：每回合首次完成本卷规定的回文后，给该回文的中心技能额外赋念1。&lt;br&gt;&lt;br&gt;回声入骨：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：循环、爆发&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：法术&lt;br&gt;效果：伤害 = round(7 + 灵慧×0.45 + 神魂×0.30 + 术法造诣×0.25)，记作D；造成 D 点法术伤害。若本招式位于连续三项成功结算的 A→本技能→A 中，且两项 A 引用同一术法槽实例、与本术法槽不同，则在末项 A 结算后，对本次记录目标追加伤害；按本招式施展时记录的自身念层数计算：0—2 念为 round(D×0.35)，3—5 念为 round(D×0.55)，6 念及以上为 round(D×0.75)。原目标不再合法时随机转火。追加伤害不复制技能、不耗费资源或次数，也不再触发回响。没有合法敌方时行动落空，不支付资源、不消耗次数&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：回声入骨&lt;br&gt;类型：攻伐&lt;br&gt;关键词：循环、爆发&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(7 + 灵慧×0.45 + 神魂×0.30 + 术法造诣×0.25)，记作D；造成 D 点法术伤害。若本招式位于连续三项成功结算的 A→本技能→A 中，且两项 A 引用同一术法槽实例、与本术法槽不同，则在末项 A 结算后，对本次记录目标追加伤害；按本招式施展时记录的自身念层数计算：0—2 念为 round(D×0.35)，3—5 念为 round(D×0.55)，6 念及以上为 round(D×0.75)。原目标不再合法时随机转火。追加伤害不复制技能、不耗费资源或次数，也不再触发回响。&lt;br&gt;化法追加：本招式念不少于1层时，伤害倍率提高10%。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="510" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：五位成章&lt;br&gt;卷章ID：wu_wei_cheng_zhang_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：扩展为A—B—C—B—A五行动回文&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：san_sheng_fan_zhao_1&lt;br&gt;研读属性：灵慧≥6；神魂≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：镜里三叠&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="950" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：玄籁回章&lt;br&gt;&lt;br&gt;玄籁回章：&lt;br&gt;类型：心法&lt;br&gt;关键词：循环、爆发&lt;br&gt;效果：检查本角色已锁定的行动队列。连续5个行动槽中的主动技能须依次为A→B→C→B→A；A、B、C分别来自3个不同术法槽，重复字母须来自同一术法槽。五项按序成功结算后，给C赋念2。每回合只处理最早完成的一组，不再处理三项回文。休整、吐纳、空位、跳过或结算失败都会打断序列。&lt;br&gt;主修额外效果：每回合首次完成本卷规定的回文后，给该回文的中心技能额外赋念1。&lt;br&gt;&lt;br&gt;习得：镜里三叠&lt;br&gt;&lt;br&gt;镜里三叠：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：法术&lt;br&gt;效果：伤害 = round(8 + 灵慧×0.50 + 神魂×0.35 + 术法造诣×0.30)，记作D；造成 D 点法术伤害；本招式作为中心技能 C 结算时，记录其实际结算目标 T 与基础伤害值 D。本轮连续五个行动槽依次为主动技能 A→B→C→B→A，且 A、B 分别来自不同术法槽实例时，若五项行动均按序成功结算，则末项 A 结算后对记录目标 T 追加 round(D×0.50) 点法术伤害；D 为 C 本次公式计算出的基础伤害值。若 T 此时不合法，随机转火至 1 名当前合法敌方；没有合法敌方则不追加伤害。追加伤害按法术伤害常规规则结算。回响不重复施展技能、不另付费用、不消耗次数、不再触发回响&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="510" width="740" x="-400" y="950" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：镜里三叠&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(8 + 灵慧×0.50 + 神魂×0.35 + 术法造诣×0.30)，记作D；造成 D 点法术伤害；本招式作为中心技能 C 结算时，记录其实际结算目标 T 与基础伤害值 D。本轮连续五个行动槽依次为主动技能 A→B→C→B→A，且 A、B 分别来自不同术法槽实例时，若五项行动均按序成功结算，则末项 A 结算后对记录目标 T 追加 round(D×0.50) 点法术伤害；D 为 C 本次公式计算出的基础伤害值。若 T 此时不合法，随机转火至 1 名当前合法敌方；没有合法敌方则不追加伤害。追加伤害按法术伤害常规规则结算。回响不重复施展技能、不另付费用、不消耗次数、不再触发回响。&lt;br&gt;化法追加：完成五项回文后，回文追加伤害由round(D×0.50)提高至round(D×0.65)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="550" width="290" x="1360" y="950" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：镜声相应&lt;br&gt;卷章ID：liang_sheng_ying_zhong_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：回文中心与镜像技能共同积念&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：wu_wei_cheng_zhang_2&lt;br&gt;研读属性：灵慧≥8；神魂≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1570" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：玄籁回章&lt;br&gt;&lt;br&gt;玄籁回章：&lt;br&gt;类型：心法&lt;br&gt;关键词：循环、爆发&lt;br&gt;效果：检查本角色已锁定的行动队列。连续5个行动槽中的主动技能须依次为A→B→C→B→A；A、B、C分别来自3个不同术法槽，重复字母须来自同一术法槽。五项按序成功结算后，给C赋念2；每回合只处理最早完成的一组。休整、吐纳、空位、跳过或结算失败都会打断序列。完成回文时，B另获得念1；B出现两次仍只赋予同一术法槽中的技能。&lt;br&gt;主修额外效果：每回合首次完成本卷规定的回文后，给该回文的中心技能额外赋念1。" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="240" width="740" x="-400" y="1570" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：镜里三叠&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(8 + 灵慧×0.50 + 神魂×0.35 + 术法造诣×0.30)，记作D；造成 D 点法术伤害；本招式作为中心技能 C 结算时，记录其实际结算目标 T 与基础伤害值 D。本轮连续五个行动槽依次为主动技能 A→B→C→B→A，且 A、B 分别来自不同术法槽实例时，若五项行动均按序成功结算，则末项 A 结算后对记录目标 T 追加 round(D×0.50) 点法术伤害；D 为 C 本次公式计算出的基础伤害值。若 T 此时不合法，随机转火至 1 名当前合法敌方；没有合法敌方则不追加伤害。追加伤害按法术伤害常规规则结算。回响不重复施展技能、不另付费用、不消耗次数、不再触发回响。&lt;br&gt;化法追加：完成五项回文后，除回文中心技能外，镜像技能B额外获得念1；若B重复出现，仍只对该技能实例赋念一次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="550" width="290" x="1360" y="1570" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：连章归神&lt;br&gt;卷章ID：lian_zhang_gui_shen_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：连续两轮复现同一回文，整组得到额外念&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：liang_sheng_ying_zhong_3&lt;br&gt;研读属性：灵慧≥10；神魂≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：终章归息&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="340" x="850" y="2190" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：玄籁回章&lt;br&gt;&lt;br&gt;玄籁回章：&lt;br&gt;类型：心法&lt;br&gt;关键词：循环、爆发&lt;br&gt;效果：检查本角色已锁定的行动队列。连续5个行动槽中的主动技能须依次为A→B→C→B→A；A、B、C分别来自3个不同术法槽，重复字母须来自同一术法槽。五项按序成功结算后，给C赋念2；每回合只处理最早完成的一组。休整、吐纳、空位、跳过或结算失败都会打断序列。完成回文时，B另获得念1；B出现两次仍只赋予同一术法槽中的技能。同一组A、B、C连续两回合完成回文时，在第二回合完成后，给A、B、C各赋念1；每回合最多一次。任一回合未完成回文，或A、B、C所指术法槽、顺序发生变化，连续记录清零。&lt;br&gt;主修额外效果：每回合首次完成本卷规定的回文后，给该回文的中心技能额外赋念1。&lt;br&gt;&lt;br&gt;习得：终章归息&lt;br&gt;&lt;br&gt;终章归息：&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身；符合回文时将念赋予该回文中心技能实例&lt;br&gt;效果：恢复法力 1 点，不超过当前法力上限。若本招式所在行动槽紧接在本轮首次成功结算的五项主动技能回文 A→B→C→B→A 之后，且 A、B、C 分别来自三个不同术法槽实例，则再给中心技能 C 赋念 1。赋念不消耗念、不施展技能、不触发其他赋念效果&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="740" x="-400" y="2190" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：镜里三叠&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(8 + 灵慧×0.50 + 神魂×0.35 + 术法造诣×0.30)，记作D；造成 D 点法术伤害；本招式作为中心技能 C 结算时，记录其实际结算目标 T 与基础伤害值 D。本轮连续五个行动槽依次为主动技能 A→B→C→B→A，且 A、B 分别来自不同术法槽实例时，若五项行动均按序成功结算，则末项 A 结算后对记录目标 T 追加 round(D×0.50) 点法术伤害；D 为 C 本次公式计算出的基础伤害值。若 T 此时不合法，随机转火至 1 名当前合法敌方；没有合法敌方则不追加伤害。追加伤害按法术伤害常规规则结算。回响不重复施展技能、不另付费用、不消耗次数、不再触发回响。&lt;br&gt;化法追加：本招式念不少于6层且本轮完成五项回文时，回文追加伤害由round(D×0.50)提高至round(D×0.70)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="550" width="290" x="1360" y="2190" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：以连续行动槽中的回文次序赋念并触发非行动回响；不复制术法，也不递归。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="950" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;精准 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1570" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="2190" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;念规则&lt;/b&gt;&lt;br&gt;念逐技能实例记录并整场保留；重复排入同一术法槽共享念。施展不消耗念，战斗结束清零。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑例&lt;/b&gt;&lt;br&gt;术法槽2装入回声入骨、术法槽4装入终章归息、术法槽6装入终章归息。行动槽1至5依次安排术法槽2的回声入骨、术法槽4的终章归息、术法槽6的终章归息、术法槽4的终章归息、术法槽2的回声入骨。五项成功结算后，终章归息获得念2，终章归息获得念1。&lt;br&gt;&lt;br&gt;&lt;b&gt;限制与代价&lt;/b&gt;&lt;br&gt;回文必须占用锁定队列中连续排列的行动槽；休整、吐纳、空位及任何跳过都会断序。回文占用至少五个连续行动槽，并要求重复技能实际可用。赋念只发生在末项成功后，不复制A、B或C，也不回头改写本轮已结算技能。" vertex="1"><mxGeometry height="470" width="430" x="1660" y="900.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
