<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device" modified="2026-10-11T12:00:00.000Z">
  <diagram id="gushen-yinglai-pian" name="谷神应籁篇">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="谷神应籁篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：让空谷位术法保持0念，两侧先积念；空谷位借两侧念获得炁，并把周天结果传给后续行动槽中的术法。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：空谷受声&lt;br&gt;卷章ID：kong_gu_shou_sheng_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：以0念空山受籁为枢，要求两翼技能先积念&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5；神魂≥5&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：回岚入岫&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：虚谷承响&lt;br&gt;习得：回岚入岫&lt;br&gt;&lt;br&gt;虚谷承响：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、周天&lt;br&gt;效果：战斗开始时，按技能槽序号递增检查2至9号技能槽中的连续三槽，选取首个符合条件的组合：中心槽装配念为0的主动技能，左右槽各装配主动技能。该中心槽为“空谷位”；无符合组合时，本心法本场无效。空谷位技能成功结算后，若左右技能念均不少于3层，获得炁1；每回合最多一次。两侧念无需相等，也不会被消耗。&lt;br&gt;主修额外效果：左右技能念均不少于3层时，空谷位技能结算中若需读取自身念，改读两侧念的较低值；空谷位实际念仍为0。仅改变本次读取，不赋念、不改变空谷位判定或触发额外行动。&lt;br&gt;&lt;br&gt;回岚入岫：&lt;br&gt;类型：术诀&lt;br&gt;关键词：念&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：空谷位左右相邻技能槽中的主动技能；无有效空谷位时，取本招式所在行动槽后方最近的主动技能&lt;br&gt;效果：存在有效空谷位时，给左右相邻技能槽中的主动技能各赋念 1；不存在有效空谷位时，改给本招式所在行动槽后方第一个来自其他技能槽的主动技能赋念 1。没有合法目标时行动落空，不支付资源、不消耗次数。赋念不消耗念、不施展目标技能，也不触发其他赋念效果&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：回岚入岫&lt;br&gt;&lt;br&gt;化法追加：空谷位中心技能念为0且左右相邻技能念均不少于3层时，额外获得炁1层；每轮最多触发1次。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：两峰夹壑&lt;br&gt;卷章ID：liang_feng_jia_he_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：以两翼念层决定空山受籁所纳炁量&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：kong_gu_shou_sheng_1&lt;br&gt;研读属性：灵慧≥6；神魂≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：空山受籁&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：虚谷承响&lt;br&gt;&lt;br&gt;虚谷承响：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、周天&lt;br&gt;效果：战斗开始时，按技能槽序号递增检查2至9号技能槽中的连续三槽，选取首个符合条件的组合：中心槽装配念为0的主动技能，左右槽各装配主动技能。该中心槽为“空谷位”；无符合组合时，本心法本场无效。空谷位技能成功结算后，若左右技能念均不少于3层，获得炁1；均不少于4层时改为获得炁2，两档不叠加。每回合最多一次。两侧念无需相等，也不会被消耗。空谷位被任何来源赋念后，本场不再满足条件；即使之后移除念也不会恢复。&lt;br&gt;主修额外效果：左右技能念均不少于3层时，空谷位技能结算中若需读取自身念，改读两侧念的较低值；空谷位实际念仍为0。仅改变本次读取，不赋念、不改变空谷位判定或触发额外行动。&lt;br&gt;&lt;br&gt;习得：空山受籁&lt;br&gt;&lt;br&gt;空山受籁：&lt;br&gt;类型：术诀&lt;br&gt;关键词：念&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：获得本轮法力 1 点，不超过法力上限。若本招式位于 2至9号技能槽，且自身念为 0、左右相邻术法实例的念均不低于 4 层，再额外恢复法力 1 点；超出法力上限的恢复量不生效。本经空谷心法可将本招式作为中心空谷位，与空山受籁适用相同的纳炁和传念规则&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="740" x="-400" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：空山受籁&lt;br&gt;&lt;br&gt;化法追加：本招式位于2至9号技能槽、念为0且左右相邻主动技能念均≥4时，基础恢复法力1点后再恢复法力1点，不超过上限。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="290" x="1360" y="910" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：声分两岸&lt;br&gt;卷章ID：ze_an_chuan_deng_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：让空谷空山受籁将念传给较弱一翼&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：liang_feng_jia_he_2&lt;br&gt;研读属性：灵慧≥8；神魂≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1470" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：虚谷承响&lt;br&gt;&lt;br&gt;虚谷承响：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、周天&lt;br&gt;效果：战斗开始时，按技能槽序号递增检查2至9号技能槽中的连续三槽，选取首个符合条件的组合：中心槽装配念为0的主动技能，左右槽各装配主动技能。该中心槽为“空谷位”；无符合组合时，本心法本场无效。空谷位技能成功结算后，若左右技能念均不少于3层，获得炁1；均不少于4层时改为获得炁2，两档不叠加。每回合最多一次。两侧念无需相等，也不会被消耗。空谷位被任何来源赋念后，本场不再满足条件；即使之后移除念也不会恢复。触发本心法后，获得炁；若该次炁触发周天，先结算周天。随后给两侧念较低者赋念1层（相同则给左侧）；若触发周天，再给空谷位之后首个未结算的主动术法赋念1层。每回合最多一次；赋念不施展技能或再次触发周天。&lt;br&gt;主修额外效果：左右技能念均不少于3层时，空谷位技能结算中若需读取自身念，改读两侧念的较低值；空谷位实际念仍为0。仅改变本次读取，不赋念、不改变空谷位判定或触发额外行动。" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="300" width="740" x="-400" y="1470" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：回岚入岫&lt;br&gt;&lt;br&gt;化法追加：本招式完成本次赋念后，令念较低的一侧再获得念1；念相等时改赋左侧。无有效空谷位时，此追加效果不触发。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="290" x="1360" y="1470" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：闻雷出谷&lt;br&gt;卷章ID：wen_lei_chu_gu_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：周天后把空山受籁所成的炁路传入后续队列&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：ze_an_chuan_deng_3&lt;br&gt;研读属性：灵慧≥10；神魂≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：两峰相与&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="340" x="850" y="2010" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：两峰相与&lt;br&gt;&lt;br&gt;两峰相与：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：念&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：本招式须装配在有效空谷位一侧的相邻技能槽；自动选择1名合法敌方&lt;br&gt;伤害类型：物理伤害&lt;br&gt;效果：两侧念息聚成双峰劲力，直击敌身，造成A点物理伤害。若对侧翼技能实例念达到 4 层，伤害改为B点物理伤害；若两侧翼技能实例念均达到 4 层，伤害改为C点物理伤害，不与前项叠加。本招式未装配在有效空谷位一侧的相邻技能槽，或无合法敌方时行动落空，不支付资源、不消耗次数&lt;br&gt;计算公式：A=round(7 + 灵慧×0.40 + 神魂×0.30 + 术法造诣×0.25)；B=round(A×1.35)；C=round(A×1.60)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="280" width="740" x="-400" y="2010" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：两峰相与&lt;br&gt;&lt;br&gt;化法追加：两侧相邻术法的念均不少于4层时，本次伤害再乘1.10。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="290" x="1360" y="2010" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：保留0念空谷位，让两侧术法先积念，再以空山受籁纳炁并传递周天收益。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;精准 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="910" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;护盾获得量 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1470" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +15%&lt;br&gt;原表值待映射：法术伤害 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="2010" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;念规则&lt;/b&gt;&lt;br&gt;念附着于已装配技能实例，施展不消耗；战斗结束清零。技能重复排入队列时共用所属槽位的念层数。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑例&lt;/b&gt;&lt;br&gt;技能槽4装入两峰相与、技能槽5装入空山受籁、技能槽6装入两峰相与；行动槽1至3依次结算。先由其他来源把两侧术法养至念3，空山受籁保持0念。空山受籁结算后获得炁并给较低念一侧赋念；若触发周天，空山受籁之后本轮第一个包含主动术法的未结算行动槽中的术法获得念 1。&lt;br&gt;&lt;br&gt;&lt;b&gt;限制与代价&lt;/b&gt;&lt;br&gt;必须把空山受籁放在两个相邻技能之间并长期保持0念；条件要先由其他来源把两翼养到3层，前期几乎没有收益。念一旦落到空谷位空山受籁，本场空位机制永久失效。单次赋念不发动技能，也不沿赋念目标继续递归。&lt;br&gt;&lt;b&gt;递归边界&lt;/b&gt;&lt;br&gt;周天附加效果再次产炁时，仍按当前阈值检查；达到阈值照常清空炁并回满法力，但不再触发新的周天附加效果。" vertex="1"><mxGeometry height="470" width="430" x="1660" y="882.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
