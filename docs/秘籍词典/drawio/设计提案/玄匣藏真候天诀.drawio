<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="xuanxia-cangzhen-houtian" name="玄匣藏真候天诀">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="玄匣藏真候天诀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：战前把术法槽10的技能封入匣中，牺牲一个普通行动槽中的技能位，换取周天后自动施展封藏技能的机会。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：封末入匣&lt;br&gt;卷章ID：feng_mo_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：封藏术法槽10技能并在初周后自动施展&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：匣中惊霆&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：藏锋待时&lt;br&gt;习得：匣中惊霆&lt;br&gt;&lt;br&gt;藏锋待时：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;效果：战斗开始时，将封藏术法槽10中的技能；该技能仍显示在槽内，但不能被安排在普通行动槽中，因此少一个可编入队列的术法。每回合首次周天后，自动尝试施展该技能一次，不占普通行动槽。&lt;br&gt;主修额外效果：封藏技能因资源不足或无合法目标而施展失败时，不消耗本回合成功施展机会；本回合后续周天可重试。每回合最多成功施展一次，成功后产生的周天不能再次启匣。&lt;br&gt;&lt;br&gt;匣中惊霆：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：精力 2、法力 2&lt;br&gt;目标：普通队列施展时指定1名敌方；本经自动施展时随机选择1名合法敌方&lt;br&gt;伤害类型：法术&lt;br&gt;效果：伤害 = round(15 + 灵慧×0.90 + 术法造诣×0.60)，记作D；对目标造成 D 点法术伤害。装配在术法槽10并由本经封藏时，仅在周天后按本经心法自动尝试施展；仍照常支付费用并消耗本招式次数&lt;br&gt;使用次数：本场3次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：匣中惊霆&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：精力 2、法力 2&lt;br&gt;目标：普通队列施展时指定1名敌方；本经自动施展时随机选择1名合法敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(15 + 灵慧×0.90 + 术法造诣×0.60)，记作D；对目标造成 D 点法术伤害。装配在术法槽10并由本经封藏时，仅在周天后按本经心法自动尝试施展；仍照常支付费用并消耗本招式次数。&lt;br&gt;化法追加：本招式位于术法槽10并由本书心法自动施展时，伤害倍率提高10%。&lt;br&gt;使用次数：本场3次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="380" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：周天启匣&lt;br&gt;卷章ID：zhou_tian_qi_xia_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：把单场启匣提升为每轮启匣&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：feng_mo_1&lt;br&gt;研读属性：灵慧≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：素绢藏锋&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="340" x="850" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：藏锋待时&lt;br&gt;&lt;br&gt;藏锋待时：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;效果：战斗开始时，将封藏术法槽10中的技能；该技能仍显示在槽内，但不能被安排在普通行动槽中，因此少一个可编入队列的术法。每回合首次周天后，自动尝试施展该技能一次，不占普通行动槽。 封藏技能自动施展时，精力费用减少1点，最低为0；仍受自身回合冷却与使用次数限制。&lt;br&gt;主修额外效果：封藏技能因资源不足或无合法目标而施展失败时，不消耗本回合成功施展机会；本回合后续周天可重试。每回合最多成功施展一次，成功后产生的周天不能再次启匣。&lt;br&gt;&lt;br&gt;习得：素绢藏锋&lt;br&gt;&lt;br&gt;素绢藏锋：&lt;br&gt;类型：守御&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：精力 1、法力 1&lt;br&gt;目标：自身；若由本经心法自动施展，另选一名其他存活队友&lt;br&gt;效果：B = round(6 + 灵慧×0.20 + 神魂×0.20 + 术法造诣×0.25)；自身获得 B 点护盾。若本招式由藏锋待时在首次周天后自动施展，则场上生命比例最低的其他存活队友也获得 round(B×0.50) 点护盾；并列时随机选择。自动施展照常支付法力并消耗本招式使用次数；没有其他存活队友时只给自身护盾&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="740" x="-400" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：匣中惊霆&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：精力 2、法力 2&lt;br&gt;目标：普通队列施展时指定1名敌方；本经自动施展时随机选择1名合法敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害 = round(15 + 灵慧×0.90 + 术法造诣×0.60)，记作D；对目标造成 D 点法术伤害。装配在术法槽10并由本经封藏时，仅在周天后按本经心法自动尝试施展；仍照常支付费用并消耗本招式次数。&lt;br&gt;化法追加：由本书心法自动施展时，法力耗费减少1点，最低为0；精力费用与本招次数照常结算。&lt;br&gt;使用次数：本场3次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="290" x="1360" y="910" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：候机不失&lt;br&gt;卷章ID：bu_ji_dai_zhuan_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：资源或目标不合时保留本轮启匣机会&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：zhou_tian_qi_xia_2&lt;br&gt;研读属性：灵慧≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1450" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：藏锋待时&lt;br&gt;&lt;br&gt;藏锋待时：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;效果：战斗开始时，将封藏术法槽10中的技能；该技能仍显示在槽内，但不能被安排在普通行动槽中，因此少一个可编入队列的术法。每回合首次周天后，自动尝试施展该技能一次，不占普通行动槽。 封藏技能自动施展时，精力费用减少1点，最低为0；仍受自身回合冷却与使用次数限制。 封藏技能成功自动施展且实际支付法力后，获得炁1；每回合最多一次。成功施展标记先于产炁写入，不能借此周天再次启匣。&lt;br&gt;主修额外效果：封藏技能因资源不足或无合法目标而施展失败时，不消耗本回合成功施展机会；本回合后续周天可重试。每回合最多成功施展一次，成功后产生的周天不能再次启匣。&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="260" width="740" x="-400" y="1450" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：素绢藏锋&lt;br&gt;类型：守御&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：精力 1、法力 1&lt;br&gt;目标：自身；若由本经心法自动施展，另选一名其他存活队友&lt;br&gt;原技能效果：B = round(6 + 灵慧×0.20 + 神魂×0.20 + 术法造诣×0.25)；自身获得 B 点护盾。若本招式由藏锋待时在首次周天后自动施展，则场上生命比例最低的其他存活队友也获得 round(B×0.50) 点护盾；并列时随机选择。自动施展照常支付法力并消耗本招式使用次数；没有其他存活队友时只给自身护盾。&lt;br&gt;化法追加：由本书心法自动施展时，场上生命比例最低的其他存活队友也获得基础护盾值的50%；并列随机选择。没有其他存活队友时不追加。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="290" x="1360" y="1450" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：匣影还元&lt;br&gt;卷章ID：xia_ying_huan_yuan_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：使成功启匣重新接回炁循环&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：bu_ji_dai_zhuan_3&lt;br&gt;研读属性：灵慧≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +1&lt;br&gt;&lt;br&gt;习得：匣底余炁&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="340" x="850" y="1990" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：藏锋待时&lt;br&gt;&lt;br&gt;藏锋待时：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;效果：战斗开始时，将封藏术法槽10中的技能；该技能仍显示在槽内，但不能被安排在普通行动槽中，因此少一个可编入队列的术法。每回合首次周天后，自动尝试施展该技能一次，不占普通行动槽。 封藏技能自动施展时，精力费用减少1点，最低为0；仍受自身回合冷却与使用次数限制。 封藏技能成功自动施展且实际支付法力后，获得炁2；每回合最多一次。成功施展标记先于产炁写入，不能借此周天再次启匣。&lt;br&gt;主修额外效果：封藏技能因资源不足或无合法目标而施展失败时，不消耗本回合成功施展机会；本回合后续周天可重试。每回合最多成功施展一次，成功后产生的周天不能再次启匣。&lt;br&gt;&lt;br&gt;习得：匣底余炁&lt;br&gt;&lt;br&gt;匣底余炁：&lt;br&gt;类型：术诀&lt;br&gt;关键词：循环&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：获得炁 1。若本招式由藏锋待时在首次周天后自动施展，改为获得炁 2。该次获得炁仍最多触发一次周天；自动施展不复制本招式或再次触发藏锋待时&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="740" x="-400" y="1990" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：匣底余炁&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;原技能效果：获得炁 1。若本招式由藏锋待时在首次周天后自动施展，改为获得炁 2。该次获得炁仍最多触发一次周天；自动施展不复制本招式或再次触发藏锋待时。&lt;br&gt;化法追加：本招式由本书心法自动施展时，获得炁2层而非炁1层；该次炁获取最多触发一次周天。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="320" width="290" x="1360" y="1990" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：封存术法槽10中的招式，以少一项可编入行动队列的术法为代价，在周天后自动尝试施展。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;会心 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="910" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1450" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;法术伤害 +7%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="1990" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;炁与周天&lt;/b&gt;&lt;br&gt;炁跨轮保留，战斗结束清零；达到当前法力上限两倍时立即清空全部炁、法力回满，再结算周天效果；超额炁不保留。单次炁获得事件最多触发一次周天。&lt;br&gt;&lt;b&gt;结算顺序&lt;/b&gt;&lt;br&gt;技能支付最终费用并结算基础效果与化法；再结算来源明确的炁获得。达到阈值时先清炁、回满法力，再结算周天心法。法力实际支付为0不算支付法力。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;实战循环示例&lt;/b&gt;&lt;br&gt;术法槽10装入匣中惊霆；行动槽1至3依次安排匣底余炁、吐纳、匣底余炁。首次周天后心法自动尝试施展匣中惊霆，不占行动槽；主修时费用不足或无合法目标可在本回合下一次周天重试；辅修保留首次尝试一次的限制。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界与触发顺序&lt;/b&gt;&lt;br&gt;封藏技能仍使用自身目标规则与费用；自动施展时对敌方目标按既有自动随机转火规则选取合法敌人。成功施展才支付费用并消耗使用次数；失败不消耗。系统行动与正常队列行动不因启匣移位或复制。第三、四卷的产炁不重置本书每轮成功施展次数。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑代价与限制&lt;/b&gt;&lt;br&gt;术法槽10中的技能不能编入普通行动队列，少一项可排入队列的术法；封藏技能仍支付原有精力与法力，并消耗自身使用次数。没有完成周天时不会自动施展，自动选定的目标也可能不合当前队伍需要。" vertex="1"><mxGeometry height="640" width="430" x="1660" y="864.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
