<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="xuanji-yixing-yixu" name="璇玑移星易序篇">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="璇玑移星易序篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：周天会自动改排本角色尚未结算的行动槽中的技能，使技能先后成为构筑的一部分；重排只移动行动，不复制技能或增加行动数。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：初周易序&lt;br&gt;卷章ID：chu_zhou_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：首次周天交换后续两项行动槽中的技能&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：星移三序&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：星纬潜移&lt;br&gt;习得：星移三序&lt;br&gt;&lt;br&gt;星纬潜移：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：每回合首次完成周天后，交换本角色行动队列中接下来的两个未结算行动槽。槽内技能及已选目标一并换位；休整、空位和技能槽不移动。若剩余未结算行动槽不足2个，则不改序，也不消耗本回合的改序机会。&lt;br&gt;主修额外效果：每回合首次成功改序后，给被移到较前位置的技能标记：其下一次结算时法力费用减1点（最低为0）。结算或跳过后移除标记；回合结束时清除。&lt;br&gt;&lt;br&gt;星移三序：&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方最近三个尚未结算的行动槽&lt;br&gt;效果：将这三个行动槽中的技能由A、B、C改排为B、C、A；技能及其已选目标一并移动，三项原有队列位置作为落点。休整与空位保持原位。后续不足三项时行动落空，不支付资源、不消耗次数；改排不增加行动数&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：星移三序&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方最近三个尚未结算的行动槽&lt;br&gt;原技能效果：将这三个行动槽中的技能由A、B、C改排为B、C、A；技能及其已选目标一并移动，三项原有队列位置作为落点。休整与空位保持原位。后续不足三项时行动落空，不支付资源、不消耗次数；改排不增加行动数。&lt;br&gt;化法追加：本次成功改排后，若移至较前位置的主动术法随后实际支付至少1点法力，获得炁1；每轮最多触发1次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="380" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：逐轮换位&lt;br&gt;卷章ID：zhu_lun_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：将首次战斗重排扩展为每轮重排&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：chu_zhou_1&lt;br&gt;研读属性：灵慧≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：斗柄回寅诀&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="340" x="850" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：星纬潜移&lt;br&gt;&lt;br&gt;星纬潜移：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：每回合首次完成周天后，交换本角色行动队列中接下来的两个未结算行动槽。槽内技能及已选目标一并换位；休整、空位和技能槽不移动。若剩余未结算行动槽不足2个，则不改序，也不消耗本回合的改序机会。每回合首次成功改序后，回复法力1点，不超过当前上限。&lt;br&gt;主修额外效果：每回合首次成功改序后，给被移到较前位置的技能标记：其下一次结算时法力费用减1点（最低为0）。结算或跳过后移除标记；回合结束时清除。&lt;br&gt;&lt;br&gt;习得：斗柄回寅诀&lt;br&gt;&lt;br&gt;斗柄回寅诀：&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身行动队列中尚未结算的行动槽&lt;br&gt;效果：将本招式所在行动槽后方最近两个尚未结算的行动槽交换位置；行动槽中的技能与已选目标一同换位，休整、空位保持原位；技能槽及其所附念层不变。后续未结算行动槽少于两个时本行动落空，不支付资源、不消耗次数&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="740" x="-400" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：斗柄回寅诀&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身行动队列中尚未结算的行动槽&lt;br&gt;原技能效果：将本招式所在行动槽后方最近两个尚未结算的行动槽交换位置；行动槽中的技能与已选目标一同换位，休整、空位保持原位；技能槽及其所附念层不变。后续未结算行动槽少于两个时本行动落空，不支付资源、不消耗次数。&lt;br&gt;化法追加：若本次交换使一项最终法力费用为0的技能移至队列首位，该技能本轮恢复法力1点；不超过本轮法力上限；每轮最多触发1次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="380" width="290" x="1360" y="910" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：先行引炁&lt;br&gt;卷章ID：xian_xing_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：让被前移的实付法力技能牵引炁&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：zhu_lun_2&lt;br&gt;研读属性：灵慧≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="1430" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：星纬潜移&lt;br&gt;&lt;br&gt;星纬潜移：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：每回合首次完成周天后，交换本角色行动队列中接下来的两个未结算行动槽。槽内技能及已选目标一并换位；休整、空位和技能槽不移动。若剩余未结算行动槽不足2个，则不改序，也不消耗本回合的改序机会。每回合首次成功改序后，回复法力1点，不超过当前上限。每次成功改序后，标记被移到较前位置的行动槽。该行动成功结算且实际支付至少1点法力时，获得炁1；每回合最多一次。若该行动因资源不足、次数耗尽、目标无效或被跳过而未结算，移除标记，不转给其他行动。&lt;br&gt;主修额外效果：每回合首次成功改序后，给被移到较前位置的技能标记：其下一次结算时法力费用减1点（最低为0）。结算或跳过后移除标记；回合结束时清除。" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="280" width="740" x="-400" y="1430" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：列宿引星&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方最近五个尚未结算的行动槽&lt;br&gt;原技能效果：若五项中存在实际法力费用大于 0 的技能，且首项技能的最终法力费用为 0，则将首项与其中最近的一项实际付法技能互换；技能及其已选目标一并移动，休整与空位保持原位。首项已实际付法、五项内没有可付法技能或不足五项时行动落空，不支付资源、不消耗次数。改排不增加行动数。&lt;br&gt;化法追加：成功将实际付法术法移至较前行动槽后，该术法若结算并支付至少1点法力，获得炁1；每轮最多触发1次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1430" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：再周倒景&lt;br&gt;卷章ID：zai_zhou_dao_jing_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：第二次周天将后三项行动槽中的技能倒序&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：xian_xing_3&lt;br&gt;研读属性：灵慧≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +1&lt;br&gt;&lt;br&gt;习得：列宿引星&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="1950" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：星纬潜移&lt;br&gt;&lt;br&gt;星纬潜移：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：每回合首次完成周天后，交换本角色行动队列中接下来的两个未结算行动槽。槽内技能及已选目标一并换位；休整、空位和技能槽不移动。若剩余未结算行动槽不足2个，则不改序，也不消耗本回合的改序机会。每回合首次成功改序后，回复法力1点，不超过当前上限。每次成功改序后，标记被移到较前位置的行动槽。该行动成功结算且实际支付至少1点法力时，获得炁2；每回合最多一次。若该行动因资源不足、次数耗尽、目标无效或被跳过而未结算，移除标记，不转给其他行动。&lt;br&gt;主修额外效果：每回合首次成功改序后，给被移到较前位置的技能标记：其下一次结算时法力费用减1点（最低为0）。结算或跳过后移除标记；回合结束时清除。&lt;br&gt;&lt;br&gt;习得：列宿引星&lt;br&gt;&lt;br&gt;列宿引星：&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方最近五个尚未结算的行动槽&lt;br&gt;效果：若五项中存在实际法力费用大于 0 的技能，且首项技能的最终法力费用为 0，则将首项与其中最近的一项实际付法技能互换；技能及其已选目标一并移动，休整与空位保持原位。首项已实际付法、五项内没有可付法技能或不足五项时行动落空，不支付资源、不消耗次数。改排不增加行动数&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="510" width="740" x="-400" y="1950" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：列宿引星&lt;br&gt;类型：术诀&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：本招式所在行动槽后方最近五个尚未结算的行动槽&lt;br&gt;原技能效果：若五项中存在实际法力费用大于 0 的技能，且首项技能的最终法力费用为 0，则将首项与其中最近的一项实际付法技能互换；技能及其已选目标一并移动，休整与空位保持原位。首项已实际付法、五项内没有可付法技能或不足五项时行动落空，不支付资源、不消耗次数。改排不增加行动数。&lt;br&gt;化法追加：成功换位后，移至最前的实际付法术法获得念1；若没有该术法或换位失败则不赋念。每轮最多触发1次。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1950" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：周天后自动调整尚未结算的行动槽次序，让战前排列形成新的技能循环。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;身法 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="910" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1430" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;身法 +5%&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="150" width="270" x="370" y="1950" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;炁与周天&lt;/b&gt;&lt;br&gt;炁跨轮保留，战斗结束清零；达到当前法力上限两倍时立即清空全部炁、法力回满，再结算周天效果；超额炁不保留。单次炁获得事件最多触发一次周天。&lt;br&gt;&lt;b&gt;结算顺序&lt;/b&gt;&lt;br&gt;技能支付最终费用并结算基础效果与化法；再结算来源明确的炁获得。达到阈值时先清炁、回满法力，再结算周天心法。法力实际支付为0不算支付法力。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;实战循环示例&lt;/b&gt;&lt;br&gt;行动槽1安排列宿引星、行动槽2安排星移三序、行动槽3安排列宿引星、行动槽4安排列宿引星。列宿引星完成周天后，心法交换行动槽2与行动槽3中的术法；第三卷起，移前且实际付法的术法成功结算后可获得炁。第四卷起，该次追加产炁提高为2层。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界与触发顺序&lt;/b&gt;&lt;br&gt;重排发生在触发周天的当前行动及其全部效果结算后、下一队列行动开始前。只重排行动槽中的术法及其已选目标，不改1至10号技能槽，不移动休整或空位，不复制行动，也不改变次数和费用。若行动因失败而被跳过，不产生该行动的化法收益或炁。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑代价与限制&lt;/b&gt;&lt;br&gt;自动重排可能打乱玩家原先安排的技能衔接；队列后段若没有足够的行动槽中的技能，改序效果会减弱或落空。此书不增加行动数，只改变未结算技能的顺序。" vertex="1"><mxGeometry height="640" width="430" x="1660" y="846.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
