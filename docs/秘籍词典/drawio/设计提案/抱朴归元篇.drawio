<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="1187f491c5fc4009ad8b027014a7a47a" name="抱朴归元篇">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="抱朴归元篇" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：暂降本场法力上限，以较低门槛完成周天；用技能队列先付法力、再回复法力，铺出周天与下一术法减费的循环。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：守虚&lt;br&gt;卷章ID：shou_xu&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：以减法力上限降低周天阈值，建立付费与回复的初始循环&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：炉中微明&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：抱朴守缺&lt;br&gt;习得：炉中微明&lt;br&gt;&lt;br&gt;抱朴守缺：&lt;br&gt;类型：心法&lt;br&gt;关键词：周天&lt;br&gt;效果：装配本经后，本场战斗的法力上限临时降低1点（最低为1）；在首回合法力补给前生效，战斗结束后恢复。周天阈值按降低后的法力上限计算。每回合首次由自身主动施展且实际支付至少1点法力的技能，在技能及其化法均结算完毕后，获得炁1。跳过、无合法目标或最终法力费用为0时不触发。&lt;br&gt;主修额外效果：每回合法力补给完成后，获得炁1。&lt;br&gt;&lt;br&gt;炉中微明：&lt;br&gt;类型：术诀&lt;br&gt;关键词：周天&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：获得炁 1。若施展前炁层数不低于当前法力上限，改为获得炁 2；该次获得炁仍最多触发一次周天&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：炉中微明&lt;br&gt;&lt;br&gt;化法追加：本技能实际获得炁时，若本次未触发周天，额外获得炁1层；本追加效果每轮最多触发1次。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="300" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：抱一&lt;br&gt;卷章ID：bao_yi&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：进一步压低周天阈值，并以缺月藏炉接上法力归零后的回升&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：shou_xu&lt;br&gt;研读属性：灵慧≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：缺月藏炉&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：缺月藏炉&lt;br&gt;&lt;br&gt;缺月藏炉：&lt;br&gt;类型：术诀&lt;br&gt;关键词：周天&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：先获得炁 1；该次炁结算完毕后，将本场法力上限降低 1，最低为 1。上限改变后立即重算周天阈值，若现有炁达到新阈值，立即完成周天。法力上限已为 1 时仍获得炁 1。战斗结束恢复原上限&lt;br&gt;使用次数：本场1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="240" width="740" x="-400" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：缺月藏炉&lt;br&gt;&lt;br&gt;化法追加：降低法力上限后额外获得炁1层，并按新法力上限立即重算周天阈值；本次炁获取最多触发一次周天。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="360" width="290" x="1360" y="910" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：定息&lt;br&gt;卷章ID：ding_xi&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：让首次周天储成一次后续减费，支持队列里接续高法力技能&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：bao_yi&lt;br&gt;研读属性：灵慧≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1430" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：抱朴守缺&lt;br&gt;&lt;br&gt;抱朴守缺：&lt;br&gt;类型：心法&lt;br&gt;关键词：周天&lt;br&gt;效果：装配本经后，本场战斗的法力上限临时降低1点（最低为1）；在首回合法力补给前生效，战斗结束后恢复。周天阈值按降低后的法力上限计算。每回合首次由自身主动施展且实际支付至少1点法力的技能，在技能及其化法均结算完毕后，获得炁1。跳过、无合法目标或最终法力费用为0时不触发。每回合首次完成周天后，获得归元1层（上限1层）。每层归元分别用于一项后续技能：该技能可正常结算且基础法力费用大于0时，法力费用减1点（最低为0），并消耗1层归元。基础法力费用为0、被跳过或无合法目标的技能不消耗归元；归元在本回合行动队列结算完毕后清除。&lt;br&gt;主修额外效果：每回合法力补给完成后，获得炁1。" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="260" width="740" x="-400" y="1430" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：归炉照骨&lt;br&gt;&lt;br&gt;化法追加：若本招实际支付至少1点法力，且消耗1层归元，本次伤害结算后获得炁1层；每轮最多触发1次。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="290" x="1360" y="1430" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：还元&lt;br&gt;卷章ID：huan_yuan&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：把归炉照骨接入周天循环，并将溢炁即时折为下一轮术法&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：ding_xi&lt;br&gt;研读属性：灵慧≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +1&lt;br&gt;&lt;br&gt;习得：归炉照骨&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="1970" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：抱朴守缺&lt;br&gt;&lt;br&gt;抱朴守缺：&lt;br&gt;类型：心法&lt;br&gt;关键词：周天&lt;br&gt;效果：装配本经后，本场战斗的法力上限临时降低1点（最低为1）；在首回合法力补给前生效，战斗结束后恢复。周天阈值按降低后的法力上限计算。每回合首次由自身主动施展且实际支付至少1点法力的技能，在技能及其化法均结算完毕后，获得炁1。跳过、无合法目标或最终法力费用为0时不触发。每回合首次完成周天后，获得归元1层；若触发该周天的炁获得事件溢出至少1层炁，则改为获得归元2层（上限2层）。每层归元分别用于一项后续技能：该技能可正常结算且基础法力费用大于0时，法力费用减1点（最低为0），并消耗1层归元。基础法力费用为0、被跳过或无合法目标的技能不消耗归元；归元在本回合行动队列结算完毕后清除。不同归元层分别强化不同技能，不叠加到同一技能。溢炁不保留，也不会重复触发周天。&lt;br&gt;主修额外效果：每回合法力补给完成后，获得炁1。&lt;br&gt;&lt;br&gt;习得：归炉照骨&lt;br&gt;&lt;br&gt;归炉照骨：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：周天&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：物理伤害&lt;br&gt;效果：炉火外放凝成直击敌身的光束，造成A点物理伤害。若本次实际支付法力触发本经心法获得炁，且该次炁立即完成周天，则周天结算后对同一合法目标追加B点物理伤害；原目标不再合法时随机转火。追加物理伤害不再次触发技能、化法、产炁或周天效果。没有合法敌方时行动落空，不支付资源、不消耗次数&lt;br&gt;计算公式：A=round(8 + 灵慧×0.50 + 术法造诣×0.35)；B=round(A×0.50)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="550" width="740" x="-400" y="1970" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：归炉照骨&lt;br&gt;&lt;br&gt;化法追加：替代第三卷的炁量：若本招实际支付至少1点法力且消耗1层归元，本次伤害结算后获得炁2层，不与第三卷炁1叠加；每轮最多触发1次。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="290" x="1360" y="1970" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：以压低法力上限降低周天阈值，再用付法、回法和归元减费衔接三式专属招式。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;精准 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="910" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;原表值待映射：法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1430" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;原表值待映射：法术伤害 +7%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="1970" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;炁与周天&lt;/b&gt;&lt;br&gt;炁跨轮保留，达到当前法力上限两倍时立即清空全部炁、法力回满，再结算周天效果；超额炁不保留。单次炁获得事件最多触发一次周天，战斗结束清零。&lt;br&gt;&lt;b&gt;结算顺序&lt;/b&gt;&lt;br&gt;技能先支付最终费用，结算基础效果与本卷化法；随后结算本书的首次法力支付产炁。每次炁增加独立检查阈值；触发周天时先清炁、回满法力，再处理本书周天效果。法力费用因减费变为0时，不算实际支付法力。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅有抱朴守缺一个常驻被动；各卷规则追加到同一被动。主修额外效果只列在心法中。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;战斗循环示例&lt;/b&gt;&lt;br&gt;法力上限降至1时，周天阈值为2。主修每回合补给后先获炁1；随后归炉照骨实际支付法力并完成结算，首个付法事件再获炁1，触发周天。第三卷起，首次周天获得归元1层，供后续技能减费。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界与状态&lt;/b&gt;&lt;br&gt;炁不是法力，不能支付技能费用；周天只恢复至当前法力上限，不返还超额炁。归元为本经触发型状态：每层只减免一项后续法力技能1点法力，不能重复作用于同一技能；每轮首次周天最多发放1层基础归元，第四卷的溢炁追加最多1层。所有技能仍按队列自动结算；无手动目标、模式或战斗中选项。&lt;br&gt;&lt;b&gt;递归边界&lt;/b&gt;&lt;br&gt;周天附加效果再次产炁时，仍按当前阈值检查；达到阈值照常清空炁并回满法力，但不再触发新的周天附加效果。" vertex="1"><mxGeometry height="562" width="430" x="1660" y="820" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
