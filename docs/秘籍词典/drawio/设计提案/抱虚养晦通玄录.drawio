        <mxCell id="c3_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：虚室生白（沿用第一卷，无新增效果）&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="740" x="-400" y="1370" as="geometry" />
