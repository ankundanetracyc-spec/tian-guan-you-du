        <mxCell id="c2_right" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：守寂&lt;br&gt;&lt;br&gt;化法追加：支付费用后法力为0时，结算后额外获得炁1；每回合限一次。&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="440" x="1360" y="870" as="geometry" />
