        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;抱虚养晦通玄录&lt;/div&gt;" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
