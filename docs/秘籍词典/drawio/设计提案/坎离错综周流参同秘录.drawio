<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device">
  <diagram id="kanli-zhouliu-cantong" name="坎离错综周流参同秘录">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="坎离错综周流参同秘录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：以技能槽的奇偶而非行动队列位置编织纳炁节拍，交替施法既提高周天进度，也能在关键节点返还法力。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：偶位纳坎&lt;br&gt;卷章ID：ou_wei_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：让偶数号技能槽的实付法力化为炁&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：坎月凝锋&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：坎离错综&lt;br&gt;习得：坎月凝锋&lt;br&gt;&lt;br&gt;坎离错综：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：偶数号技能槽中的技能实际支付法力后，获得炁1。槽位奇偶按技能槽序号判定，不受行动槽序号影响。&lt;br&gt;主修额外效果：任意技能槽中的技能实际支付法力后，获得炁1；若其槽位奇偶与本回合上一项实际付法技能相反，再获得炁1。此效果替代偶数槽产炁，不重复触发。&lt;br&gt;&lt;br&gt;坎月凝锋：&lt;br&gt;类型：守御&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：自身&lt;br&gt;效果：获得A点护盾。若本招式位于偶数号技能槽，且本轮此前最近一次实际付法术法位于奇数号技能槽，则护盾改为A的1.50倍&lt;br&gt;计算公式：A=round(4 + 灵慧×0.25 + 神魂×0.20 + 术法造诣×0.20)；满足奇偶条件时A=round(A×1.50)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="390" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：坎月凝锋&lt;br&gt;类型：守御&lt;br&gt;关键词：法力、循环&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：自身&lt;br&gt;原技能效果：获得A点护盾。若本招式位于偶数号技能槽，且本轮此前最近一次实际付法术法位于奇数号技能槽，则护盾改为A的1.50倍。&lt;br&gt;化法追加：本招式位于偶数号技能槽，且本轮上一项实际付法术法位于奇数号技能槽时，护盾改为原值×1.50。&lt;br&gt;计算公式：A=round(4 + 灵慧×0.25 + 神魂×0.20 + 术法造诣×0.20)；满足奇偶条件时A=round(A×1.50)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="360" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：奇偶相济&lt;br&gt;卷章ID：qi_ou_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：扩展纳炁槽位，并奖励奇偶交替&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：ou_wei_1&lt;br&gt;研读属性：灵慧≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：坎离照影法&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="340" x="850" y="890" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：坎离错综&lt;br&gt;&lt;br&gt;坎离错综：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：偶数号技能槽中的技能实际支付法力后，获得炁1。槽位奇偶按技能槽序号判定，不受行动槽序号影响。每回合连续三项实际付法技能的技能槽奇偶依次交替时，第三项结算后回复法力1点，不超过上限。未付法行动不计入该序列，也不改变最近一次付法技能的槽位记录。&lt;br&gt;主修额外效果：任意技能槽中的技能实际支付法力后，获得炁1；若其槽位奇偶与本回合上一项实际付法技能相反，再获得炁1。此效果替代偶数槽产炁，不重复触发。&lt;br&gt;&lt;br&gt;习得：坎离照影法&lt;br&gt;&lt;br&gt;坎离照影法：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：指定1名敌方；满足奇偶条件时另随机 1 名不同敌方&lt;br&gt;伤害类型：法术&lt;br&gt;效果：伤害：A点。对指定目标造成A点伤害；若本招式所在技能槽与本轮此前最近一项实际支付法力的技能槽序号奇偶相反，再从其他合法敌方中随机选择 1 名，造成B点伤害。没有此前付法力技能或没有第二名合法敌方时，不追加伤害。完成奇偶判定后才记录本技能槽&lt;br&gt;计算公式：A=round(8 + 灵慧×0.60 + 术法造诣×0.35)；B=round(A×0.50)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="740" x="-400" y="890" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：坎离照影法&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 1、法力 1&lt;br&gt;目标：指定1名敌方；满足奇偶条件时另随机 1 名不同敌方&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：伤害：A点。对指定目标造成A点伤害；若本招式所在技能槽与本轮此前最近一项实际支付法力的技能槽序号奇偶相反，再从其他合法敌方中随机选择 1 名，造成B点伤害。没有此前付法力技能或没有第二名合法敌方时，不追加伤害。完成奇偶判定后才记录本技能槽。&lt;br&gt;化法追加：若两项技能槽序号奇偶相反，副目标伤害由主目标基础伤害的50%提高至75%。&lt;br&gt;计算公式：A=round(8 + 灵慧×0.60 + 术法造诣×0.35)；B=round(A×0.50)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="290" x="1360" y="890" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：三转成环&lt;br&gt;卷章ID：san_zhuan_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：让连续交替的三次施法回还一分法力&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：qi_ou_2&lt;br&gt;研读属性：灵慧≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1450" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法沿用上一卷。&lt;br&gt;习得：无新增战斗技能&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="120" width="740" x="-400" y="1450" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：离火错行&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：造成A点法术伤害。若包括本技能在内、本轮最近三项实际支付法力的技能槽序号奇偶依次交替（奇—偶—奇或偶—奇—偶），伤害改为B点。零法力或最终未支付法力的行动不计入这三项。&lt;br&gt;化法追加：本轮最近三项实际付法技能槽奇偶交替时，伤害乘数在基础值上再提高10%；每轮最多触发1次。&lt;br&gt;计算公式：A=round(9 + 灵慧×0.55 + 术法造诣×0.35)；B=round(A×1.35)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1450" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：周天复引&lt;br&gt;卷章ID：zhou_tian_fu_yin_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：借周天记录槽位阴阳，续接下一次纳炁&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：san_zhuan_3&lt;br&gt;研读属性：灵慧≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：术法造诣 +1&lt;br&gt;&lt;br&gt;习得：离火错行&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="450" width="340" x="850" y="1990" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：坎离错综&lt;br&gt;&lt;br&gt;坎离错综：&lt;br&gt;类型：心法&lt;br&gt;关键词：法力、循环&lt;br&gt;效果：偶数号技能槽中的技能实际支付法力后，获得炁1。槽位奇偶按技能槽序号判定，不受行动槽序号影响。每回合连续三项实际付法技能的技能槽奇偶依次交替时，第三项结算后回复法力1点，不超过上限。未付法行动不计入该序列，也不改变最近一次付法技能的槽位记录。若触发周天的炁可追溯至本角色的技能槽技能，记录其槽位奇偶；本回合后续首项实际支付法力且槽位奇偶相反的技能额外获得炁1，并清除记录。没有符合条件的技能时，记录保留至回合结束；若再次触发周天，则以新来源覆盖旧记录。&lt;br&gt;主修额外效果：任意技能槽中的技能实际支付法力后，获得炁1；若其槽位奇偶与本回合上一项实际付法技能相反，再获得炁1。此效果替代偶数槽产炁，不重复触发。&lt;br&gt;&lt;br&gt;习得：离火错行&lt;br&gt;&lt;br&gt;离火错行：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：法术&lt;br&gt;效果：造成A点法术伤害。若包括本技能在内、本轮最近三项实际支付法力的技能槽序号奇偶依次交替（奇—偶—奇或偶—奇—偶），伤害改为B点。零法力或最终未支付法力的行动不计入这三项。没有合法敌方时行动落空，不支付资源、不消耗次数&lt;br&gt;计算公式：A=round(9 + 灵慧×0.55 + 术法造诣×0.35)；B=round(A×1.35)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="510" width="740" x="-400" y="1990" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：离火错行&lt;br&gt;类型：攻伐&lt;br&gt;关键词：法力、循环、爆发&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：自动选择1名合法敌方；目标失效时按普通单体规则转火&lt;br&gt;伤害类型：法术&lt;br&gt;原技能效果：造成A点法术伤害。若包括本技能在内、本轮最近三项实际支付法力的技能槽序号奇偶依次交替（奇—偶—奇或偶—奇—偶），伤害改为B点。零法力或最终未支付法力的行动不计入这三项。&lt;br&gt;化法追加：若本轮最近三项实际付法技能槽奇偶交替，且本轮此前已由本经触发周天，本次伤害再乘1.15；每轮最多触发1次。&lt;br&gt;计算公式：A=round(9 + 灵慧×0.55 + 术法造诣×0.35)；B=round(A×1.35)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="290" x="1360" y="1990" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：坎月凝锋以偶数号技能槽纳炁；坎离照影法与离火错行利用付法技能槽的奇偶，衔接护盾、分击与爆发。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;护盾获得量 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="890" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;法术伤害 +5%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1450" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;法术伤害 +5%&lt;br&gt;护盾获得量 +7%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="150" width="270" x="370" y="1990" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;炁与周天&lt;/b&gt;&lt;br&gt;炁跨轮保留，战斗结束清零；达到当前法力上限两倍时立即清空全部炁、法力回满，再结算周天效果；超额炁不保留。单次炁获得事件最多触发一次周天。&lt;br&gt;&lt;b&gt;结算顺序&lt;/b&gt;&lt;br&gt;技能支付最终费用并结算基础效果与化法；再结算来源明确的炁获得。达到阈值时先清炁、回满法力，再结算周天心法。法力实际支付为0不算支付法力。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;实战循环示例&lt;/b&gt;&lt;br&gt;技能槽1装入坎离照影法、技能槽2装入坎月凝锋、技能槽3装入离火错行；行动槽1至3依次结算。三式均实际支付法力时，技能槽号呈奇—偶—奇，第三项结算后返法1点。&lt;br&gt;&lt;br&gt;&lt;b&gt;边界与触发顺序&lt;/b&gt;&lt;br&gt;奇偶只读取1至10号技能槽，不读取行动槽序号。法力实际支付为0的行动不算入交替序列。第二卷返还法力在技能效果与其炁触发结算后处理，受当前法力上限限制；不会额外生成行动。每次炁获得事件仍最多触发一次周天。&lt;br&gt;&lt;br&gt;&lt;b&gt;构筑代价与限制&lt;/b&gt;&lt;br&gt;构筑必须把会实际支付法力的技能按奇偶排入技能槽；零法力技能不能推进交替。若技能都集中在同一奇偶侧或法力不足以施展，周天与返法收益都会下降。" vertex="1"><mxGeometry height="601" width="430" x="1660" y="864.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
