<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device" modified="2026-10-11T12:00:00.000Z">
  <diagram id="shenshi-yizhi-milu" name="神室易质秘录">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" value="" />
        <mxCell id="1" parent="0" value="" />
        <mxCell id="title" value="神室易质秘录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" vertex="1" parent="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" /></mxCell>
        <mxCell id="overview" value="云息秘籍 / 可主修、可辅修&lt;br&gt;灵根：任意；主修可修至：云息十层&lt;br&gt;核心：神意分潮会随自身念层改变打击范围；念越多，不再只是单体伤害越高，而是从点杀逐渐转成群攻。&lt;br&gt;心法随主修或辅修自动生效；修持随已学卷章逐卷累积。&lt;br&gt;设计审阅稿，尚未接入运行时。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：初照神室&lt;br&gt;卷章ID：chu_zhao_shen_shi_1&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：为神意分潮点亮初念，开始一招多形的变化&lt;br&gt;研读值（累计）：24&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境及以上&lt;br&gt;前置：无&lt;br&gt;研读属性：灵慧≥5；神魂≥5&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：灵台照万象&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：神室易质&lt;br&gt;习得：灵台照万象&lt;br&gt;&lt;br&gt;神室易质：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、护盾&lt;br&gt;效果：每回合开始时，给已装配的灵台照万象赋念1层；该技能多次编入行动队列时共用同一念层数。未装配该技能时，本心法不赋念。灵台照万象按自身念层数改变护盾目标分配，具体规则见技能条目。&lt;br&gt;主修额外效果：灵台照万象的念首次达到3层、6层时，各触发一次：回复体力1点，并立即给当前生命比例最低的己方施加该技能基础护盾量的一半；并列时随机选择。此效果不施展技能，也不触发赋念。&lt;br&gt;&lt;br&gt;灵台照万象：&lt;br&gt;类型：守御&lt;br&gt;关键词：念、护盾&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：随本招式念层自动变化；0—2 念为自身，3—5 念为随机 2 名不同己方，6 念及以上为全体己方&lt;br&gt;效果：0—2 念时自身获得A点护盾；3—5 念时两名随机己方各获得B点护盾；6 念及以上时全体己方各获得C点护盾。目标形态在结算时按当前念层确定；未达到目标人数时对现有合法目标结算&lt;br&gt;计算公式：A=round(7 + 神魂×0.45 + 灵慧×0.25 + 术法造诣×0.15)；B=round(A×0.65)；C=round(A×0.40)。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="430" width="740" x="-400" y="370" as="geometry" /></mxCell>
        <mxCell id="c1_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：灵台照万象&lt;br&gt;&lt;br&gt;化法追加：本招式念不少于3层时，所有目标各获得的护盾量再提高10%。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="410" width="280" x="1360" y="370" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：识潮自生&lt;br&gt;卷章ID：shi_chao_zi_sheng_2&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：以神意分潮的实际命中持续养念，设定本经赋念上限&lt;br&gt;研读值（累计）：48&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：chu_zhao_shen_shi_1&lt;br&gt;研读属性：灵慧≥6；神魂≥6；术法造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +0.5&lt;br&gt;&lt;br&gt;习得：神意分潮&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="340" x="850" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：神室易质&lt;br&gt;&lt;br&gt;神室易质：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、护盾&lt;br&gt;效果：每回合开始时，给已装配的灵台照万象赋念1层；该技能多次编入行动队列时共用同一念层数。未装配该技能时，本心法不赋念。灵台照万象按自身念层数改变护盾目标分配，具体规则见技能条目。每回合首次成功施展灵台照万象后，再赋念1层；每回合至多1层，念达到6层后停止赋念。&lt;br&gt;主修额外效果：灵台照万象的念首次达到3层、6层时，各触发一次：回复体力1点，并立即给当前生命比例最低的己方施加该技能基础护盾量的一半；并列时随机选择。此效果不施展技能，也不触发赋念。&lt;br&gt;&lt;br&gt;习得：神意分潮&lt;br&gt;&lt;br&gt;神意分潮：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：念&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：自动选择1名合法敌方；并给本招式及本招式所在行动槽后方最近的其他主动术法赋念&lt;br&gt;伤害类型：神魂伤害&lt;br&gt;效果：神念化潮直击敌方识海。有合法敌方时，先给本招式技能实例赋念 1，再按赋念后的念层确定形态：0—2 念对 1 名敌方造成A点神魂伤害；3—5 念对主目标造成A点神魂伤害、另一名不同敌方造成B点神魂伤害；6 念及以上对全体敌方各造成C点神魂伤害。伤害结算后，给本招式所在行动槽后方第一个来自其他技能槽的主动技能赋念 1；没有后续技能时略过。没有合法敌方时行动落空，不支付资源、不消耗次数或赋念。赋念不消耗念、不施展目标技能，也不触发其他赋念效果&lt;br&gt;计算公式：Q(T)=clamp(1 + (施术者神魂−T有效神魂)/max(施术者神魂+T有效神魂+20,0.001)×1.0, 0.5, 1.5)；T有效神魂=max(0,目标神魂−H)，H=目标心隙层数；A=round((9 + 灵慧×0.55 + 神魂×0.25 + 术法造诣×0.25)×Q(主目标))；B=round((9 + 灵慧×0.55 + 神魂×0.25 + 术法造诣×0.25)×0.75×Q(副目标))；C=round((9 + 灵慧×0.55 + 神魂×0.25 + 术法造诣×0.25)×0.45×Q(各目标))。&lt;br&gt;使用次数：每轮1次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="530" width="740" x="-400" y="910" as="geometry" /></mxCell>
        <mxCell id="c2_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：神意分潮&lt;br&gt;&lt;br&gt;化法追加：本招式念不少于3层时，本招式自身结算后，给本招式所在行动槽后方首个其他主动术法额外赋念1层。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="530" width="290" x="1360" y="910" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：一念分形&lt;br&gt;卷章ID：yi_nian_fen_xing_3&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：念达三层后，由单体转为主次兼击&lt;br&gt;研读值（累计）：84&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：shi_chao_zi_sheng_2&lt;br&gt;研读属性：灵慧≥8；神魂≥8；术法造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：神魂 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="340" x="850" y="1510" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法沿用上一卷。&lt;br&gt;习得：无新增战斗技能&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="120" width="740" x="-400" y="1510" as="geometry" /></mxCell>
        <mxCell id="c3_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：神意分潮&lt;br&gt;&lt;br&gt;化法追加：本招式处于3—5念形态时，副目标神魂伤害由基础伤害的75%提高至90%，并按副目标Q值结算；每轮最多触发1次。&lt;br&gt;计算公式：D=round((9 + 灵慧×0.55 + 神魂×0.25 + 术法造诣×0.25)×0.90×Q(副目标))&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="560" width="290" x="1360" y="1510" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：众象归一&lt;br&gt;卷章ID：zhong_xiang_gui_yi_4&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：念达六层后，改以低幅度覆盖所有敌方&lt;br&gt;研读值（累计）：128&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：yi_nian_fen_xing_3&lt;br&gt;研读属性：灵慧≥10；神魂≥10；术法造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：灵慧 +0.5；术法造诣 +1&lt;br&gt;&lt;br&gt;习得：照魄销尘&lt;/div&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="490" width="340" x="850" y="2090" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：神室易质&lt;br&gt;&lt;br&gt;神室易质：&lt;br&gt;类型：心法&lt;br&gt;关键词：念、护盾&lt;br&gt;效果：每回合开始时，给已装配的灵台照万象赋念1层；该技能多次编入行动队列时共用同一念层数。未装配该技能时，本心法不赋念。灵台照万象按自身念层数改变护盾目标分配，具体规则见技能条目。每回合首次成功施展灵台照万象后，再赋念1层；每回合至多1层，念达到6层后停止赋念。灵台照万象各念形态的基础护盾倍率提高10%；目标形态、目标数量和念层门槛按技能条目执行。&lt;br&gt;主修额外效果：灵台照万象的念首次达到3层、6层时，各触发一次：回复体力1点，并立即给当前生命比例最低的己方施加该技能基础护盾量的一半；并列时随机选择。此效果不施展技能，也不触发赋念。&lt;br&gt;&lt;br&gt;习得：照魄销尘&lt;br&gt;&lt;br&gt;照魄销尘：&lt;br&gt;类型：术诀&lt;br&gt;关键词：心隙、念&lt;br&gt;耗费：体力 2、法力 1&lt;br&gt;目标：0—2 念：自动选择1名敌方；3—5 念：随机选择2名不同敌方；6 念及以上：全体敌方&lt;br&gt;效果：按结算时自身念层数确定目标形态，对每名合法目标施加心隙 1 层。心隙按施术者来源独立累计，不设额外层数上限或自动衰减，持续至战斗结束；战斗结束时清除。没有合法敌方时行动落空，不支付资源、不消耗次数&lt;br&gt;使用次数：本场3次&lt;/div&gt;" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="470" width="740" x="-400" y="2090" as="geometry" /></mxCell>
        <mxCell id="c4_right" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;适用范围：照魄销尘&lt;br&gt;&lt;br&gt;化法追加：本招式念不少于6层时，每名目标额外施加心隙1层。&lt;/div&gt;" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry height="360" width="290" x="1360" y="2090" as="geometry" /></mxCell>
        <mxCell id="summary" value="构筑要点：让神意分潮随念累积改变目标形态，从单体逐步转为多目标攻击。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" /></mxCell>
        <mxCell id="c1_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="260" x="360" y="370" as="geometry" /></mxCell><mxCell id="c2_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;护盾获得量 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="390" y="910" as="geometry" /></mxCell><mxCell id="c3_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;原表值待映射：法术伤害 +8%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="120" width="270" x="400" y="1510" as="geometry" /></mxCell><mxCell id="c4_left" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;护盾获得量 +12%&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry height="130" width="270" x="370" y="2090" as="geometry" /></mxCell><mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;b&gt;念规则&lt;/b&gt;&lt;br&gt;念附着于技能实例，不因施展消耗；重复排入队列时共用该槽位念值，战斗结束清零。所有模式在技能正常结算时读取。&lt;br&gt;&lt;b&gt;心法与修持&lt;/b&gt;&lt;br&gt;全书仅设一个常驻心法Buff，卷章追加沿用该Buff；主修或辅修均自动生效。&lt;br&gt;修持属性随已学卷章逐卷累积，并列入该Buff信息；习得招式进入可装配技能池，不自动装配。&lt;br&gt;&lt;br&gt;&lt;b&gt;实战形态&lt;/b&gt;&lt;br&gt;每回合开始时，心法给已装配的灵台照万象赋念1；第二卷起，该技能每回合首次成功施展后再获念1（达到6念后停发此项）。护盾分配随念层改变；主修首次跨入3念、6念时触发额外护盾与体力回复。&lt;br&gt;&lt;br&gt;&lt;b&gt;限制与构筑&lt;/b&gt;&lt;br&gt;群攻阶段降低每个目标伤害，单体残敌时反而不如初始形态。需要把选定神意分潮稳定排入队列并成功命中；无合法敌方或未命中不会成长。模式切换不复制行动，额外目标不重复扣费、次数或触发赋念。&lt;br&gt;&lt;b&gt;递归边界&lt;/b&gt;&lt;br&gt;周天附加效果再次产炁时，仍按当前阈值检查；达到阈值照常清空炁并回满法力，但不再触发新的周天附加效果。" vertex="1"><mxGeometry height="470" width="430" x="1660" y="918.0" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_b" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_c" edge="1" parent="1" source="c1" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c1_cards" value="本卷心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_a" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_b" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c2_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_c" edge="1" parent="1" source="c2" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c2_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_a" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_b" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c3_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3_c" edge="1" parent="1" source="c3" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c3_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_a" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_left" value="修持" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_b" edge="1" parent="1" source="c4" style="endArrow=block;html=1;" target="c4_right" value="化法" ><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4_c" edge="1" parent="1" source="c4" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" target="c4_cards" value="心法与习得" ><mxGeometry relative="1" as="geometry" /></mxCell></root>
