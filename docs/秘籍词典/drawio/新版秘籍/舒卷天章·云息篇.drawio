        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;舒卷天章·云息篇&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#203A21;fillColor=#E3F0DF;strokeColor=#82A972;strokeWidth=1.2;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=16;spacingBottom=16;" vertex="1" parent="1">
