        <mxCell id="overview" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;云息篇 · 四卷&lt;/b&gt;&lt;br&gt;可主修、可辅修&lt;br&gt;剑式每段命中积1层剑意，上限10层。&lt;br&gt;4秒未再积累，开始每秒失去1层。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#203A21;fillColor=#E3F0DF;strokeColor=#82A972;strokeWidth=1.2;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=16;spacingBottom=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="670" y="120" width="600" height="150" />
        </mxCell>
        <mxCell id="volume_1" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;第一卷 · 云舒&lt;/b&gt;&lt;br&gt;前置：无&lt;br&gt;新招式：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#203A21;fillColor=#E3F0DF;strokeColor=#82A972;strokeWidth=1.2;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=16;spacingBottom=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="357" width="260" height="126" />
        </mxCell>
        <mxCell id="heart_1" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;心法：流云剑势&lt;/b&gt;&lt;br&gt;关键词：剑、剑意&lt;br&gt;起手剑意达到9层时，同一次连招中&lt;br&gt;连续命中同一敌人，后续每击增伤10%，最多50%。&lt;br&gt;未命中或连招结束，增伤重新累计。&lt;br&gt;主修额外效果：所需剑意降至8层。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF3FF;strokeColor=#6B91C5;strokeWidth=1.2;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=16;spacingBottom=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="320" width="680" height="200" />
        </mxCell>
        <mxCell id="rewrite_1" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;化法&lt;/b&gt;&lt;br&gt;适用范围：架招&lt;br&gt;化法追加：&lt;br&gt;持剑时，本次架招首次实际化解伤害，&lt;br&gt;获得2层剑意。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#172D49;fillColor=#EAF3FF;strokeColor=#6B91C5;strokeWidth=1.2;spacing=0;spacingLeft=18;spacingRight=18;spacingTop=16;spacingBottom=16;" vertex="1" parent="1">
