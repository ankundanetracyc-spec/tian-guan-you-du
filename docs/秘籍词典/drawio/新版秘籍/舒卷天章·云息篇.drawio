        <mxCell id="learn_yun_lan" value="习得" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7B8796;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#263546;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="volume_3" target="yun_lan_san_die">
