        <mxCell id="rewrite_link_4" value="化法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7B8796;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#263546;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="volume_4" target="rewrite_4">
