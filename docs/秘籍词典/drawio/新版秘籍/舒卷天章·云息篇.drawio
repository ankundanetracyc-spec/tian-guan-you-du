  <diagram id="shu_juan_yun_xi_player" name="01 主图（游戏内文案）">
    <mxGraphModel dx="1840" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1650" math="0" shadow="0" background="#FFFFFF">
      <root>
