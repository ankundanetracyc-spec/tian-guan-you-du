        <mxCell id="c4" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;第四卷 · 归养&lt;/b&gt;&lt;br&gt;卷章ID：yunxi_gui_yang&lt;br&gt;顺序：4&lt;br&gt;定位：外放增威&lt;br&gt;前置：贯劲&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
