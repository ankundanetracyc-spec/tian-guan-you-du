  <diagram id="bai_hai_yun_xi" name="02 策划说明（内部）">
    <mxGraphModel dx="1740" dy="2189" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="2189" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;百骸衍枝化生宝册·云息篇&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="660" y="25" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="overview" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;02｜策划说明 · 即时对练版 v0.9&lt;/b&gt;&lt;br&gt;可主修、可辅修；本页不进入游戏正文。&lt;br&gt;持血拉距，近身双判，末段涌潮。&lt;br&gt;同部功法：云息外放，玄基显臂。&lt;br&gt;当前已接即时自选对练，与玩家文案共用数值。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="560" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;待定与接入边界&lt;/b&gt;&lt;br&gt;五行、灵根、修炼跨度及各卷修持仍待定。&lt;br&gt;当前普攻通过连段与末段元数据接入。&lt;br&gt;新伤害与化法已在即时自选对练生效。&lt;br&gt;正式养成获取与其他秘籍继续单独迁移。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1300" y="120" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;心法被动：百骸化生&lt;/b&gt;&lt;br&gt;关键词：气血&lt;br&gt;气血＞0时，普攻每段外放血气；近处可与本体同时命中，远处仅血气。&lt;br&gt;血气造成该段防御前本体基础值50%的物理伤害。&lt;br&gt;额外前向距离R（R=40＋10×H；H为该段出手时实际气血）。&lt;br&gt;横宽沿原段；外放不扣气血；动作、位移和冷却沿当前普攻。&lt;br&gt;血气增伤统一加算，血浪共享，本体伤害不受其影响。&lt;br&gt;主修额外效果：血气额外前向距离提高15%。&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="620" height="202" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;第一卷 · 养络&lt;/b&gt;&lt;br&gt;卷章ID：yunxi_yang_luo&lt;br&gt;顺序：1&lt;br&gt;定位：持血外放&lt;br&gt;前置：无&lt;br&gt;习得：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacingTop=14;spacingBottom=14;fillColor=#f3f4f6;strokeColor=#8993a0;fontColor=#374151;dashed=1;dashPattern=6 4;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
