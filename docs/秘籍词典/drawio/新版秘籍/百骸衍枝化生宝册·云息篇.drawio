        <mxCell id="p_e1_rewrite" source="p_c1" target="p_c1_right" value="化法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7b8794;fontFamily=Microsoft YaHei;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_c2_cards" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;心法：百骸化生&lt;/b&gt;&lt;br&gt;关键词：气血&lt;br&gt;有气血时，普攻每段外放血气，可与本体同时命中。&lt;br&gt;血气造成该段50%的物理伤害，向前额外延伸R单位（R=40＋10×气血）。&lt;br&gt;外放不消耗气血，血气增伤同样作用于血浪。&lt;br&gt;本体命中时，同次血气对该敌人伤害＋25%。&lt;br&gt;主修：血气额外距离提高15%。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eaf3ff;strokeColor=#6b91c5;fontColor=#172d49;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="504" width="620" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p_c2" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;第二卷 · 行血&lt;/b&gt;&lt;br&gt;前置：养络&lt;br&gt;新招式：赤潮奔涌&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=15;fillColor=#e3f0df;strokeColor=#82a972;fontColor=#203a21;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="800" y="504" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p_c2_right" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;化法：架招&lt;/b&gt;&lt;br&gt;气血≥4层时发动，本次基础化解量＋20%。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eaf3ff;strokeColor=#6b91c5;fontColor=#172d49;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1220" y="504" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p_chichao" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;招式：赤潮奔涌&lt;/b&gt;&lt;br&gt;关键词：气血、击退&lt;br&gt;耗费：体力1、法力0&lt;br&gt;目标：自身；需气血≥2层。&lt;br&gt;连段外发动，降低气血2层。&lt;br&gt;6秒内，每套普攻末段出手时追加一道血浪。&lt;br&gt;造成A点物理伤害（A=末段基础伤害×（50%＋气血×10%））。&lt;br&gt;范围：前方120°扇面、最远440单位，0.78秒扩散，贯穿敌人。&lt;br&gt;血浪命中时有几率小幅击退敌人。&lt;br&gt;冷却：24秒，自强化结束后计算。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eaf3ff;strokeColor=#6b91c5;fontColor=#172d49;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="709" width="620" height="248" as="geometry" />
        </mxCell>
        <mxCell id="p_e_chichao" source="p_c2" target="p_chichao" value="习得" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7b8794;fontFamily=Microsoft YaHei;fontSize=12;exitX=0;exitY=0.85;entryX=1;entryY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_e2_heart" source="p_c2" target="p_c2_cards" value="心法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7b8794;fontFamily=Microsoft YaHei;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p_e2_rewrite" source="p_c2" target="p_c2_right" value="化法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7b8794;fontFamily=Microsoft YaHei;fontSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1">
