        <mxCell id="e3_rewrite" source="c3" target="c3_right" value="化法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1">
