  <diagram id="bai_hai_yun_xi_player" name="01 主图（游戏内文案）">
    <mxGraphModel dx="1740" dy="1524" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1524" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="player_title" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;百骸衍枝化生宝册·云息篇&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e3f0df;strokeColor=#82a972;fontColor=#203a21;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="660" y="25" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="player_overview" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;云息篇 · 四卷&lt;/b&gt;&lt;br&gt;可主修、可辅修&lt;br&gt;持血外放，近身双判，末段涌潮。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=15;fillColor=#e3f0df;strokeColor=#82a972;fontColor=#203a21;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p_c1_cards" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;心法：百骸化生&lt;/b&gt;&lt;br&gt;关键词：气血&lt;br&gt;有气血时，普攻每段外放血气，可与本体同时命中。&lt;br&gt;血气造成该段50%的物理伤害，向前额外延伸R单位（R=40＋10×气血）。&lt;br&gt;外放不消耗气血，血气增伤同样作用于血浪。&lt;br&gt;主修：血气额外距离提高15%。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eaf3ff;strokeColor=#6b91c5;fontColor=#172d49;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="620" height="164" as="geometry" />
        </mxCell>
        <mxCell id="p_c1" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;第一卷 · 养络&lt;/b&gt;&lt;br&gt;前置：无&lt;br&gt;新招式：无&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=15;fillColor=#e3f0df;strokeColor=#82a972;fontColor=#203a21;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="800" y="285" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p_c1_right" value="&lt;div style=&quot;line-height:1.5;text-align:left;&quot;&gt;&lt;b&gt;化法：催血&lt;/b&gt;&lt;br&gt;气血≤2层时发动，完成后额外获得气血1层。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingBottom=16;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#eaf3ff;strokeColor=#6b91c5;fontColor=#172d49;dashed=0;spacing=0;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1220" y="285" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p_e1_heart" source="p_c1" target="p_c1_cards" value="心法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7b8794;fontFamily=Microsoft YaHei;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1">
