<mxfile host="Electron" agent="Codex">
  <diagram id="huangting-yangxing" name="黄庭养形篇">
    <mxGraphModel dx="3455" dy="512" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="黄庭养形篇" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="锻躯秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主气血回环；以主动气血回落触发身法与精力，再次催血续接循环&lt;br&gt;化法均保留基础技能原效果后追加本经效果&lt;br&gt;即时战斗适配：60 FPS队列；心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；气血无自动回落，身法、伤势与整场限次按公共规则。&lt;br&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。" vertex="1">
          <mxGeometry height="185" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：守中&#xA;卷章ID：shou_zhong&#xA;顺序：1&#xA;定位：立黄庭之基，建立主动回落的身法连段&#xA;学成可修至：云息三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：未确定或锻躯&#xA;境界：凡人境界及以上&#xA;研读属性：体魄≥5；体道造诣≥5&#xA;学会永久属性：体魄 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +30" vertex="1">
          <mxGeometry height="92" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：黄庭养形&lt;br&gt;习得：返照&lt;br&gt;&lt;br&gt;黄庭养形：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、闪避、精力&lt;br&gt;效果：获得同名唯一Buff，持续至本场战斗结束；本场首次主动使气血下降后获得身法1层。&lt;br&gt;主修额外追加：本场第二次主动使气血下降后，获得精力1点。&lt;br&gt;&lt;br&gt;返照：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避、回复&lt;br&gt;耗费：精力 1；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：气血-1；触发公共气血回落；获得身法2层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：抱一&#xA;卷章ID：bao_yi&#xA;顺序：2&#xA;定位：回落后抱元复起，使循环不断&#xA;学成可修至：云息六层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息三层及以上&#xA;前置：已学守中&#xA;研读属性：体魄≥6；体道造诣≥6&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：气血上限 +1" vertex="1">
          <mxGeometry height="92" width="270" x="390" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：抱一&lt;br&gt;&lt;br&gt;抱一：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命&lt;br&gt;耗费：精力 0；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：本场限用一次；仅当本场已主动使气血下降时可用；获得气血1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：周行&#xA;卷章ID：zhou_xing&#xA;顺序：3&#xA;定位：让回落与再催血形成更高密度的周身循环&#xA;学成可修至：云息九层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息六层及以上&#xA;前置：已学抱一&#xA;研读属性：体魄≥8；体道造诣≥8&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：气血回落回复率 +1 个百分点&lt;br&gt;物理伤害 +3%" vertex="1">
          <mxGeometry height="92" width="270" x="400" y="995" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：周行&lt;br&gt;&lt;br&gt;周行：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避&lt;br&gt;耗费：精力 2；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：获得气血1层；若本场曾由自身主动使气血下降，获得身法1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：归藏&#xA;卷章ID：gui_cang&#xA;顺序：4&#xA;定位：将基础催血纳入黄庭循环，收束云息期的气血构筑&#xA;学成可修至：云息十三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息九层及以上&#xA;前置：已学周行&#xA;研读属性：体魄≥10；体道造诣≥10&#xA;学会永久属性：体魄 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：物理伤害 +5%&lt;br&gt;最大生命 +20" vertex="1">
          <mxGeometry height="92" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;催血（体修基础技能追加效果，保留原效果）&lt;br&gt;关键词：生命、闪避&lt;br&gt;原效果：获得气血1层。&lt;br&gt;追加：本技能结算时，若本场曾由自身主动使气血下降，获得身法1层。&lt;br&gt;耗费与目标沿用催血：精力 1；自身。&lt;br&gt;本卷化法只追加效果，不计入习得。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：归藏&lt;br&gt;&lt;br&gt;归藏：&lt;br&gt;类型：术诀&lt;br&gt;关键词：闪避、精力&lt;br&gt;耗费：精力 3；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：本场限用一次；仅当本场已主动使气血下降至少2次时可用；获得身法3层；接下来两次主动施放的锻躯技能各少消耗1点精力，最低为0。&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;战斗主链：催血入势 → 返照回落添身法 → 抱一或周行再催血 → 第二次回落返精力 → 归藏减费连段。&lt;br&gt;本经不以气血满层为前提，核心读取主动回落这一可验证事件。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;术语与状态详解&lt;br&gt;&lt;br&gt;气血&lt;br&gt;锻躯公共战斗状态，基础上限3层；每次下降1层回复最大生命×3%；即时战斗无自动回落；仅由明确技能或状态效果触发气血下降；战斗结束重置。&lt;br&gt;&lt;br&gt;黄庭养形&lt;br&gt;本经同名唯一心法Buff，持续至本场战斗结束；本场首次由自身主动施放的技能使气血下降后获得身法1层。主修时，本场第二次主动使气血下降后获得精力1点。&lt;br&gt;&lt;br&gt;判定边界&lt;br&gt;只读取由自身主动施放的技能造成的气血下降；即时战斗没有回合结束自动回落。&lt;/div&gt;&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续增益状态，最多20层，持续1回合；每层使自身基础身法（dodge）提高1%；获得新层时刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减，受击不消耗；1回合时长归零或战斗结束时移除。&lt;br&gt;&lt;br&gt;淬炼&lt;br&gt;仅本场战斗生效，随本经心法Buff显示于图标信息栏；不进入角色永久属性。&lt;br&gt;&lt;br&gt;跨经联动&lt;br&gt;赤阳心法生效时，自身主动气血下降按赤阳公共规则转为血炉；黄庭心法仍按实际主动气血下降事件计次。" vertex="1">
          <mxGeometry height="430" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
