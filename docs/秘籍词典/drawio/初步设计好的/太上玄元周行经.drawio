<mxfile host="Electron" agent="Codex" version="24.7.17">
  <diagram id="taishang-xuanyuan-zhouxing" name="太上玄元周行经">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="太上玄元周行经&#xa;行炁 / 可主修、可辅修 / 云息十三层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="30" width="700" height="106" as="geometry" /></mxCell>
        <mxCell id="overview" value="核心定位&#xa;以炁推进周天；完成周天后法力回满。&#xa;本经不以单次多周天为目标，而是持续完成周天，逐步积累全场物理伤害，并以一张大术结算本场周天总次数。&#xa;&#xa;公共规则&#xa;炁达到当前法力上限×2：完成一次周天，移除全部炁，当前法力回满。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="670" y="150" width="1060" height="175" as="geometry" /></mxCell>
        <mxCell id="c1" value="第一篇·抱一&#xa;chapter_id：bao_yi&#xa;云息一至三层&#xa;定位：安立心法，令法尽之后仍可续炁闭环。&#xa;学习条件：&#xa;灵根：任意&#xa;路径：未确定或行炁&#xa;境界：凡人境界及以上&#xa;研读属性：灵慧≥5；神魂≥5；术法造诣≥4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="950" y="430" width="460" height="240" as="geometry" /></mxCell>
        <mxCell id="c2" value="第二篇·玄关&#xa;chapter_id：xuan_guan&#xa;云息四至六层&#xa;定位：让积炁与攻伐同步，周天回满后立刻有高质量施术。&#xa;学习条件：&#xa;灵根：任意&#xa;路径：行炁&#xa;境界：云息三层及以上&#xa;前置：已学抱一&#xa;研读属性：灵慧≥6；神魂≥6；术法造诣≥5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="950" y="925" width="460" height="240" as="geometry" /></mxCell>
        <mxCell id="c3" value="第三篇·六虚&#xa;chapter_id：liu_xu&#xa;云息七至九层&#xa;定位：以纯精力术诀稳定推进炁，只读取当前法力状态。&#xa;学习条件：&#xa;灵根：任意&#xa;路径：行炁&#xa;境界：云息六层及以上&#xa;前置：已学玄关&#xa;研读属性：灵慧≥8；神魂≥8；术法造诣≥7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="950" y="1435" width="460" height="240" as="geometry" /></mxCell>
        <mxCell id="c4" value="第四篇·朝元&#xa;chapter_id：chao_yuan&#xa;云息十至十三层&#xa;定位：将本场已完成周天次数炼为唯一的终局攻伐。&#xa;学习条件：&#xa;灵根：任意&#xa;路径：行炁&#xa;境界：云息九层及以上&#xa;前置：已学六虚&#xa;研读属性：灵慧≥10；神魂≥10；术法造诣≥9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="950" y="1945" width="460" height="240" as="geometry" /></mxCell>
        <mxCell id="c1_cards" value="习得：太上玄元周行经×1；守一存真×1&#xa;&#xa;太上玄元周行经&#xa;类型：心法牌&#xa;关键词：固有&#xa;耗费：精力 1、法力 0；灵识占用：0&#xa;目标与射程：自身；0格&#xa;效果：施加同名唯一 Buff。每完成一次周天，记录本场已完成周天次数+1；自身主动打出的术诀牌造成的物理伤害提高4%，最多32%。记录次数不受32%上限影响。&#xa;主修额外追加：每当自身主动打出一张实际耗费至少1点法力的术诀牌时，该牌结算完毕后获得1层炁；每张牌至多触发一次。&#xa;&#xa;守一存真&#xa;类型：术诀牌&#xa;关键词：无&#xa;耗费：精力 1、法力 0；灵识占用：0&#xa;目标与射程：自身；0格&#xa;效果：获得2层炁；若当前法力为0，改为获得3层炁。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="720" height="510" as="geometry" /></mxCell>
        <mxCell id="c1_huafa" value="化法·聚息×1&#xa;保留原效果：获得1点当回合法力。&#xa;追加效果：若打出本牌前当前法力为0，获得1层炁。&#xa;&#xa;定位：法尽时既补法力，也重新推动周天。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1570" y="405" width="550" height="160" as="geometry" /></mxCell>
        <mxCell id="c2_cards" value="习得：一阳初动×1；玄关返照×1&#xa;&#xa;一阳初动&#xa;类型：攻伐牌&#xa;关键词：无&#xa;耗费：精力 1、法力 1；灵识占用：0&#xa;目标与射程：指定敌方单体；由战斗系统目标规则决定&#xa;伤害类型：物理&#xa;伤害公式：4 + 术法造诣×0.7&#xa;效果：结算后获得1层炁；若本牌结算后完成周天，额外造成2 + 术法造诣×0.3点物理伤害。&#xa;&#xa;玄关返照&#xa;类型：攻伐牌&#xa;关键词：无&#xa;耗费：精力 1、法力 2；灵识占用：0&#xa;目标与射程：指定敌方单体；由战斗系统目标规则决定&#xa;伤害类型：物理&#xa;伤害公式：7 + 术法造诣×1.0&#xa;效果：若打出本牌时当前法力等于当前法力上限，额外造成3 + 术法造诣×0.3点物理伤害；结算后获得1层炁。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="885" width="720" height="540" as="geometry" /></mxCell>
        <mxCell id="c2_huafa" value="化法·灵击×1&#xa;保留原效果：对指定敌方单体造成原有物理伤害。&#xa;追加效果：本牌结算完毕后，获得1层炁。&#xa;&#xa;定位：将基础攻伐牌接入本经的日常积炁链。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1570" y="920" width="550" height="160" as="geometry" /></mxCell>
        <mxCell id="c3_cards" value="习得：黄庭内景×1；六虚周行×1&#xa;&#xa;黄庭内景&#xa;类型：术诀牌&#xa;关键词：无&#xa;耗费：精力 1、法力 0；灵识占用：0&#xa;目标与射程：自身；0格&#xa;效果：获得1层炁。直至自身下一次行动结束前，首次自身主动打出的、实际耗费至少1点法力的术诀牌结算完毕后，额外获得1层炁。&#xa;&#xa;六虚周行&#xa;类型：术诀牌&#xa;关键词：无&#xa;耗费：精力 1、法力 0；灵识占用：0&#xa;目标与射程：自身；0格&#xa;效果：获得1层炁；若当前法力等于当前法力上限，额外获得1层炁。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="1410" width="720" height="440" as="geometry" /></mxCell>
        <mxCell id="c3_huafa" value="化法·凝元×1&#xa;保留原效果：仅当当前法力为0时可打出；获得1点当回合法力。&#xa;追加效果：获得1层炁。&#xa;&#xa;定位：把法力见底转为下一次周天的起点。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1570" y="1430" width="550" height="160" as="geometry" /></mxCell>
        <mxCell id="c4_cards" value="习得：泥丸开阖×1&#xa;&#xa;泥丸开阖&#xa;类型：攻伐牌&#xa;关键词：消耗&#xa;耗费：精力 2、法力 3；灵识占用：0&#xa;目标与射程：指定敌方单体；由战斗系统目标规则决定&#xa;伤害类型：物理&#xa;伤害公式：10 + 术法造诣×1.3&#xa;效果：本场每完成一次周天，额外造成2 + 术法造诣×0.2点物理伤害；此额外伤害不设次数上限。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="1910" width="720" height="300" as="geometry" /></mxCell>
        <mxCell id="c4_note" value="朝元收束&#xa;本经仅泥丸开阖读取本场累计周天次数。&#xa;心法的32%伤害提高在8次周天后封顶；泥丸开阖继续读取其后的每一次周天，因此长战仍有上限。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1570" y="1945" width="550" height="140" as="geometry" /></mxCell>
        <mxCell id="rules" value="术语与边界&#xa;① 炁达到当前法力上限×2时，完成周天：移除全部炁，当前法力回满。&#xa;② 心法主修发动机只读取术诀牌；攻伐牌不会触发它。&#xa;③ 直接造成任何伤害的牌一律为攻伐牌；术诀牌只处理资源、状态、恢复、控制或牌序。&#xa;④ 本经不以炁乱为核心；炁乱仅可由其他牌或后续秘籍介入。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="870" y="2200" width="680" height="210" as="geometry" /></mxCell>
        <mxCell id="e0" edge="1" parent="1" source="overview" target="c1" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c1" target="c2" style="endArrow=block;html=1;" value="研读推进"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c2" target="c3" style="endArrow=block;html=1;" value="研读推进"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c3" target="c4" style="endArrow=block;html=1;" value="研读推进"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1a" edge="1" parent="1" source="c1" target="c1_cards" style="endArrow=block;html=1;" value="习得"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1b" edge="1" parent="1" source="c1" target="c1_huafa" style="endArrow=block;html=1;" value="化法"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2a" edge="1" parent="1" source="c2" target="c2_cards" style="endArrow=block;html=1;" value="习得"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" edge="1" parent="1" source="c2" target="c2_huafa" style="endArrow=block;html=1;" value="化法"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3a" edge="1" parent="1" source="c3" target="c3_cards" style="endArrow=block;html=1;" value="习得"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3b" edge="1" parent="1" source="c3" target="c3_huafa" style="endArrow=block;html=1;" value="化法"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4a" edge="1" parent="1" source="c4" target="c4_cards" style="endArrow=block;html=1;" value="习得"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4b" edge="1" parent="1" source="c4" target="c4_note" style="endArrow=block;html=1;" value="累计周天"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
