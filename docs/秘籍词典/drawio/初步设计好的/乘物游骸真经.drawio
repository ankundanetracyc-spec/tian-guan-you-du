<?xml version="1.0" encoding="utf-8"?><mxfile host="Electron" agent="Codex">
  <diagram id="chengwu-youhai" name="乘物游骸真经">
    <mxGraphModel dx="3807" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="乘物游骸真经" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="云息秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十层&lt;br&gt;主气血、游骸与身法；每轮首次主动气血下降获得游骸，满足肉身根基阈值时消耗游骸规避含物理伤害招式的全部伤害；主修心法每消耗1层游骸便获得身法3层；可托身化骸养身法，也可用解形攻伐，最终将本场已耗游骸化作冯虚多段攻伐。&lt;br&gt;不接入血炉与借力；血炉、借力由其他专门功法开启。&lt;br&gt;修持修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；即时队列战斗不设技能冷却、准备或收招，也不自动回落气血。" vertex="1">
          <mxGeometry height="190" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;第一卷：游骸&lt;br&gt;卷章ID：you_hai&lt;br&gt;顺序：1&lt;br&gt;&lt;br&gt;定位：以主动回落寄形于骸，建立确定闪避的起点&lt;br&gt;学成可修至：云息三层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：凡人境界及以上&lt;br&gt;研读属性：身心协调值≥5&lt;br&gt;&lt;br&gt;学会永久属性：体魄 +0.5、神魂 +0.5；体道造诣 +0.5&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="340" x="850" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +15%&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="360" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：催血&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;原技能效果：获得气血1层。&lt;br&gt;化法追加：施放前若自身身法不少于10层且当前没有游骸，额外获得游骸1层。&lt;br&gt;使用次数：不限&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="280" x="1360" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：乘物游骸&lt;br&gt;习得：蜕形&lt;br&gt;&lt;br&gt;乘物游骸：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、闪避&lt;br&gt;效果：每回合首次由自身主动使气血层数降低后，获得游骸1层。&lt;br&gt;主修额外效果：每次实际消耗游骸后，获得身法3层；抵挡、托身或化法消耗均触发。&lt;br&gt;&lt;br&gt;蜕形：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避、回复&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：气血-1；触发气血层数降低时的回复效果；获得身法2层。&lt;br&gt;&lt;br&gt;大世界术法：游骸行遁&lt;br&gt;类型：遁行&lt;br&gt;施展方式：持续施展&lt;br&gt;习得条件：学会本卷后永久解锁；无需装配来源秘籍。&lt;br&gt;使用场景：世界地图行旅；须先选定一条可通行路线&lt;br&gt;目标：当前选定路线&lt;br&gt;耗费：每实际跨入1格消耗1点大世界精力；启用、预览和取消不扣&lt;br&gt;时间：无额外施法时间；按1.5倍遁速重新计算逐格行程耗时&lt;br&gt;效果：本段有效遁速 = 角色遁速 × 1.5。仍逐格处理迷雾、地点发现和现有事件，NPC随实际行旅时间推进；不赋予飞行或地形通行能力。&lt;br&gt;使用次数：不限；每段路线单独启用&lt;br&gt;中止与失败：到达终点、手动停止、事件打断或进入战斗时结束。精力不足以支付下一格时停在当前格；非法路线或无力支付首格时不开始、不扣费、不推进时间。&lt;br&gt;实施状态：已确认；地图施放尚未接入。&lt;/div&gt;" vertex="1">
          <mxGeometry height="620" width="740" x="-400" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;第二卷：托身&lt;br&gt;卷章ID：tuo_shen&lt;br&gt;顺序：2&lt;br&gt;&lt;br&gt;定位：托身耗骸换取持续身法，并为冯虚蓄势&lt;br&gt;学成可修至：云息六层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息三层及以上&lt;br&gt;前置：已学游骸&lt;br&gt;研读属性：身心协调值≥7；体道造诣≥0.5&lt;br&gt;&lt;br&gt;学会永久属性：体魄 +0.5、神魂 +0.5；体道造诣 +0.5&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="340" x="850" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;气血上限 +1&lt;br&gt;身法 +4%&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="390" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：发劲&lt;br&gt;类型：攻伐&lt;br&gt;关键词：闪避、增伤&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;伤害类型：物理&lt;br&gt;原技能效果：对指定1名敌方造成A点物理伤害。&lt;br&gt;化法追加：施放时若自身拥有游骸，消耗1层并计入本场已消耗游骸，本次伤害提高50%。&lt;br&gt;计算公式：A=round(8 + 体魄×0.65 + 体道造诣×0.20)。&lt;br&gt;使用次数：不限&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="290" x="1360" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：乘物游骸&lt;br&gt;&lt;br&gt;乘物游骸：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、闪避&lt;br&gt;效果：每回合首次由自身主动使气血层数降低后，获得游骸1层和身法1层。&lt;br&gt;主修额外效果：每次实际消耗游骸后，获得身法3层；抵挡、托身或化法消耗均触发。&lt;br&gt;&lt;br&gt;习得：托身&lt;br&gt;&lt;br&gt;托身：&lt;br&gt;类型：术诀&lt;br&gt;关键词：闪避&lt;br&gt;耗费：体力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：仅当自身当前拥有游骸时可施放；消耗游骸1层并计入本场已消耗游骸；获得身法2层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="740" x="-400" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;第三卷：解形&lt;br&gt;卷章ID：jie_xing&lt;br&gt;顺序：3&lt;br&gt;&lt;br&gt;定位：令基础平息也成为身法与游骸的衔接点&lt;br&gt;学成可修至：云息九层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息六层及以上&lt;br&gt;前置：已学托身&lt;br&gt;研读属性：身心协调值≥9；体道造诣≥1&lt;br&gt;&lt;br&gt;学会永久属性：体魄 +0.75、神魂 +0.25；体道造诣 +1&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="340" x="850" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;物理伤害 +5%&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="400" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：平息&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避、回复&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;原技能效果：气血层数降低1层，触发气血层数降低时的回复效果。&lt;br&gt;化法追加：本技能使气血下降后，获得身法1层。&lt;br&gt;使用次数：不限&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="290" x="1360" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：无新增主动技能&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="740" x="-400" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;verticalAlign=top;spacing=12;spacingTop=12;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;第四卷：冯虚&lt;br&gt;卷章ID：feng_xu&lt;br&gt;顺序：4&lt;br&gt;&lt;br&gt;定位：按本场耗骸数施展多段攻伐，收束攻防循环&lt;br&gt;学成可修至：云息十层&lt;br&gt;&lt;br&gt;学习条件：&lt;br&gt;灵根：任意&lt;br&gt;境界：云息九层及以上&lt;br&gt;前置：已学解形&lt;br&gt;研读属性：身心协调值≥10；体道造诣≥2&lt;br&gt;&lt;br&gt;学会永久属性：体魄 +0.25、神魂 +0.25；体道造诣 +1&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="340" x="850" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;最大生命 +10%&lt;br&gt;身法 +6%&lt;br&gt;物理伤害 +5%&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="270" x="370" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;化法&lt;br&gt;技能：发劲&lt;br&gt;类型：攻伐&lt;br&gt;关键词：闪避、增伤&lt;br&gt;耗费：体力 1、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;伤害类型：物理&lt;br&gt;原技能效果：对指定1名敌方造成A点物理伤害。&lt;br&gt;化法追加：本场已消耗游骸不少于1层时，对同一目标额外结算1段物理伤害；该段造成B点物理伤害。&lt;br&gt;计算公式：A=round(8 + 体魄×0.65 + 体道造诣×0.20)；B=round(4 + 体魄×0.35 + 体道造诣×0.15)。&lt;br&gt;使用次数：不限&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="290" x="1360" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：乘物游骸&lt;br&gt;&lt;br&gt;乘物游骸：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、闪避&lt;br&gt;效果：每回合首次由自身主动使气血层数降低后，获得游骸1层和身法2层。&lt;br&gt;主修额外效果：每次实际消耗游骸后，获得身法3层；抵挡、托身或化法消耗均触发。&lt;br&gt;&lt;br&gt;习得：冯虚&lt;br&gt;&lt;br&gt;冯虚：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤&lt;br&gt;耗费：体力 3、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;出手方式：近身&lt;br&gt;伤害类型：物理&lt;br&gt;效果：本场已消耗游骸不少于2层时可用；不消耗当前游骸。伤害段数：A段。每段造成B点物理伤害。&lt;br&gt;计算公式：A=1 + floor(本场已消耗游骸÷2)；B=round(8 + 体魄×0.75 + 体道造诣×0.30)。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="410" width="740" x="-400" y="2000" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;现行技能：蜕形、托身、冯虚；第三卷不授主动技能，各卷化法改写催血、发劲、平息、发劲。游骸每轮首次主动气血回落时获得；主修每次实际消耗游骸获得身法3层，冯虚读取全场已耗游骸。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="702.0" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="术语与状态详解&lt;br&gt;&lt;br&gt;气血&lt;br&gt;公共战斗状态，基础上限8层；气血层数主动降低时按当前回落回复率回复最大生命的5%（受明确效果修正）；即时队列战斗无回合末自动下降，其他自动回落来源须由对应状态或技能定义；战斗结束重置。&lt;br&gt;&lt;br&gt;游骸&lt;br&gt;敌方招式即将结算且含物理伤害时检查。来源可追溯且双方体魄、神魂可读时，比较体魄＋min(体魄×1.0,神魂×1.0)＋体道造诣；仅当攻击者总和严格小于自身总和的2倍，才消耗1层并规避该招对自身造成的全部伤害，包括物理、神魂及多段伤害；阈值不满足则不消耗并继续身法判定。来源不可追溯或无法读取体魄/神魂时，直接消耗1层并抵挡该招对自身全部伤害；缺少体道造诣按0计。范围招式由各目标分别判定。队首匹配应对先处理，再判定游骸。&lt;br&gt;&lt;br&gt;本场已消耗游骸层数&lt;br&gt;本场战斗内的来源计数：每当游骸因整项技能伤害闪避或技能效果而被消耗时+1；不占状态栏，仅供冯虚读取；战斗结束重置。&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续型增益状态，最多20层，持续1回合。每层使自身基础身法属性（dodge）提高1%；有效身法属性 = floor(基础dodge × (1 + 身法层数 × 0.01 + 本经修持身法加成))。获得新层时叠加并刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减；受击不消耗层数；1回合时长归零或战斗结束时移除。" vertex="1">
          <mxGeometry height="542" width="430" x="1660" y="872.0" as="geometry" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="overview" style="endArrow=block;html=1;" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c2" style="endArrow=block;html=1;" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c3" style="endArrow=block;html=1;" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_a" edge="1" parent="1" source="c1" style="endArrow=block;html=1;" target="c1_left" value="修持">
