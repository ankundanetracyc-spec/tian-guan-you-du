<?xml version="1.0" encoding="utf-8"?><mxfile host="Electron" agent="Codex">
  <diagram id="yinfu-yingwu" name="阴符应物经">
    <mxGraphModel dx="3614" dy="610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;" value="阴符应物经" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="锻躯秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主化解与借力；以应对技能抵消当前攻击，将敌势转成借力，再以挟势保势或合劲终结&lt;br&gt;化解不是护盾，仅抵消本次攻击的物理伤害&lt;br&gt;即时战斗适配：60 FPS队列；心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；气血无自动回落，身法、伤势与整场限次按公共规则。&lt;br&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。" vertex="1">
          <mxGeometry height="185" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：承机&#xA;卷章ID：cheng_ji&#xA;顺序：1&#xA;定位：承敌之机，令化解成为借力入口&#xA;学成可修至：云息三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：未确定或锻躯&#xA;境界：凡人境界及以上&#xA;研读属性：体魄≥5；敏捷≥5；体道造诣≥6&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +30" vertex="1">
          <mxGeometry height="92" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：承机（追加效果，保留原效果）&lt;br&gt;类型：守御&lt;br&gt;关键词：防御、攻防联动&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身（应对敌方攻击）&lt;br&gt;效果：保留承机原化解效果；触发时现有借力每满2层使本次化解额外增加1层，最多增加2层；未造成实际生命损失时仍按原效果获得借力1层。" vertex="1">
          <mxGeometry height="250" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：阴符应物&lt;br&gt;习得：承机&lt;br&gt;&lt;br&gt;阴符应物：&lt;br&gt;类型：心法&lt;br&gt;关键词：防御、攻防联动&lt;br&gt;效果：获得同名唯一Buff；以化解应对攻击时，每完整抵消4点该次攻击伤害，获得借力1层。&lt;br&gt;主修额外追加：改为每完整抵消3点该次攻击伤害，获得借力1层。&lt;br&gt;&lt;br&gt;承机：&lt;br&gt;类型：术诀&lt;br&gt;关键词：防御、攻防联动&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身；敌方攻击自身时使用&lt;br&gt;&lt;br&gt;效果：获得化解 = max(1, floor(体魄/2) + floor(体道造诣/3))层；该次攻击结算后若自身生命未实际减少，获得借力1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：挟势&#xA;卷章ID：xie_shi&#xA;顺序：2&#xA;定位：借势而不竭势，保留层数给后续收束&#xA;学成可修至：云息六层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息三层及以上&#xA;前置：已学承机&#xA;研读属性：体魄≥6；敏捷≥7；体道造诣≥7&#xA;学会永久属性：敏捷 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：化解获得层数 +1&lt;br&gt;最大生命 +20" vertex="1">
          <mxGeometry height="92" width="270" x="390" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：挟势（追加效果，保留原效果）&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤、攻防联动&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：round(6 + 体魄×0.45 + 体道造诣×0.30)&lt;br&gt;效果：保留挟势原伤害与借力效果；每层借力在原有增伤之外再提高本次伤害倍率2%。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：挟势&lt;br&gt;&lt;br&gt;挟势：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤、攻防联动&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;&lt;br&gt;伤害类型：物理&lt;br&gt;效果：对目标造成物理伤害；伤害 = round(6 + 体魄×0.45 + 体道造诣×0.30)，再享受借力公共加成。本技能结算后不移除借力。&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：应物&#xA;卷章ID：ying_wu&#xA;顺序：3&#xA;定位：使基础卸力也承接敌势，稳定积蓄借力&#xA;学成可修至：云息九层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息六层及以上&#xA;前置：已学挟势&#xA;研读属性：体魄≥8；敏捷≥8；体道造诣≥9&#xA;学会永久属性：体魄 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：物理伤害 +3%" vertex="1">
          <mxGeometry height="92" width="270" x="400" y="995" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;卸力（追加效果，保留基础效果）&lt;br&gt;类型：守御&lt;br&gt;关键词：防御、攻防联动&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身（敌方攻击自身时应对）&lt;br&gt;效果：敌方攻击自身时获得化解。若本次化解实际抵消至少1点物理伤害，获得借力1层。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：无新增主动技能&lt;br&gt;&lt;br&gt;本卷通过化法改写基础技能【卸力】，不把该基础技能或其化法版本计入习得。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：合劲&#xA;卷章ID：he_jin&#xA;顺序：4&#xA;定位：合众势为一击，完成借力体系的终结反制&#xA;学成可修至：云息十三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息九层及以上&#xA;前置：已学应物&#xA;研读属性：体魄≥9；敏捷≥10；体道造诣≥10&#xA;学会永久属性：体道造诣 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：借力每层物理伤害加成 +1 个百分点&lt;br&gt;物理伤害 +3%" vertex="1">
          <mxGeometry height="92" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：合劲（追加效果，保留原效果）&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤、攻防联动&lt;br&gt;耗费：精力 3、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：round((10 + 体魄×0.55 + 体道造诣×0.35)×(1 + 借力层数×0.08))&lt;br&gt;效果：保留合劲原伤害并消耗全部借力；若施放时借力不少于3层，本次伤害倍率额外提高10%。&lt;br&gt;使用次数：本场1次" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：合劲&lt;br&gt;&lt;br&gt;合劲：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤、攻防联动&lt;br&gt;耗费：精力 3、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;&lt;br&gt;伤害类型：物理&lt;br&gt;效果：借力每层总增伤8%（公共5% + 本技能额外3%）；消耗全部借力，对目标造成物理伤害；伤害 = round((10 + 体魄×0.55 + 体道造诣×0.35)×(1 + 借力层数×0.08))。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;战斗主链：敌方攻击 → 化解抵消实际伤害 → 阴符应物转借力 → 挟势享受借力但保留层数 → 合劲清空借力终结。&lt;br&gt;本经追求完全化解；它与主动承受攻击、积累内外伤的路线形成明确取舍。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;术语与状态详解&lt;br&gt;&lt;br&gt;化解&lt;br&gt;仅在敌方攻击自身时由应对技能获得；每层抵消该次攻击1点物理伤害；该次攻击结算后全部消散。不是护盾，不是常驻减伤。&lt;br&gt;&lt;br&gt;借力&lt;br&gt;每层使下一次自身主动施放的物理伤害技能伤害提高5%，该技能结算后移除全部借力。&lt;br&gt;&lt;br&gt;挟势例外&lt;br&gt;挟势享受借力伤害加成，但结算后不移除借力；合劲则读取每层总增伤8%并移除全部借力。&lt;/div&gt;&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续增益状态，最多20层，持续1回合；每层使自身基础身法（dodge）提高1%；获得新层时刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减，受击不消耗；1回合时长归零或战斗结束时移除。&lt;br&gt;&lt;br&gt;淬炼&lt;br&gt;仅本场战斗生效，随本经心法Buff显示于图标信息栏；不进入角色永久属性。" vertex="1">
          <mxGeometry height="430" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
