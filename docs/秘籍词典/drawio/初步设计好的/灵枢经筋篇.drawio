<?xml version="1.0" encoding="utf-8"?><mxfile host="Electron" agent="Codex">
  <diagram id="lingshu-jingjin" name="灵枢经筋篇">
    <mxGraphModel dx="3614" dy="610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;" value="灵枢经筋篇" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="锻躯秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主伤势兑现；主动消耗内外伤状态层数，转为借力、生命回复或中段物理爆发&lt;br&gt;不自行施加内伤，最适合映照内景损益篇&lt;br&gt;即时战斗适配：60 FPS队列；心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；气血无自动回落，身法、伤势与整场限次按公共规则。&lt;br&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。" vertex="1">
          <mxGeometry height="185" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：去故&#xA;卷章ID：qu_gu&#xA;顺序：1&#xA;定位：以去故纳新之法，令内外伤转为借力&#xA;学成可修至：云息三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：未确定或锻躯&#xA;境界：凡人境界及以上&#xA;研读属性：体魄≥6；敏捷≥5；体道造诣≥5&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +30" vertex="1">
          <mxGeometry height="92" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：去故（追加效果，保留原效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：伤势、闪避、攻防联动&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：消耗至多3层伤势（优先内伤），每层转为借力1层；本次消耗至少2层时额外获得身法1层。&lt;br&gt;使用次数：本场1次" vertex="1">
          <mxGeometry height="250" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：灵枢经筋&lt;br&gt;习得：去故&lt;br&gt;&lt;br&gt;灵枢经筋：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、伤势、攻防联动&lt;br&gt;效果：获得同名唯一Buff；本场首次主动消耗内伤或外伤状态层时获得借力1层。&lt;br&gt;主修额外追加：若该次主动效果消耗至少3层内伤或外伤，获得气血1层。&lt;br&gt;&lt;br&gt;去故：&lt;br&gt;类型：术诀&lt;br&gt;关键词：伤势、攻防联动&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：仅当至少有2层内伤或外伤时可用；消耗至多3层（优先内伤），每层转为借力1层。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：调枢&#xA;卷章ID：tiao_shu&#xA;顺序：2&#xA;定位：调经筋之枢，以少量伤势换取续航&#xA;学成可修至：云息六层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息三层及以上&#xA;前置：已学去故&#xA;研读属性：体魄≥7；敏捷≥6；体道造诣≥6&#xA;学会永久属性：体魄 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：气血上限 +1" vertex="1">
          <mxGeometry height="92" width="270" x="390" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：催血（追加效果，保留原效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、伤势、回复&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：获得气血1层；若施放前有伤势，自动消耗1层（优先内伤），成功消耗时回复最大生命×3%。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：调枢&lt;br&gt;&lt;br&gt;调枢：&lt;br&gt;类型：术诀&lt;br&gt;关键词：回复、伤势&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：仅当至少有1层内伤或外伤时可用；消耗至多2层（优先内伤），每层回复最大生命×3%。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：平息&#xA;卷章ID：ping_xi&#xA;顺序：3&#xA;定位：使基础回落之术也能成为烧伤借势的节点&#xA;学成可修至：云息九层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息六层及以上&#xA;前置：已学调枢&#xA;研读属性：体魄≥8；敏捷≥8；体道造诣≥8&#xA;学会永久属性：体魄 +0.5；敏捷 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：每主动消耗1层内伤或外伤，回复最大生命 +1%&lt;br&gt;物理伤害 +3%" vertex="1">
          <mxGeometry height="92" width="270" x="400" y="995" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;平息（追加效果，保留基础效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、回复、攻防联动&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：气血-1；气血下降按公共规则回复最大生命&#215;3%。可额外消耗内伤或外伤1层（优先内伤）；若如此做，获得借力1层。&lt;br&gt;使用次数：本场1次" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：无新增主动技能&lt;br&gt;&lt;br&gt;本卷通过化法改写基础技能【平息】，不把该基础技能或其化法版本计入习得。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：引筋&#xA;卷章ID：yin_jin&#xA;顺序：4&#xA;定位：以损为引，炼成中段的单点爆发&#xA;学成可修至：云息十三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息九层及以上&#xA;前置：已学平息&#xA;研读属性：体魄≥10；敏捷≥9；体道造诣≥10&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：物理伤害 +5%&lt;br&gt;最大生命 +20" vertex="1">
          <mxGeometry height="92" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：发劲（追加效果，保留原效果）&lt;br&gt;类型：攻伐&lt;br&gt;关键词：伤势、增伤&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：round(8 + 体魄×0.40 + 体道造诣×0.20 + 敏捷×0.25)&lt;br&gt;效果：保留发劲基础伤害；施放前若自身有伤势，自动消耗1层（优先内伤），本次伤害倍率提高20%。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：引筋&lt;br&gt;&lt;br&gt;引筋：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：增伤、伤势&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;&lt;br&gt;伤害类型：物理&lt;br&gt;效果：消耗内伤或外伤1层（优先内伤），对目标造成物理伤害；伤害 = round((8 + 体魄×0.45 + 体道造诣×0.30)×1.60)。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;战斗主链：内外伤积累 → 去故消耗转借力 / 调枢换续航 → 引筋烧伤打击 → 借力交给挟势或合劲兑现。&lt;br&gt;本经消耗内外伤状态层表示的伤势，不再使用抽取伤势或降低生命上限的旧机制。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;术语与状态详解&lt;br&gt;&lt;br&gt;灵枢经筋&lt;br&gt;本经同名唯一心法Buff，持续至本场战斗结束；本场首次主动消耗内伤或外伤状态层时获得借力1层。主修时，若该次主动效果消耗至少3层内伤或外伤，获得气血1层。&lt;br&gt;&lt;br&gt;内外伤&lt;br&gt;被主动消耗后立即移除该状态层，不再计入伤势层数；不触发旧版抽取伤势或最大生命惩罚。&lt;br&gt;&lt;br&gt;借力&lt;br&gt;每层使下一次自身主动施放的物理伤害技能伤害提高5%；该技能结算后移除全部借力。挟势是例外：享受加成但不移除借力。&lt;/div&gt;&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续增益状态，最多20层，持续1回合；每层使自身基础身法（dodge）提高1%；获得新层时刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减，受击不消耗；1回合时长归零或战斗结束时移除。&lt;br&gt;&lt;br&gt;淬炼&lt;br&gt;仅本场战斗生效，随本经心法Buff显示于图标信息栏；不进入角色永久属性。" vertex="1">
          <mxGeometry height="430" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
