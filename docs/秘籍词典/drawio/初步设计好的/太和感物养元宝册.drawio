        <mxCell id="c1_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontColor=#242b2a;spacing=22;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=hidden;rounded=1;arcSize=8;" value="&lt;div style=&quot;font-family:Microsoft YaHei;font-size:20px;line-height:1.4;text-align:left;overflow-wrap:anywhere;&quot;&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;心法被动：太和感物养元&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;关键词：气血、应对&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;效果：自身每次触发应对后，获得气血1层；受气血上限限制。&lt;/div&gt;&lt;div style=&quot;height:12px;line-height:12px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;习得：&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;乘势再攻*2&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;关键词：应对&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;耗费：体力2、法力0&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;占格：2×2&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;目标：随机一名合法敌人&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;出手方式：近身&lt;/div&gt;&lt;div style=&quot;height:12px;line-height:12px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;效果：对一名随机敌人造成A点（A=round(8+体魄×0.65+体道造诣×0.20)）近身物理伤害。目标应对此次攻击、首段未造成生命伤害，两项条件各追加一段同等伤害并触发一次自身应对；可触发太和心法。&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="450" width="760" x="36" y="396.0" as="geometry" />
        </mxCell>
