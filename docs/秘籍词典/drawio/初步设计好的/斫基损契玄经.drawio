        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;align=left;verticalAlign=middle;spacing=22;spacingTop=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontColor=#242b2a;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=hidden;arcSize=8;" value="&lt;div style=&quot;font-family:Microsoft YaHei;font-size:20px;line-height:1.4;text-align:left;overflow-wrap:anywhere;&quot;&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;第二卷：剪灯&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;研读值（累计）：48&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;学成可修至：云息六层&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;学习条件：灵根任意；云息三层及以上；灵慧≥6；术法造诣≥0.5&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;前置：秉烛&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;学会永久属性：术法造诣 +0.5&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;习得：焚元*1&lt;/div&gt;&lt;/div&gt;" vertex="1">
