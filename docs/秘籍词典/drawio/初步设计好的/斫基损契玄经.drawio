        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=20;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontColor=#242b2a;spacing=22;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=hidden;rounded=1;arcSize=8;" value="&lt;div style=&quot;font-family:Microsoft YaHei;font-size:20px;line-height:1.4;text-align:left;overflow-wrap:anywhere;&quot;&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;心法被动：斫基损契（沿用第一卷，无新增效果）&lt;/div&gt;&lt;div style=&quot;height:12px;line-height:12px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight:700;&quot;&gt;习得：&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;焚元*1&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;关键词：周天&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;耗费：体力1、法力0&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;占格：2×1&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;目标：自身&lt;/div&gt;&lt;div style=&quot;height:12px;line-height:12px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;效果：燃烧自身法力上限1点，获得炁2；施放前法力上限须至少为2。每回合限一次。&lt;/div&gt;&lt;div style=&quot;font-weight:400;&quot;&gt;使用次数：每回合1次；同招共享。&lt;/div&gt;&lt;/div&gt;" vertex="1">
