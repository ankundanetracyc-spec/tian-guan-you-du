<?xml version="1.0" encoding="utf-8"?><mxfile host="Electron" agent="Codex">
  <diagram id="buxu-xingxue" name="补虚行血诀">
    <mxGraphModel dx="3614" dy="610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;" value="补虚行血诀" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="锻躯秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主气血见底后的复起；主动将气血落至零层，换取下一次催血的高效回补与精力续航&lt;br&gt;可与乘物游骸真经混修：先借游骸闪避，再让气血落底并快速复起&lt;br&gt;即时战斗适配：60 FPS队列；心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；气血无自动回落，身法、伤势与整场限次按公共规则。&lt;br&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。" vertex="1">
          <mxGeometry height="185" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：补虚&#xA;卷章ID：bu_xu&#xA;顺序：1&#xA;定位：立虚中行血之法，将气血见底改作复起入口&#xA;学成可修至：云息三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：未确定或锻躯&#xA;境界：凡人境界及以上&#xA;研读属性：体魄≥5；体道造诣≥4&#xA;学会永久属性：体魄 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +30&lt;br&gt;气血上限 +1" vertex="1">
          <mxGeometry height="92" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：还阳（追加效果，保留原效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、回复&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：若气血为0，获得气血2层；否则获得1层。施放前气血为0层时，获得气血后额外回复最大生命×3%。" vertex="1">
          <mxGeometry height="250" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：补虚行血&lt;br&gt;习得：还阳&lt;br&gt;&lt;br&gt;补虚行血：&lt;br&gt;类型：心法&lt;br&gt;关键词：生命、闪避、精力&lt;br&gt;效果：获得同名唯一Buff，持续至本场战斗结束；本场首次气血由1层降至0层时，本场下一项由自身主动施展的催血技能少消耗1点精力，且额外获得气血1层。&lt;br&gt;主修额外追加：该催血技能结算后获得身法1层。&lt;br&gt;&lt;br&gt;还阳：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：若自身气血为0，获得气血2层；否则获得气血1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：守缺&#xA;卷章ID：shou_que&#xA;顺序：2&#xA;定位：在气血见底时保持身法与应对能力&#xA;学成可修至：云息六层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息三层及以上&#xA;前置：已学补虚&#xA;研读属性：体魄≥6；体道造诣≥5&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：气血回落回复率 +2 个百分点" vertex="1">
          <mxGeometry height="92" width="270" x="390" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;技能：卸力（追加效果，保留原效果）&lt;br&gt;类型：守御&lt;br&gt;关键词：生命、防御&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身（应对敌方物理攻击）&lt;br&gt;效果：保留卸力原化解效果；气血为0层时若本次应对触发，额外获得1层化解。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：守缺&lt;br&gt;&lt;br&gt;守缺：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：仅当自身气血为0时可用；获得身法1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：余温&#xA;卷章ID：yu_wen&#xA;顺序：3&#xA;定位：以余温主动落底，换取更厚的当次回复与复起机会&#xA;学成可修至：云息九层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息六层及以上&#xA;前置：已学守缺&#xA;研读属性：体魄≥7；体道造诣≥7&#xA;学会永久属性：体魄 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +20&lt;br&gt;气血回落回复率 +1 个百分点" vertex="1">
          <mxGeometry height="92" width="270" x="400" y="995" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;平息（追加效果，保留基础效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避、回复&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：气血-1；气血下降按公共规则回复最大生命&#215;3%。若本技能使气血由1层降至0层，获得身法1层。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：余温&lt;br&gt;&lt;br&gt;余温：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避、回复&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：气血-1；额外回复最大生命×3%。若本技能使气血由1层降至0层，触发补虚行血。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：归元&#xA;卷章ID：gui_yuan&#xA;顺序：4&#xA;定位：以低位回转收束云息期的气血续航&#xA;学成可修至：云息十三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息九层及以上&#xA;前置：已学余温&#xA;研读属性：体魄≥9；体道造诣≥9&#xA;学会永久属性：体道造诣 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：气血上限 +1&lt;br&gt;物理伤害 +4%" vertex="1">
          <mxGeometry height="92" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;催血（追加效果，保留基础效果）&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：自身&lt;br&gt;效果：获得气血1层；若本场已触发补虚行血，本技能结算后获得身法1层。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：归元&lt;br&gt;&lt;br&gt;归元：&lt;br&gt;类型：术诀&lt;br&gt;关键词：生命、闪避&lt;br&gt;耗费：精力 3、法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：仅当自身气血为0时可用；获得气血3层；获得身法2层。&lt;br&gt;使用次数：本场1次&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;战斗主链：气血由1降至0 → 补虚行血令下一次主动施放的催血技能减费并额外增加气血 → 还阳、归元或催血快速复起 → 主修获得身法。&lt;br&gt;本诀不要求常驻高气血，优势来自低位回转与结束前的补足。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;术语与状态详解&lt;br&gt;&lt;br&gt;气血&lt;br&gt;锻躯公共战斗状态，基础上限3层；每次下降1层回复最大生命×3%；即时战斗无自动回落；仅由明确技能或状态效果触发气血下降；战斗结束重置。&lt;br&gt;&lt;br&gt;补虚行血&lt;br&gt;本诀同名唯一心法Buff，持续至本场战斗结束。本场首次气血由1层降至0层时：本场内下一次由自身主动施放的催血技能少消耗1点精力，且额外获得气血1层；主修时，该催血技能结算后获得身法1层。若本场结束前未主动施放催血技能，该效果失效。&lt;br&gt;&lt;br&gt;判定边界&lt;br&gt;只在气血恰由1层降至0层时触发；从2层以上直接降至0层不触发。即时战斗没有回合结束自动回落。&lt;/div&gt;&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续增益状态，最多20层，持续1回合；每层使自身基础身法（dodge）提高1%；获得新层时刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减，受击不消耗；1回合时长归零或战斗结束时移除。&lt;br&gt;&lt;br&gt;淬炼&lt;br&gt;仅本场战斗生效，随本经心法Buff显示于图标信息栏；不进入角色永久属性。" vertex="1">
          <mxGeometry height="430" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
