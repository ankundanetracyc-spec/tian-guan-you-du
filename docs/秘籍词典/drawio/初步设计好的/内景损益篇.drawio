<mxfile host="Electron" agent="Codex">
  <diagram id="neijing-sunyi" name="内景损益篇">
    <mxGraphModel dx="3614" dy="610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=20;" value="内景损益篇" vertex="1">
          <mxGeometry height="74" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="锻躯秘籍 / 可主修、可辅修&lt;br&gt;主修可修至：云息十三层&lt;br&gt;主伤势收束；以限时内外伤状态压制行动，换取持续物理增伤和高倍率重击&lt;br&gt;锻躯内伤由对应技能施加；外伤只在相应技能效果明确时加入&lt;br&gt;即时战斗适配：60 FPS队列；心法被动：战斗开始时显示在Buff栏，常驻至战斗结束；气血无自动回落，身法、伤势与整场限次按公共规则。&lt;br&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。" vertex="1">
          <mxGeometry height="185" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：损益&#xA;卷章ID：sun_yi&#xA;顺序：1&#xA;定位：立损益之法，以主动承伤积累内外伤状态&#xA;学成可修至：云息三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：未确定或锻躯&#xA;境界：凡人境界及以上&#xA;研读属性：体魄≥6；体道造诣≥6&#xA;学会永久属性：体魄 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：最大生命 +35&lt;br&gt;每层内伤或外伤造成的最大生命临时降低 -0.25 个百分点" vertex="1">
          <mxGeometry height="92" width="260" x="360" y="395" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="280" x="1360" y="390" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;心法被动：内景损益&lt;br&gt;习得：淬厉&lt;br&gt;&lt;br&gt;内景损益：&lt;br&gt;类型：心法&lt;br&gt;关键词：伤势&lt;br&gt;效果：获得同名唯一Buff；每有1层内伤或外伤，自身主动打出的锻躯物理伤害提高3%。&lt;br&gt;主修额外追加：每层内伤或外伤额外提高2%，即合计提高5%。&lt;br&gt;&lt;br&gt;淬厉：&lt;br&gt;类型：术诀&lt;br&gt;关键词：伤势、闪避&lt;br&gt;耗费：精力 1；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：向自身获得内伤2层；获得身法1层。&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="740" x="-400" y="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：履薄&#xA;卷章ID：lu_bo&#xA;顺序：2&#xA;定位：以承伤造痕，使防守取舍也累积外伤状态&#xA;学成可修至：云息六层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息三层及以上&#xA;前置：已学损益&#xA;研读属性：体魄≥7；体道造诣≥7&#xA;学会永久属性：体魄 +1" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：物理伤害 +3%" vertex="1">
          <mxGeometry height="92" width="270" x="390" y="760" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;卸力（体修基础技能追加效果，保留原效果）&lt;br&gt;关键词：防御、伤势&lt;br&gt;原效果：敌方攻击自身时使用；获得化解 = max(1, floor(体魄/2) + floor(体道造诣/3))；每层抵消本次攻击1点物理伤害。&lt;br&gt;追加：该次攻击结算后若自身生命实际减少，获得外伤2层。&lt;br&gt;耗费与目标沿用卸力：精力 1；自身（敌方攻击自身时使用）。&lt;br&gt;本卷化法只追加效果，不计入习得。" vertex="1">
          <mxGeometry height="250" width="290" x="1360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：履薄&lt;br&gt;&lt;br&gt;履薄：&lt;br&gt;类型：术诀&lt;br&gt;关键词：伤势&lt;br&gt;耗费：精力 1；法力 0&lt;br&gt;目标：自身&lt;br&gt;&lt;br&gt;效果：获得持续1回合的履薄状态；获得状态的回合不扣时长，从下一完整回合结束时递减；效果期间每第二次受到敌方攻击并损失实际生命时，获得外伤1层；计数在效果结束或刷新时归零。&lt;/div&gt;" vertex="1">
          <mxGeometry height="384" width="740" x="-400" y="766" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：守缺&#xA;卷章ID：shou_que&#xA;顺序：3&#xA;定位：在内外伤状态的时限内维持攻势&#xA;学成可修至：云息九层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息六层及以上&#xA;前置：已学履薄&#xA;研读属性：体魄≥9；体道造诣≥8&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：每层内伤或外伤造成的最大生命临时降低 -0.25 个百分点&lt;br&gt;最大生命 +20" vertex="1">
          <mxGeometry height="92" width="270" x="400" y="995" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：无新增主动技能&lt;br&gt;&lt;br&gt;本卷效果：延续内景损益对当前内伤与外伤状态层数的读取；不新增伤势资源；内外伤分别计时、各自最多4层。&lt;br&gt;&lt;br&gt;设计注意：伤势数量与物理增伤均读取内伤、外伤状态层数之和；状态过期或被消耗后不再计入。&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="740" x="-400" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：百骸&#xA;卷章ID：bai_hai&#xA;顺序：4&#xA;定位：百骸俱损而力贯一击，完成云息期伤势收束&#xA;学成可修至：云息十三层&#xA;学习条件：&#xA;灵根：任意&#xA;路径：锻躯&#xA;境界：云息九层及以上&#xA;前置：已学守缺&#xA;研读属性：体魄≥10；体道造诣≥10&#xA;学会永久属性：体魄 +0.5；体道造诣 +0.5" vertex="1">
          <mxGeometry height="240" width="340" x="850" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="淬炼（仅战斗内）&lt;br&gt;战斗属性：物理伤害 +6%" vertex="1">
          <mxGeometry height="92" width="270" x="370" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;无" vertex="1">
          <mxGeometry height="82" width="290" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;习得：百骸&lt;br&gt;&lt;br&gt;百骸：&lt;br&gt;类型：攻伐&lt;br&gt;关键词：伤势&lt;br&gt;耗费：精力 3；法力 0&lt;br&gt;目标：指定1名敌方&lt;br&gt;&lt;br&gt;伤害类型：物理&lt;br&gt;效果：对目标结算物理伤害；本场限用一次；伤害段数 = 1 + floor(内伤与外伤状态层数合计÷3)；每段伤害 = round(6 + 体魄×0.35 + 体道造诣×0.25)。&lt;/div&gt;" vertex="1">
          <mxGeometry height="372" width="740" x="-400" y="1638" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;淬炼修正只作用于战斗内属性，并随本卷心法被动显示在Buff栏信息详情；战斗结束移除，不进入角色永久属性。&lt;br&gt;战斗主链：淬厉或承伤入伤势 → 内外伤状态计数并持续提高锻躯物理伤害 → 百骸每读取3张伤势多结算一段伤害。&lt;br&gt;与灵枢经筋篇混修时，内外伤状态可再被消耗兑现。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="&lt;div style=&quot;text-align:left;&quot;&gt;术语与状态详解&lt;br&gt;&lt;br&gt;内外伤&lt;br&gt;本场战斗的限时状态；内伤、外伤各最多4层、分别持续1回合；同类新增层刷新本类计时，主动消耗只移除对应层数；获得层的回合不扣时长，从下一完整回合结束时递减；伤势数量为当前内伤与外伤层数之和。自身技能主动施加为内伤，敌方攻击造成实际生命损失时施加为外伤；消耗后立即移除，不影响最大生命。&lt;br&gt;&lt;br&gt;内景损益&lt;br&gt;本经同名唯一心法Buff，持续至本场战斗结束；每有1层内伤或外伤，自身主动锻躯物理伤害提高3%。主修时每层额外提高2%，合计5%。&lt;br&gt;&lt;br&gt;判定边界&lt;br&gt;只有造成生命实际减少的攻击才满足留痕、履薄的承伤条件；化解只是本次攻击的伤害抵消，不是护盾。&lt;/div&gt;&lt;br&gt;&lt;br&gt;身法&lt;br&gt;持续增益状态，最多20层，持续1回合；每层使自身基础身法（dodge）提高1%；获得新层时刷新为1回合；获得层的回合不扣时长，从下一完整回合结束时递减，受击不消耗；1回合时长归零或战斗结束时移除。&lt;br&gt;&lt;br&gt;淬炼&lt;br&gt;仅本场战斗生效，随本经心法Buff显示于图标信息栏；不进入角色永久属性。" vertex="1">
          <mxGeometry height="430" width="430" x="1660" y="820" as="geometry" />
        </mxCell>
