        <mxCell id="v2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="纳气&#xA;行动速度+3&#xA;会心+2" vertex="1">
          <mxGeometry height="84" width="270" x="570" y="890" as="geometry" />
        </mxCell>
        <mxCell id="v2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;" value="化法&#xA;基础技能库额外加入 身随剑转*1" vertex="1">
          <mxGeometry height="64" width="330" x="1400" y="880" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="属性与路线汇总&#xA;学会永久属性：敏捷+2，剑道造诣+2&#xA;纳气合计：精准+3，行动速度+6，会心+2&#xA;化法合计：替换1张基础步法，额外加入1张身随剑转" vertex="1">
          <mxGeometry height="99" width="390" x="1780" y="360" as="geometry" />
        </mxCell>
        <mxCell id="ev1l" edge="1" parent="1" source="v1" style="endArrow=block;html=1;rounded=0;" target="v1_left" value="纳气">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
