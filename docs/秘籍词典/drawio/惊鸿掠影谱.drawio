        <mxCell id="status_rules" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="状态与关联&amp;#xA;剑意：自身增益；回身点锋命中后获得。&amp;#xA;剑痕：目标状态；可提高回身点锋会心。">
