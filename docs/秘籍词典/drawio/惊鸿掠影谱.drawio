          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" edge="1" parent="1" source="v2" style="endArrow=block;html=1;rounded=0;" target="c3" value="习得">
          <mxGeometry relative="1" as="geometry" />
