<mxfile host="app.diagrams.net" modified="2026-07-19T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="liuyun" name="流云剑经">
    <mxGraphModel dx="2607" dy="246" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="流云剑经&#xa;" vertex="1">
          <mxGeometry height="90" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="剑修秘籍 / 可主修可辅修&#xa;秘籍总览&#xa;灵根要求：有灵根即可&#xa;主修可修至：云息十三层&#xa;偏灵活与多段追击伤害" vertex="1">
          <mxGeometry height="130" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="buffs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" value="通用状态&#xa;剑意：每层剑术伤害+5%&#xa;基础剑攻击命中后获得1层剑意&#xa;本回合与上一回合都未获得新剑意时清零&#xa;流云剑势：每回合开始消耗2层剑意，剑意不足则本回合失效；造成剑术伤害后追加流云追击" vertex="1">
          <mxGeometry height="170" width="360" x="1770" y="330" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：照水&#xa;卷章ID：zhao_shui&#xa;顺序：1&#xa;定位：入门卷，照水观剑，养锋起意&#xa;学成可修至：云息三层&#xa;学习条件：有灵根即可&#xa;学会永久属性：剑道造诣+1.5，敏捷+1，悟性+1" vertex="1">
          <mxGeometry height="165" width="340" x="850" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;精准+4&lt;br&gt;会心+4&lt;div&gt;行动速度+4&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="360" y="375" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&#xa;斩剑*2 -&gt; 流云斩*2&#xa;养锋*1 -&gt; 养云藏意*1&#xa;习得：流云斩*2，养云藏意*1" vertex="1">
          <mxGeometry height="120" width="280" x="1360" y="370" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：流云斩*2，养云藏意*1&#xa;流云斩：消耗精力4，1-1，8+剑道*0.52+体魄*0.16+敏捷*0.12；命中+1剑意；遁身后会心+4&#xa;养云藏意：消耗精力0，消耗，回复精力12+剑道*0.32+体魄*0.10；无剑意则+1剑意，否则护盾4+剑道*0.10" vertex="1">
          <mxGeometry height="170" width="360" x="-260" y="220" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：行云&#xa;卷章ID：xing_yun&#xa;顺序：2&#xa;定位：身法卷，先动再出剑，并提前入势&#xa;学成可修至：云息六层&#xa;学习条件：已学照水；敏捷≥5，剑道造诣≥12&#xa;学会永久属性：剑道造诣+2，敏捷+1，体魄+1" vertex="1">
          <mxGeometry height="175" width="340" x="850" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;div&gt;精准+6&lt;br&gt;闪避+6&lt;br&gt;行动速度+6&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="410" y="670" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&#xa;点锋*2 -&gt; 穿云点*2&#xa;基础步法*1 -&gt; 行云换步*1&#xa;习得：流云·起势*1，穿云点*2，行云换步*1" vertex="1">
          <mxGeometry height="120" width="280" x="1360" y="655" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：流云·起势*1，穿云点*2，行云换步*1&#xa;流云·起势：消耗精力0，心法牌，进入流云剑势；辅修+1剑意，主修+2剑意；每回合开始消耗2剑意维持，若剑意不足则该回合内该剑势效果无法生效&#xa;穿云点：消耗精力5，1-2，6+剑道*0.42+敏捷*0.24+体魄*0.08；命中+1剑意；遁身后伤害+25%；流云剑势中会心+6&#xa;行云换步：消耗精力3，消耗，移动2格；下一张剑攻击精准+8" vertex="1">
          <mxGeometry height="170" width="360" x="-260" y="485" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：听澜&lt;br&gt;卷章ID：ting_lan&lt;br&gt;顺序：3&lt;br&gt;定位：主修核心卷，听澜持势，守中回锋&lt;br&gt;限制：主修向核心卷&lt;br&gt;学成可修至：云息九层&lt;br&gt;学习条件：主修；已学行云；剑道造诣≥18，敏捷≥7&lt;br&gt;学会永久属性：剑道造诣+2.5，敏捷+1，体魄+1" vertex="1">
          <mxGeometry height="200" width="340" x="850" y="960" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;精准+8&lt;br&gt;闪避+6&lt;div&gt;行动速度+8&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&#xa;敛息观剑*1 -&gt; 听澜续意*1&#xa;格剑*1 -&gt; 格云回锋*1&#xa;习得：听澜续意*1，格云回锋*1" vertex="1">
          <mxGeometry height="130" width="300" x="1360" y="980" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：听澜续意*1，格云回锋*1&#xa;听澜续意：消耗精力0，消耗，回复精力10+剑道*0.24+敏捷*0.12，获得2层剑意；流云剑势中下一次维持-1剑意&#xa;格云回锋：消耗精力3，化解 max(1,floor(剑道/6)+floor(敏捷/12))；已有剑意+1化解；流云剑势中下一剑会心+8" vertex="1">
          <mxGeometry height="220" width="370" x="-265" y="790" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：叠云&#xa;卷章ID：die_yun&#xa;顺序：4&#xa;定位：主修收束卷，流云千叠，兑现递归追击&#xa;限制：主修向核心卷&#xa;学成可修至：云息十三层&#xa;学习条件：主修；已学听澜；剑道造诣≥24，敏捷≥9&#xa;学会永久属性：剑道造诣+2，敏捷+2" vertex="1">
          <mxGeometry height="200" width="340" x="850" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;div&gt;精准+8&lt;br&gt;会心+8&lt;br&gt;行动速度+10&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="390" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&#xa;基础牌库 + 流云千叠追锋*1&#xa;习得：流云千叠追锋*1" vertex="1">
          <mxGeometry height="110" width="300" x="1360" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：流云千叠追锋*1&#xa;流云千叠追锋：消耗法力2、精力8，1-2，10+剑道*0.58+敏捷*0.22+体魄*0.12；非剑势中命中+2剑意并触发1次流云追击；剑势中不加自身剑意，第二次追击概率80%；第三次起，本次概率=上一次概率×对数系数；对数系数=min(0.90,log2(剑意+1)/4)；自第二次追击起每次额外消耗法力1、精力2；遁身后会心+10" vertex="1">
          <mxGeometry height="150" width="360" x="-270" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="属性汇总&#xa;学会永久属性总收益：剑道造诣+8，敏捷+4，体魄+2，悟性+3，心境上限+6&#xa;纳气总收益：精准+12，闪避+12，会心+12，行动速度+14&#xa;纳气只给派生战斗属性；主修差异集中在听澜卷、叠云卷与剑势维持" vertex="1">
          <mxGeometry height="170" width="390" x="1670" y="620" as="geometry" />
        </mxCell>
