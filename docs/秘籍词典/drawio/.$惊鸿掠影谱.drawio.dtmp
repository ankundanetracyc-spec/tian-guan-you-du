        <mxCell id="v1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;" value="化法&amp;#xa;基础步法*1 → 惊鸿掠步*1" vertex="1">
          <mxGeometry height="145" width="330" x="1400" y="410" as="geometry" />
