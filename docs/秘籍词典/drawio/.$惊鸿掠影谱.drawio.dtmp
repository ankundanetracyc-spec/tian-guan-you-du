        <mxCell id="v2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;" value="化法&amp;#xa;基础牌库额外加入 身随剑转*1" vertex="1">
          <mxGeometry height="145" width="330" x="1400" y="880" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="属性与路线汇总&amp;#xa;学会永久属性：敏捷+2，剑道造诣+2&amp;#xa;纳气合计：精准+3，行动速度+6，会心+2&amp;#xa;化法合计：替换1张基础步法，额外加入1张身随剑转&amp;#xa;辅修时整本只启用其中一条路线" vertex="1">
          <mxGeometry height="210" width="390" x="1780" y="360" as="geometry" />
        </mxCell>
        <mxCell id="branch_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" value="辅修路线选择&amp;#xa;纳气与化法二选一&amp;#xa;选择作用于已学全部卷章&amp;#xa;切换时先撤销旧路线，再应用新路线" vertex="1">
          <mxGeometry height="130" width="840" x="710" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="ev1l" edge="1" parent="1" source="v1" style="endArrow=block;html=1;rounded=0;" target="v1_left" value="纳气">
