        <mxCell id="v1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="纳气&amp;#xa;精准+3&amp;#xa;行动速度+3" vertex="1">
          <mxGeometry height="125" width="270" x="570" y="420" as="geometry" />
