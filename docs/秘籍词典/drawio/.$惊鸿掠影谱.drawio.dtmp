        <mxCell id="v2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" value="纳气&amp;#xa;行动速度+3&amp;#xa;会心+2" vertex="1">
