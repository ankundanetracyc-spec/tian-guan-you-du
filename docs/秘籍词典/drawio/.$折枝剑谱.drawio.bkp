<mxfile host="Electron" agent="Codex">
  <diagram id="zhezhi" name="折枝剑谱">
    <mxGraphModel dx="2902" dy="423" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="折枝剑谱&#xa;" vertex="1">
          <mxGeometry height="90" width="560" x="740" y="20" as="geometry" />
        </mxCell>
        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="剑修秘籍 / 可主修可辅修&lt;br&gt;秘籍总览&lt;br&gt;灵根要求：有灵根即可&lt;br&gt;主修可修至：云息十三层&lt;br&gt;辅修可用至：云息九层&lt;br&gt;定位：叠痕、压伤、削护心、终式爆发" vertex="1">
          <mxGeometry height="150" width="560" x="740" y="140" as="geometry" />
        </mxCell>
        <mxCell id="mechanics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" value="机制摘要&#xa;剑意：每层剑术伤害+5%&#xa;剑痕：敌方debuff，每层使攻击者对其剑术精准+2，最多按9层计算，持续2个目标回合&#xa;外伤：由折枝系牌消耗剑痕加入目标弃牌堆，后续压低目标行动/身法/遁身效率&#xa;折损：折枝专属debuff，每层护心-4%，最多5层；摧枝一剑消耗折损，每层伤害+15%&#xa;折枝剑势：每回合开始消耗1层剑意维持；消耗剑痕加入外伤时，同时施加折损" vertex="1">
          <mxGeometry height="190" width="410" x="1690" y="330" as="geometry" />
        </mxCell>
        <mxCell id="compare" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="流派侧重点&#xa;叠debuff后爆发&#xa;先叠剑痕，消耗剑痕压外伤，再叠折损削护心&#xa;最后用摧枝一剑消耗折损打爆发" vertex="1">
          <mxGeometry height="150" width="390" x="1710" y="570" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：拂枝&lt;br&gt;卷章ID：fu_zhi&lt;br&gt;顺序：1&lt;br&gt;定位：入门施痕，建立伤势前置&lt;br&gt;学成可修至：云息三层&lt;br&gt;学习条件：有灵根即可&lt;br&gt;学会永久属性：剑道造诣+1.5，敏捷+1，体魄+0.5" vertex="1">
          <mxGeometry height="170" width="350" x="845" y="380" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;精准+6&lt;br&gt;会心+2" vertex="1">
          <mxGeometry height="105" width="260" x="395" y="410" as="geometry" />
        </mxCell>
        <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;斩剑*2 -&amp;gt; 拂枝剑*2&lt;br&gt;养锋*1 -&amp;gt; 照痕息*1" vertex="1">
          <mxGeometry height="120" width="300" x="1360" y="405" as="geometry" />
        </mxCell>
        <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：拂枝剑*2，照痕息*1&lt;br&gt;拂枝剑：精力4，1-1，7+剑道*0.48+敏捷*0.16+体魄*0.12；命中+1剑意，目标+1剑痕&lt;br&gt;照痕息：精力0，消耗，回复精力10+剑道*0.28+体魄*0.10；场上存在剑痕敌人时+1剑意；折枝剑势中，下一张折枝攻击额外+1剑痕" vertex="1">
          <mxGeometry height="175" width="420" x="-250" y="300" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：压枝&#xa;卷章ID：ya_zhi&#xa;顺序：2&#xa;定位：开启折枝剑势，将剑痕压成伤势&#xa;学成可修至：云息六层&#xa;学习条件：已学拂枝；剑道造诣≥12，敏捷≥5&#xa;学会永久属性：剑道造诣+2，敏捷+1，体魄+1" vertex="1">
          <mxGeometry height="185" width="350" x="845" y="680" as="geometry" />
        </mxCell>
        <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;精准+4&lt;br&gt;行动速度+6" vertex="1">
          <mxGeometry height="105" width="260" x="395" y="720" as="geometry" />
        </mxCell>
        <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;点锋*2 -&amp;gt; 压枝刺*2&lt;br&gt;基础步法*1 -&amp;gt; 折步*1" vertex="1">
          <mxGeometry height="125" width="300" x="1360" y="710" as="geometry" />
        </mxCell>
        <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：折枝·立势*1，压枝刺*2，折步*1&lt;br&gt;折枝·立势：精力8，心法牌；辅修+1剑意，主修+2剑意；进入折枝剑势；每回合开始消耗1剑意维持&lt;br&gt;压枝刺：精力5，1-2，6+剑道*0.42+敏捷*0.20+体魄*0.12；命中+1剑意，目标+1剑痕；目标至少2剑痕时伤害+20%；折枝剑势中消耗2剑痕加入外伤*1&lt;br&gt;折步：精力3，消耗，移动1格；下一张折枝攻击精准+8；若该牌加入外伤，额外+1折损" vertex="1">
          <mxGeometry height="245" width="440" x="-260" y="540" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：裂柯&lt;br&gt;卷章ID：lie_ke&lt;br&gt;顺序：3&lt;br&gt;定位：主修核心卷，稳定制造外伤与折损&lt;br&gt;限制：主修向核心卷&lt;br&gt;学成可修至：云息九层&lt;br&gt;学习条件：主修；已学压枝；剑道造诣≥18，敏捷≥7&lt;br&gt;学会永久属性：剑道造诣+2.5，敏捷+1，体魄+1" vertex="1">
          <mxGeometry height="215" width="350" x="845" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;精准+6&lt;br&gt;护心+4" vertex="1">
          <mxGeometry height="105" width="260" x="395" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;敛息观剑*1 -&amp;gt; 裂柯*1&lt;br&gt;格剑*1 -&amp;gt; 护枝回剑*1" vertex="1">
          <mxGeometry height="130" width="320" x="1360" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="主修习得：裂柯*1，护枝回剑*1&lt;br&gt;裂柯：精力6，1-2，8+剑道*0.50+敏捷*0.18+体魄*0.14；目标需带剑痕；命中+1剑意，消耗2剑痕，目标弃牌堆加入外伤*1；目标手牌已有外伤时额外+1折损&lt;br&gt;护枝回剑：精力3，应对；带折损敌人攻击自身时自动打出；获得化解，攻击者+1剑痕；折枝剑势中攻击者+1折损" vertex="1">
          <mxGeometry height="230" width="440" x="-260" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：摧枝&lt;br&gt;卷章ID：cui_zhi&lt;br&gt;顺序：4&lt;br&gt;定位：主修收束卷，消耗折损打爆发&lt;br&gt;限制：主修向核心卷&lt;br&gt;学成可修至：云息十三层&lt;br&gt;学习条件：主修；已学裂柯；剑道造诣≥24，敏捷≥9&lt;br&gt;学会永久属性：剑道造诣+2，敏捷+1.5，体魄+0.5" vertex="1">
          <mxGeometry height="225" width="350" x="845" y="1335" as="geometry" />
        </mxCell>
        <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;会心+6&lt;br&gt;行动速度+8" vertex="1">
          <mxGeometry height="105" width="260" x="395" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;基础牌库 + 挑枝断筋*1&lt;br&gt;摧枝一剑：本卷习得牌" vertex="1">
          <mxGeometry height="120" width="320" x="1360" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="主修习得：挑枝断筋*1，摧枝一剑*1&lt;br&gt;挑枝断筋：法力1，精力7，1-2，9+剑道*0.54+敏捷*0.20+体魄*0.14；命中+1剑意，目标+1剑痕；目标至少3剑痕时消耗3剑痕并加入外伤*1；成功加入外伤时+1折损；目标手牌有外伤时会心+10&lt;br&gt;摧枝一剑：法力2，精力9，1-2，12+剑道*0.68+敏捷*0.20+体魄*0.16；目标需有折损；消耗最多5层折损，每层伤害+15%；目标手牌有外伤时会心+12" vertex="1">
          <mxGeometry height="270" width="450" x="-270" y="1185" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="属性汇总&#xa;学会永久属性总收益：剑道造诣+8，敏捷+4.5，体魄+3&#xa;纳气总收益：精准+16，会心+8，行动速度+14，护心+4&#xa;牌路：拂枝施痕，压枝入伤，裂柯加损，摧枝爆发" vertex="1">
          <mxGeometry height="165" width="420" x="1680" y="790" as="geometry" />
        </mxCell>
