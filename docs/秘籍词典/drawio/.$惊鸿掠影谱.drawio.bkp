<mxfile host="Electron" agent="Codex"><diagram id="jinghong-lueying" name="惊鸿掠影谱"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1300"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="惊鸿掠影谱&#xA;仅辅修 · 身法剑谱 · 敏捷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="20" width="600" height="90" as="geometry" /></mxCell><mxCell id="rule" value="秘籍定位与辅修规则&#xA;可作主修：否　可作辅修：是　无可修炼至的境界&#xA;装入辅修位时，整本只能选择纳气或化法一边；学会永久属性不受路线影响&#xA;输入：上一张剑攻击 / 遁身牌　输出：换位、步后精准、剑意、遁身减耗&#xA;服务：流云剑经、折枝剑谱、未来剑影分光" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="900" height="190" as="geometry" /></mxCell><mxCell id="v1" value="第一卷：惊鸿卷&amp;#xa;顺序：1&amp;#xa;学习要求：有灵根；敏捷≥5；剑道造诣≥6&amp;#xa;学会永久属性：敏捷+1，剑道造诣+1&amp;#xa;习得：惊鸿掠步*1、回身点锋*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="390" width="400" height="190" as="geometry" /></mxCell><mxCell id="c1" value="惊鸿掠步&#xA;遁身 / 灵活、消耗 / 精力12 / 移动2格&#xA;下一张本体剑攻击精准+6&#xA;若上一张是剑攻击，额外移动1格&#xA;职责：剑后换位，步后再剑" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="500" height="250" as="geometry" /></mxCell><mxCell id="c2" value="回身点锋&#xA;攻击 / 精力14 / 射程1-2&#xA;伤害：6 + 剑道造诣×0.38 + 敏捷×0.22 + 体魄×0.08&#xA;命中获得1剑意；上一张为遁身牌时伤害+20%&#xA;目标带剑痕：会心+4" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="500" height="250" as="geometry" /></mxCell><mxCell id="v2" value="第二卷：返影卷&amp;#xa;顺序：2&amp;#xa;学习要求：已学惊鸿卷；敏捷≥8；剑道造诣≥10&amp;#xa;学会永久属性：敏捷+1，剑道造诣+1&amp;#xa;习得：身随剑转*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="400" height="200" as="geometry" /></mxCell><mxCell id="c3" value="身随剑转&#xA;特殊 / 消耗 / 精力0&#xA;本回合下一张本体剑攻击命中后：&#xA;下一张遁身牌精力消耗-4&#xA;若目标带剑痕，额外获得1剑意" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="500" height="260" as="geometry" /></mxCell><mxCell id="combo" value="秘籍内循环&#xA;回身点锋 → 惊鸿掠步（剑后多走1格）→ 下一剑精准+6&#xA;身随剑转 → 本体剑命中 → 遁身减耗 → 回身点锋步后增伤&#xA;跨秘籍：折枝的压枝读取“本回合用过遁身牌”；流云读取位移和本体剑攻击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1760" y="620" width="410" height="240" as="geometry" /></mxCell><mxCell id="limit" value="辅修边界&#xA;不生成折损、剑影或追击次数&#xA;不建立独立剑势&#xA;只在剑与步之间提供一次性桥接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1780" y="900" width="390" height="190" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="rule" target="v1" style="endArrow=block;html=1;" value="学习第一卷"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="v1" target="v2" style="endArrow=block;html=1;" value="满足前置"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v1_left" parent="1" vertex="1" value="纳气&amp;#xa;精准+3&amp;#xa;行动速度+3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;"><mxGeometry x="570" y="420" width="270" height="125" as="geometry" /></mxCell><mxCell id="v1_right" parent="1" vertex="1" value="化法&amp;#xa;基础步法*1 → 惊鸿掠步*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;"><mxGeometry x="1400" y="410" width="330" height="145" as="geometry" /></mxCell><mxCell id="v2_left" parent="1" vertex="1" value="纳气&amp;#xa;行动速度+3&amp;#xa;会心+2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;"><mxGeometry x="570" y="890" width="270" height="125" as="geometry" /></mxCell><mxCell id="v2_right" parent="1" vertex="1" value="化法&amp;#xa;基础牌库额外加入 身随剑转*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;"><mxGeometry x="1400" y="880" width="330" height="145" as="geometry" /></mxCell><mxCell id="summary" parent="1" vertex="1" value="属性与路线汇总&amp;#xa;学会永久属性：敏捷+2，剑道造诣+2&amp;#xa;纳气合计：精准+3，行动速度+6，会心+2&amp;#xa;化法合计：替换1张基础步法，额外加入1张身随剑转&amp;#xa;辅修时整本只启用其中一条路线" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;"><mxGeometry x="1780" y="360" width="390" height="210" as="geometry" /></mxCell><mxCell id="branch_note" parent="1" vertex="1" value="辅修路线选择&amp;#xa;纳气与化法二选一&amp;#xa;选择作用于已学全部卷章&amp;#xa;切换时先撤销旧路线，再应用新路线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;"><mxGeometry x="680" y="1110" width="840" height="130" as="geometry" /></mxCell><mxCell id="ev1l" parent="1" edge="1" source="v1" target="v1_left" value="纳气" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev1r" parent="1" edge="1" source="v1" target="v1_right" value="化法" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev2l" parent="1" edge="1" source="v2" target="v2_left" value="纳气" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev2r" parent="1" edge="1" source="v2" target="v2_right" value="化法" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ec1" parent="1" edge="1" source="v1" target="c1" value="习得" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ec2" parent="1" edge="1" source="v2" target="c3" value="习得" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ec1b" parent="1" edge="1" source="v1" target="c2" value="习得" style="endArrow=block;html=1;rounded=0;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>