<?xml version="1.0" encoding="utf-8"?>
<mxfile host="Electron" agent="Codex">
  <diagram id="tingfeng-xunxi" name="听锋寻隙篇">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="听锋寻隙篇&#xA;仅辅修 · 识破剑诀 · 神魂/剑道造诣" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="20" width="600" height="79" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="秘籍定位&#xA;可作主修：否　可作辅修：是　无可修炼至的境界&#xA;适用条件：目标是否带剑痕　提供效果：第一层剑痕、指定目标精准、剑意与恢复少量精力&#xA;适合搭配：折枝、流云、重剑、御剑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="900" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="第一卷：听锋卷&#xA;顺序：1&#xA;学习要求：有灵根；神魂≥5；剑道造诣≥8&#xA;研读值：56&#xA;学会永久属性：神魂+1，剑道造诣+1&#xA;习得：听锋辨隙*1、循隙一刺*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="400" height="138" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="听锋辨隙&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 1、法力 0&lt;br&gt;目标：单体敌人&lt;br&gt;选择一名敌人，施加1层剑痕&lt;br&gt;本次自身行动期间下一张由玩家主动打出且以该目标为对象的剑术攻击精准+6&lt;br&gt;主要作用：可靠施加第一层剑痕" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="500" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="循隙一刺&lt;br&gt;类型：攻伐牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 2、法力 0&lt;br&gt;目标：单体敌人&lt;br&gt;伤害类型：物理&lt;br&gt;伤害公式：7 + 剑道造诣×0.44 + 神魂×0.14 + 敏捷×0.10&lt;br&gt;无剑痕：命中施加1剑痕&lt;br&gt;已有剑痕：伤害+15%，不消耗剑痕" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="500" height="195" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="第二卷：观隙卷&#xA;顺序：2&#xA;学习要求：已学听锋卷；神魂≥8；剑道造诣≥12&#xA;研读值：84&#xA;学会永久属性：神魂+1，剑道造诣+1&#xA;习得：观痕养意*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="850" width="400" height="138" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="观痕养意&lt;br&gt;类型：术诀牌&lt;br&gt;关键词：无&lt;br&gt;耗费：精力 0、法力 0&lt;br&gt;目标：自身&lt;br&gt;场上存在带剑痕敌人：获得1剑意&lt;br&gt;每名带痕敌人回复2精力，最多计算3名&lt;br&gt;不消耗剑痕，不制造外伤" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="900" width="500" height="176" as="geometry" />
        </mxCell>
        <mxCell id="combo" value="常用出招顺序&#xA;听锋辨隙指定目标 → 循隙一刺在目标已有剑痕时提高伤害 → 观痕养意获得剑意并恢复精力&#xA;与其他秘籍搭配：折枝消耗这些剑痕；流云多段攻击共享精准；御剑可优先攻击带有剑痕的目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1760" y="620" width="410" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="rule" target="v1" style="endArrow=block;html=1;" value="学习第一卷">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="v1" target="v2" style="endArrow=block;html=1;" value="满足前置">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v1_left" parent="1" vertex="1" value="纳气&#xA;精准+4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;">
          <mxGeometry x="570" y="420" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v1_right" parent="1" vertex="1" value="化法&#xA;基础技能库额外加入 听锋辨隙*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;">
          <mxGeometry x="1400" y="410" width="330" height="64" as="geometry" />
        </mxCell>
        <mxCell id="v2_left" parent="1" vertex="1" value="纳气&#xA;精准+3&#xA;会心+2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;">
          <mxGeometry x="570" y="890" width="270" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v2_right" parent="1" vertex="1" value="化法&#xA;基础技能库额外加入 观痕养意*1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;">
          <mxGeometry x="1400" y="880" width="330" height="64" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" vertex="1" value="属性与路线汇总&#xA;学会永久属性：神魂+2，剑道造诣+2&#xA;纳气合计：精准+7，会心+2&#xA;化法合计：额外加入听锋辨隙*1、观痕养意*1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;">
          <mxGeometry x="1780" y="360" width="390" height="99" as="geometry" />
        </mxCell>
        <mxCell id="ev1l" parent="1" edge="1" source="v1" target="v1_left" value="纳气" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev1r" parent="1" edge="1" source="v1" target="v1_right" value="化法" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev2l" parent="1" edge="1" source="v2" target="v2_left" value="纳气" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev2r" parent="1" edge="1" source="v2" target="v2_right" value="化法" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1" parent="1" edge="1" source="v1" target="c1" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" parent="1" edge="1" source="v2" target="c3" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec1b" parent="1" edge="1" source="v1" target="c2" value="习得" style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="status_rules" parent="1" vertex="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;verticalAlign=top;" value="状态与关联&amp;#xA;剑痕：敌方状态；听锋辨隙施加1层，循隙一刺可利用。&amp;#xA;剑意：自身增益；观痕养意按场上带剑痕目标获得。">
          <mxGeometry x="1760" y="850" width="410" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
