<mxfile host="Electron" agent="Codex">
  <diagram id="mingwei-baoyuan" name="明微抱元经">
    <mxGraphModel dx="3048" dy="512" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="明微抱元经&#xa;" vertex="1"><mxGeometry height="90" width="560" x="740" y="20" as="geometry"/></mxCell>
      <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="仙道秘籍 / 仅可主修&lt;br&gt;秘籍总览&lt;br&gt;灵根要求：有灵根即可&lt;br&gt;主修可修至：云息十三层&lt;br&gt;偏神魂攻杀与控制；以照痕、返照、定影、烛微为主链&lt;br&gt;玄镜记忆直接传入幼子，不进入仓房" vertex="1"><mxGeometry height="150" width="560" x="740" y="140" as="geometry"/></mxCell>
      <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第一卷：照形&lt;br&gt;卷章ID：zhao_xing&lt;br&gt;顺序：1&lt;br&gt;定位：观其形，辨其隙；以物理破绽为主&lt;br&gt;学成可修至：云息三层&lt;br&gt;学习条件：玄镜洗髓后直接传承；有灵根、精力≥35&lt;br&gt;学会永久属性：灵慧+0.5，神魂+0.5" vertex="1"><mxGeometry height="175" width="340" x="850" y="360" as="geometry"/></mxCell>
      <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+10%&lt;br&gt;心境回复+10%" vertex="1"><mxGeometry height="100" width="260" x="360" y="395" as="geometry"/></mxCell>
      <mxCell id="c1_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;纳气基础牌库 + 照形*1&lt;br&gt;开启：静修 / 感气日程" vertex="1"><mxGeometry height="105" width="280" x="1360" y="390" as="geometry"/></mxCell>
      <mxCell id="c1_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：照形*1，留痕*1&lt;br&gt;照形：精力8；指定敌人获得1层【照痕】；本回合本家对其物理攻击精准+3。&lt;br&gt;留痕：精力12；物理伤害 5+灵慧×0.25；命中后再施加1层照痕。" vertex="1"><mxGeometry height="150" width="390" x="-270" y="220" as="geometry"/></mxCell>
      <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第二卷：返照&lt;br&gt;卷章ID：fan_zhao&lt;br&gt;顺序：2&lt;br&gt;定位：返其势而扰其行，形成反制与控势&lt;br&gt;学成可修至：云息六层&lt;br&gt;学习条件：已学照形；云息一层；灵慧≥6，神魂≥6，悟性≥45&lt;br&gt;学会永久属性：神魂+0.5，悟性+2" vertex="1"><mxGeometry height="185" width="340" x="850" y="650" as="geometry"/></mxCell>
      <mxCell id="c2_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+12%&lt;br&gt;灵力容量+8%&lt;br&gt;法力回复+10%" vertex="1"><mxGeometry height="115" width="260" x="390" y="680" as="geometry"/></mxCell>
      <mxCell id="c2_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;留痕*1 -&amp;gt; 返照*1&lt;br&gt;基础牌库 + 回势*1" vertex="1"><mxGeometry height="110" width="280" x="1360" y="685" as="geometry"/></mxCell>
      <mxCell id="c2_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：返照*1，回势*1&lt;br&gt;返照：精力10，应对；受照痕目标攻击时自动打出，使其本次精准-6，并额外获得1层照痕。&lt;br&gt;回势：法力1、精力14；物理伤害 7+灵慧×0.35；目标每有1层照痕，伤害+10%。" vertex="1"><mxGeometry height="160" width="390" x="-270" y="525" as="geometry"/></mxCell>
      <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第三卷：定影&lt;br&gt;卷章ID：ding_ying&lt;br&gt;顺序：3&lt;br&gt;定位：积痕定影，限制位移并压制神魂&lt;br&gt;学成可修至：云息九层&lt;br&gt;学习条件：已学返照；云息三层；灵慧≥8，神魂≥8，悟性≥55&lt;br&gt;学会永久属性：神魂+1，悟性+2" vertex="1"><mxGeometry height="185" width="340" x="850" y="960" as="geometry"/></mxCell>
      <mxCell id="c3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+15%&lt;br&gt;灵力容量+10%，灵力密度+10%&lt;br&gt;心境回复+15%" vertex="1"><mxGeometry height="120" width="270" x="370" y="995" as="geometry"/></mxCell>
      <mxCell id="c3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;回势*1 -&amp;gt; 定影*1&lt;br&gt;基础牌库 + 息轮*1" vertex="1"><mxGeometry height="110" width="290" x="1360" y="1000" as="geometry"/></mxCell>
      <mxCell id="c3_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：定影*1，息轮*1&lt;br&gt;定影：法力1、精力16；目标有3层照痕时消耗全部照痕，施加【定影】1回合：无法位移，行动速度-10。&lt;br&gt;息轮：精力0，消耗；回复心境10；若场上有定影目标，本回合首次神魂伤害+15%。" vertex="1"><mxGeometry height="165" width="400" x="-275" y="825" as="geometry"/></mxCell>
      <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" value="第四卷：烛微&lt;br&gt;卷章ID：zhu_wei&lt;br&gt;顺序：4&lt;br&gt;定位：烛见幽微，完成神魂攻杀与高阶控势&lt;br&gt;学成可修至：云息十三层&lt;br&gt;学习条件：已学定影；云息六层；灵慧≥10，神魂≥10，悟性≥65&lt;br&gt;学会永久属性：神魂+1，悟性+3" vertex="1"><mxGeometry height="185" width="340" x="850" y="1280" as="geometry"/></mxCell>
      <mxCell id="c4_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="纳气&lt;br&gt;修炼效率+18%&lt;br&gt;灵力密度+15%&lt;br&gt;灵识恢复+15%（云息后生效）" vertex="1"><mxGeometry height="115" width="270" x="370" y="1315" as="geometry"/></mxCell>
      <mxCell id="c4_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="化法&lt;br&gt;定影*1 -&amp;gt; 烛微*1&lt;br&gt;基础牌库 + 照隙*1" vertex="1"><mxGeometry height="110" width="290" x="1360" y="1320" as="geometry"/></mxCell>
      <mxCell id="c4_cards" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="习得：烛微*1，照隙*1&lt;br&gt;烛微：法力2、精力18；神魂伤害 6+神魂×0.70+灵慧×0.45；目标处于定影时伤害+50%，随后移除定影。&lt;br&gt;照隙：精力10，消耗；目标获得1层照痕；若其处于定影，则其神魂防御-2，持续至回合结束。" vertex="1"><mxGeometry height="170" width="400" x="-265" y="1130" as="geometry"/></mxCell>
      <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="属性汇总&#xa;学会永久属性：灵慧+0.5，神魂+3，悟性+5&#xa;纳气累计：修炼效率+55%，心境回复+25%，灵力容量+18%，灵力密度+25%，法力回复+10%&#xa;战斗主链：照痕（物理破绽）→ 定影（限位控势）→ 烛微（神魂攻杀）。" vertex="1"><mxGeometry height="175" width="420" x="1660" y="650" as="geometry"/></mxCell>
