        <mxCell id="summary" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;div style=&quot;text-align:left;&quot;&gt;模板心法示例：首卷完整、第三卷升级；第二卷沿用第一卷，第四卷沿用第三卷。&lt;br&gt;实际心法在哪卷变化，就在哪卷完整书写；其他卷引用最近一次完整版本。&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1660" y="650" as="geometry" />
        </mxCell>
        <mxCell id="c1_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="&lt;div style=&quot;text-align:center;&quot;&gt;修持（仅战斗内）&lt;br&gt;战斗属性：&lt;br&gt;填写本卷新增值&lt;/div&gt;" vertex="1">
