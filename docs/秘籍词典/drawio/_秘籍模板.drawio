        <mxCell id="overview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="&lt;div style=&quot;text-align:left;&quot;&gt;秘籍总览&lt;br&gt;五行与灵根要求：填写&lt;br&gt;可主修／可辅修：填写&lt;br&gt;主修起止境界：填写&lt;br&gt;核心构筑：填写&lt;br&gt;实施状态：填写&lt;/div&gt;" vertex="1">
