        <mxCell id="n3" value="西陵荒域&#xa;西陵戍所 · 绝灵渊 · 鬼哭岭（无主）" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#efe0cb;fillOpacity=70;strokeColor=#986d3a;strokeWidth=3;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="395" width="355" height="235" as="geometry"/></mxCell>
