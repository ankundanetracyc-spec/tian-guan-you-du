+        ParseInput(GetWindow(), new InputEventMouseButton
+        {
+            Position = point,
+            GlobalPosition = point,
+            ButtonIndex = direction,
+            Pressed = true,
+            CtrlPressed = control
+        });
+        await Frames(1);
+        ParseInput(GetWindow(), new InputEventMouseButton
+        {
+            Position = point,
+            GlobalPosition = point,
+            ButtonIndex = direction,
+            Pressed = false,
+            CtrlPressed = control
+        });
+        await Frames(4);
+    }
