+    private static string fingerprint(FormationCircuitData data)
+    {
+        var nodeParts = data.nodes
+            .Where(node => node is not null)
+            .Select(node => $"{node.node_id}:{effective_position(node).X:0.##},{effective_position(node).Y:0.##}")
+            .OrderBy(value => value, System.StringComparer.Ordinal);
+        var wireParts = data.pulse_wires
+            .Select(wire => $"{wire.from_node_id}->{wire.to_node_id}")
+            .OrderBy(value => value, System.StringComparer.Ordinal);
+        return string.Join("|", nodeParts) + "/" + string.Join("|", wireParts);
+    }
