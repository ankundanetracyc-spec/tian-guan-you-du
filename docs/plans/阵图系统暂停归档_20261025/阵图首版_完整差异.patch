+        GD.Print("FORMATION_EDITOR_CHECK_OK " + message);
+    }
+
+    private async Task Frames(int count = 4)
+    {
+        for (var i = 0; i < count; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+    }
+
+    private static System.Collections.Generic.IEnumerable<T> Nodes<T>(Node root) where T : Node
+    {
+        foreach (var child in root.GetChildren(includeInternal: true))
+        {
+            if (child is T match) yield return match;
+            foreach (var nested in Nodes<T>(child)) yield return nested;
+        }
+    }
+
+    private static void ParseInput(Window window, InputEvent input)
+    {
+        if (input is InputEventFromWindow fromWindow) fromWindow.WindowId = window.GetWindowId();
+        Input.ParseInputEvent(input);
+        Input.FlushBufferedEvents();
+    }
+
+    private void PushMotion(Vector2 point, MouseButtonMask mask = default)
+        => PushMotion(GetViewport(), point, mask);
+
+    private void PushMotion(Viewport viewport, Vector2 point, MouseButtonMask mask = default, bool parseGlobally = true)
+    {
+        var viewportId = viewport.GetInstanceId();
+        var relative = _lastMousePositions.TryGetValue(viewportId, out var previous) ? point - previous : Vector2.Zero;
+        if (parseGlobally) Input.WarpMouse(point);
+        var input = new InputEventMouseMotion
+        {
+            Position = point,
+            GlobalPosition = point,
+            Relative = relative,
+            ScreenRelative = relative,
+            ButtonMask = mask
+        };
+        if (parseGlobally) ParseInput(viewport.GetWindow(), input);
+        else viewport.PushInput(input, true);
+        _lastMousePositions[viewportId] = point;
+    }
+
+    private void PushMouse(Vector2 point, MouseButton button, bool pressed)
+        => PushMouse(GetViewport(), point, button, pressed);
+
+    private void PushMouse(Viewport viewport, Vector2 point, MouseButton button, bool pressed, bool parseGlobally = true)
+    {
+        var input = new InputEventMouseButton
+        {
+            Position = point,
+            GlobalPosition = point,
+            ButtonIndex = button,
+            Pressed = pressed,
+            ButtonMask = pressed && button == MouseButton.Left ? MouseButtonMask.Left : (MouseButtonMask)0
+        };
+        if (parseGlobally) ParseInput(viewport.GetWindow(), input);
+        else viewport.PushInput(input, true);
+        _lastMousePositions[viewport.GetInstanceId()] = point;
+    }
+
+    private static Vector2 GlobalPoint(Control control, Vector2 localPoint)
+        => control.GetGlobalTransformWithCanvas() * localPoint;
+
+    private static Vector2 GraphPoint(FormationEditorGraph graph, Vector2 viewportLocalPoint)
+        => graph.GetGlobalRect().Position + viewportLocalPoint;
+
+    private async Task Click(Vector2 point, MouseButton button = MouseButton.Left)
+        => await Click(GetViewport(), point, button);
+
+    private async Task Click(Viewport viewport, Vector2 point, MouseButton button = MouseButton.Left, bool parseGlobally = true)
+    {
+        PushMotion(viewport, point, default, parseGlobally);
+        PushMouse(viewport, point, button, true, parseGlobally);
+        await Frames(1);
+        PushMouse(viewport, point, button, false, parseGlobally);
+        await Frames(4);
+    }
+
+    private async Task Click(Control control)
+    {
+        var visible = control.IsVisibleInTree();
+        var rect = control.GetGlobalRect();
+        Check(visible && rect.HasArea(), $"{control.Name} 可见且可点 visible={visible} rect={rect}");
+        var viewport = control.GetViewport();
+        var point = control.GetGlobalRect().GetCenter();
+        if (viewport != GetViewport()) point += control.GetWindow().Position;
+        await Click(GetViewport(), point);
+    }
+
+    private async Task Drag(Vector2 start, Vector2 end)
+    {
+        PushMotion(start);
+        PushMouse(start, MouseButton.Left, true);
+        await Frames(1);
+        var distance = start.DistanceTo(end);
+        var steps = Math.Max(1, Mathf.CeilToInt(distance / 5f));
+        for (var step = 1; step <= steps; step++)
+        {
+            PushMotion(start.Lerp(end, step / (float)steps), MouseButtonMask.Left);
+            if (step % 20 == 0 && step < steps) await Frames(1);
+        }
+        PushMotion(end, MouseButtonMask.Left);
+        PushMouse(end, MouseButton.Left, false);
+        await Frames(5);
+    }
+
+    private async Task Drag(Control source, Control target, Vector2 targetLocal)
+        => await Drag(source.GetGlobalRect().GetCenter(), target is FormationEditorGraph graph
+            ? GraphPoint(graph, targetLocal)
+            : GlobalPoint(target, targetLocal));
+
+    private async Task DragPort(GraphNode source, GraphNode target)
+        => await Drag(GlobalPoint(source, source.GetOutputPortPosition(0)), GlobalPoint(target, target.GetInputPortPosition(0)));
+
+    private async Task Wheel(Vector2 point, MouseButton direction, bool control = false)
+    {
