+using Godot;
+using System.Diagnostics;
+using System.Globalization;
+using System.Reflection;
+using System.Threading.Tasks;
+using GArray = Godot.Collections.Array;
+using GDictionary = Godot.Collections.Dictionary;
+
+/// <summary>
+/// 独立双进程验收：正式百工按钮/画布输入/Ctrl+S→正式战场→结算返回→退出→标题页载入。
+/// 现行正式技能法力费均为0；付费正例仅使用不写盘的内存夹具，不改正式技能或发放成长。
+/// </summary>
+public partial class FormationJourneyAcceptance : Node
+{
+    private const string SaveName = "阵图首版独立流程验收";
+    private const BindingFlags Private = BindingFlags.Instance | BindingFlags.NonPublic;
+    private string _isolatedUserDirectory = "";
+    private int _checks;
+
+    private void Check(bool ok, string label)
+    {
+        if (!ok) throw new InvalidOperationException(label);
+        _checks++;
+    }
+    private static string Arg(string prefix) => OS.GetCmdlineUserArgs().FirstOrDefault(s => s.StartsWith(prefix, StringComparison.Ordinal))?[prefix.Length..] ?? "";
+    private static string Full(string path) => System.IO.Path.TrimEndingDirectorySeparator(System.IO.Path.GetFullPath(path));
+    private static T Field<T>(object owner, string name) => (T)(owner.GetType().GetField(name, Private)?.GetValue(owner) ?? throw new InvalidOperationException("缺少字段：" + name));
+    private static IEnumerable<T> Descendants<T>(Node node) where T : Node
+    {
+        foreach (var child in node.GetChildren())
+        {
+            if (child is T match) yield return match;
+            foreach (var descendant in Descendants<T>(child)) yield return descendant;
+        }
+    }
+    private async Task Frames(int count = 2)
+    {
+        for (var i = 0; i < count; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame);
+    }
+    private void Push(InputEvent input)
+    {
+        if (input is InputEventFromWindow fromWindow) fromWindow.WindowId = GetWindow().GetWindowId();
+        Input.ParseInputEvent(input);
+        Input.FlushBufferedEvents();
+    }
+    private async Task Until(Func<bool> condition, string label, int seconds = 75)
+    {
+        var timer = Stopwatch.StartNew();
+        while (!condition())
+        {
+            if (timer.Elapsed.TotalSeconds > seconds) throw new TimeoutException(label);
+            await Frames(1);
+        }
+    }
+    private void VerifyIsolation()
+    {
+        var expected = Arg("--expected-appdata=");
+        Check(expected.Length > 0 && Full(OS.GetEnvironment("APPDATA")) == Full(expected), "APPDATA未明确隔离，拒绝验收存档");
+        var custom = ProjectSettings.GetSetting("application/config/custom_user_dir_name").AsString();
+        _isolatedUserDirectory = Full(OS.GetUserDataDir());
+        Check(custom.Length > 0 && string.Equals(_isolatedUserDirectory, Full(System.IO.Path.Combine(expected, custom)), StringComparison.OrdinalIgnoreCase), "user://未解析到本次隔离目录");
+        var saves = Full(ProjectSettings.GlobalizePath("user://game_saves"));
+        Check(saves.StartsWith(_isolatedUserDirectory + System.IO.Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase), "存档目录越界");
+        GD.Print("FORMATION_JOURNEY_ISOLATED: " + _isolatedUserDirectory);
+    }
+
+    public override void _Ready()
+    {
+        ProcessMode = ProcessModeEnum.Always;
+        CallDeferred(nameof(Run));
+    }
+    private async void Run()
+    {
+        try
+        {
+            VerifyIsolation();
+            // 保留此验收节点跨场景运行，不把它打包进任何正式场景或存档。
+            GetTree().CurrentScene = null;
+            GetWindow().Mode = Window.ModeEnum.Windowed;
+            GetWindow().Size = new Vector2I(1920, 1080);
+            GetWindow().ContentScaleSize = new Vector2I(1920, 1080);
+            if (Arg("--phase=") == "write") await WritePhase();
+            else if (Arg("--phase=") == "read") await ReadPhase();
+            else throw new InvalidOperationException("需要 --phase=write 或 --phase=read");
+            GD.Print($"FORMATION_JOURNEY_{Arg("--phase=").ToUpperInvariant()}: {_checks} checks passed");
+            GetTree().Quit();
+        }
+        catch (Exception error)
+        {
+            GD.PushError("FORMATION_JOURNEY_FAILED: " + error);
+            GetTree().Paused = false;
+            GetTree().Quit(1);
+        }
+    }
+    private async Task<MainScene> WaitMain()
+    {
+        await Until(() => GetTree().CurrentScene is MainScene { StartupComplete: true } && !SceneLoadingScreen.IsChangingScene, "正式主场景初始化超时");
+        var main = (MainScene)GetTree().CurrentScene;
+        Check(main.StartupError is null, "主场景初始化出错：" + main.StartupError);
+        await Frames(3);
+        return main;
+    }
+    private async Task<BaigongPanel> OpenBaigong(MainScene main)
+    {
+        var craft = Descendants<Button>(main).Single(button => button.Name == "BtnCraft");
+        craft.EmitSignal(BaseButton.SignalName.Pressed);
+        await Frames();
+        var panel = Descendants<BaigongPanel>(main).Single();
+        Check(panel.Visible, "正式百工按钮没有打开面板");
+        return panel;
+    }
+    private static string Fingerprint(FormationCircuitData circuit)
+    {
+        var nodes = circuit.nodes.OrderBy(n => n.node_id.ToString()).Select(n => $"{n.node_id}:{n.has_editor_position}:{n.editor_position.X.ToString("R", CultureInfo.InvariantCulture)},{n.editor_position.Y.ToString("R", CultureInfo.InvariantCulture)}");
+        var wires = circuit.pulse_wires.Select(w => $"{w.from_node_id}>{w.to_node_id}").OrderBy(s => s);
+        return circuit.circuit_id + "|" + string.Join(";", nodes) + "|" + string.Join(";", wires);
+    }
+    private static FormationCircuitData Equipped(Character player) => ((HumanData)player.entity_data!).formation_circuits.Single(c => c.circuit_id.ToString() == FormationV1Catalog.CircuitId);
+
+    private async Task DragHeader(GraphNode node)
+    {
+        var from = node.GetGlobalTransformWithCanvas() * new Vector2(60, 15);
+        Push(new InputEventMouseMotion { Position = from, GlobalPosition = from });
+        await Frames();
+        Push(new InputEventMouseButton { Position = from, GlobalPosition = from, ButtonIndex = MouseButton.Left, Pressed = true });
+        await Frames();
+        for (var i = 1; i <= 8; i++)
+        {
+            var at = from + new Vector2(i * 5, i * 5);
+            Push(new InputEventMouseMotion { Position = at, GlobalPosition = at, Relative = new Vector2(5, 5), ButtonMask = MouseButtonMask.Left });
+            await Frames(1);
+        }
+        var to = from + new Vector2(40, 40);
+        Push(new InputEventMouseButton { Position = to, GlobalPosition = to, ButtonIndex = MouseButton.Left, Pressed = false });
+        await Frames();
+    }
+    private async Task WritePhase()
+    {
+        var saveManager = GetNode<GameSaveManager>("/root/GameSaveManager");
+        Check(saveManager.get_save_slots().Count == 0, "写阶段必须使用新的空隔离目录");
+        saveManager.begin_new_game(SaveName);
+        Check(GetTree().ChangeSceneToFile("res://tscn/scene/MainScene.tscn") == Error.Ok, "无法打开正式主场景");
+        var main = await WaitMain();
+        var player = main.get_player_character()!;
+        var human = (HumanData)player.entity_data!;
+        // 仅此隔离验收人物提供既有两阵录与造诣；生产建档流程不发放。
+        human.base_formation_proficiency = human.formation_proficiency = 30;
+        human.formation_manual_ids = FormationV1Catalog.CreateDefaultDraft().required_manual_ids.Duplicate();
+        Check(main.save_from_gameplay_menu(), "无法建立隔离正式存档");
+        var panel = await OpenBaigong(main);
+        var graph = Descendants<GraphEdit>(panel).Single();
+        var input = graph.GetNode<GraphNode>("spell_input");
+        var oldPosition = input.PositionOffset;
+        await DragHeader(input);
+        Check(input.PositionOffset != oldPosition, "真实视口拖动未改变元件位置");
+        Push(new InputEventKey { Keycode = Key.Escape, PhysicalKeycode = Key.Escape, Pressed = true });
+        await Frames();
+        Push(new InputEventKey { Keycode = Key.Escape, PhysicalKeycode = Key.Escape, Pressed = false });
+        Check(GetTree().Paused && panel.Visible, "编辑器Esc未保留全局暂停行为");
+        Push(new InputEventKey { Keycode = Key.Escape, PhysicalKeycode = Key.Escape, Pressed = true });
+        await Frames();
+        Push(new InputEventKey { Keycode = Key.Escape, PhysicalKeycode = Key.Escape, Pressed = false });
+        Check(!GetTree().Paused && panel.Visible, "解除暂停时错误离开编辑器");
+        var changes = 0;
+        var changedEvent = typeof(BaigongPanel).GetEvent("FormationChanged");
+        Check(changedEvent is not null, "百工缺少公共配置变更通知");
