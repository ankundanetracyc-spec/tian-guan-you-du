+    private bool CanResolveIncomingResponse(GodotObject defender, BattleQueuedSkill action, GodotObject attacker)
+    {
+        if (!Alive(defender) || !Alive(attacker) || attacker.Get("faction").AsInt32() == defender.Get("faction").AsInt32()) return false;
+        return CanResolveSegmentAction(defender, action, responseTriggered: true);
+    }
+
+    /// <summary>Resolve the planned target at the actual settlement point, before any fee, use or cooldown is consumed.</summary>
+    private bool TryResolveSegmentTarget(GodotObject unit, BattleQueuedSkill action, out GodotObject? target)
+    {
+        target = null;
+        if (action.kind != BattleQueuedSkill.ActionKind.Skill) return true;
+        var skill = CardRules.NormalCast(action.skill);
+        if (skill is null) return true;
+        if (skill.target_type == 0)
+        {
+            if (!Alive(unit)) return false;
+            target = unit;
+            return true;
+        }
+
+        if (GodotObject.IsInstanceValid(action.target) && IsValidTarget(skill, unit, action.target))
+        {
+            target = action.target;
+            return true;
+        }
+
+        var candidates = all_units.Where(candidate => IsValidTarget(skill, unit, candidate)).ToList();
+        if (candidates.Count == 0) return false;
+        // An invalidated single target is retargeted from the current legal set at settlement.
+        target = candidates[GD.RandRange(0, candidates.Count - 1)];
+        action.target = target;
+        return true;
+    }
+
     private void SkipSegmentAction(GodotObject unit)
     {
         AdvanceSegmentSlot(unit, skipped: true);
diff --git a/csharp/debug/FormationDataSmoke.cs b/csharp/debug/FormationDataSmoke.cs
new file mode 100644
index 00000000..1af59740
--- /dev/null
+++ b/csharp/debug/FormationDataSmoke.cs
@@ -0,0 +1,359 @@
+using Godot;
+using Godot.Collections;
+using System;
+using System.Linq;
+
+/// <summary>验证阵图目录、资格、结构、深复制和 v8 Resource 往返；不触碰正式存档槽。</summary>
+public partial class FormationDataSmoke : Node
+{
+    private const string TemplatePath = "res://resources/formations/云息周天护持阵.tres";
+
+    private static void Check(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+        GD.Print("FORMATION_DATA_CHECK_OK " + message);
+    }
+
+    private static bool HasCode(FormationValidationResult result, string code) =>
+        result.Issues.Any(issue => issue.Code == code);
+
+    private static Array<string> FullManuals()
+    {
+        var manuals = new Array<string>();
+        manuals.Add("manual_small_circulation_input");
+        manuals.Add("manual_guard_output");
+        return manuals;
+    }
+
+    private static FormationWireData Wire(string from, string to) => new()
+    {
+        from_node_id = from,
+        to_node_id = to
+    };
+
+    public override void _Ready()
+    {
+        try
+        {
+            RunChecks();
+            GD.Print("FORMATION_DATA_SMOKE_OK");
+            GetTree().Quit();
+        }
+        catch (Exception error)
+        {
+            GD.PushError(error.ToString());
+            GetTree().Quit(1);
+        }
+    }
+
+    private void RunChecks()
+    {
+        var template = ResourceLoader.Load<FormationCircuitData>(TemplatePath);
+        Check(template is not null, "示范阵 Resource 可加载");
+        Check(template!.required_formation_proficiency == 30.0f, "三候示范资源存档门槛为 30");
+        Check(template.nodes.Count == 3 && template.pulse_wires.Count == 2, "示范阵恰有三类元件和两段串联脉纹");
+        Check(template.nodes.All(node => node.has_editor_position), "示范阵节点均保存编辑器位置");
+
+        var draft = FormationV1Catalog.CreateDefaultDraft();
+        Check(!ReferenceEquals(template, draft) && !ReferenceEquals(template.hardware, draft.hardware), "默认草稿与模板/硬件 Resource 独立");
+        Check(!ReferenceEquals(template.nodes, draft.nodes) && !ReferenceEquals(template.pulse_wires, draft.pulse_wires), "默认草稿数组独立");
+        Check(!ReferenceEquals(template.nodes[0], draft.nodes[0])
+              && !ReferenceEquals(template.nodes[0].accepted_source_tags, draft.nodes[0].accepted_source_tags), "默认草稿节点及节点数组独立");
+        Check(!ReferenceEquals(template.pulse_wires[0], draft.pulse_wires[0]), "默认草稿脉纹 Resource 独立");
+
+        draft.nodes[0].display_name = "草稿改名";
+        draft.nodes[0].accepted_source_tags.Add("spoof");
+        draft.hardware!.component_slots = 99;
+        draft.pulse_wires[0].to_node_id = "spoof";
+        Check(template.nodes[0].display_name == "术法感应枢"
+              && !template.nodes[0].accepted_source_tags.Contains("spoof")
+              && template.hardware!.component_slots == 4
+              && template.pulse_wires[0].to_node_id.ToString() == FormationV1Catalog.CounterNodeId,
+            "修改草稿不污染模板节点、硬件或脉纹");
+
+        var firstNode = FormationV1Catalog.CreateNode(FormationV1Catalog.InputNodeId);
+        var secondNode = FormationV1Catalog.CreateNode(FormationV1Catalog.InputNodeId);
+        firstNode.accepted_source_tags.Add("local-only");
+        Check(!ReferenceEquals(firstNode, secondNode)
+              && !secondNode.accepted_source_tags.Contains("local-only"), "目录重复创建同一元件仍返回独立 Resource");
+
+        var fullDraft = FormationV1Catalog.CreateDefaultDraft();
+        fullDraft.required_formation_proficiency = 5.0f;
+        fullDraft.required_manual_ids.Clear();
+        var fullAt30 = FormationCircuitService.Validate(fullDraft, 30.0f, FullManuals());
+        Check(fullAt30.IsValid, "三候链路在阵录齐全且造诣 30 时通过");
+        Check(fullAt30.Metrics.UsedSlots == 4 && fullAt30.Metrics.SlotCapacity == 4
+              && fullAt30.Metrics.Complexity == 4 && fullAt30.Metrics.ComplexityCapacity == 4,
+            "三候链路格位和复杂度实测为 4/4");
+        Check(fullAt30.Metrics.RequiredProficiency == 30.0f, "门槛从实际三候元件推导而非读取伪造声明字段");
+        Check(fullAt30.Metrics.SourceCapacity == 5 && fullAt30.Metrics.SourceRechargePerRound == 2
+              && fullAt30.Metrics.SourcePeak == 2 && fullAt30.Metrics.LinkPeak == 3
+              && fullAt30.Metrics.BoardLoad == 3,
+            "容量、补能、阵源峰值、灵络峰值和阵盘负荷读取有效硬件值");
+
+        var stressManuals = FullManuals();
+        for (var i = 0; i < 64; i++)
+        {
+            var candidate = FormationV1Catalog.CreateDefaultDraft();
+            if (!FormationCircuitService.Validate(candidate, 30.0f, stressManuals).IsValid
+                || FormationCircuitService.ValidateNodeAccess(
+                    FormationV1Catalog.InputNodeId, 5.0f, stressManuals).Count != 0)
+                throw new InvalidOperationException($"重复目录校验在第 {i + 1} 次失败");
+            if (i % 8 == 7)
+            {
+                GC.Collect();
+                GC.WaitForPendingFinalizers();
+                GC.Collect();
+            }
+        }
+        Check(true, "64 次目录/端口资格校验跨越强制 GC 保持稳定");
+
+        var belowCounter = FormationCircuitService.Validate(fullDraft, 29.0f, FullManuals());
+        Check(!belowCounter.IsValid && HasCode(belowCounter, "proficiency"), "造诣 29 不能使用三候枢");
+        var invalidProficiency = FormationCircuitService.Validate(fullDraft, float.NaN, FullManuals());
+        Check(!invalidProficiency.IsValid && HasCode(invalidProficiency, "proficiency"), "非有限造诣不能绕过资格检查");
+
+        var missingManual = FormationCircuitService.Validate(fullDraft, 30.0f,
+            new[] { "manual_small_circulation_input" });
+        Check(!missingManual.IsValid && HasCode(missingManual, "missing_manual"), "缺少护元阵录会拒绝完整阵图");
+
+        var inputManual = ResourceLoader.Load<FormationManualData>("res://resources/formations/小周天聚灵阵录.tres")!;
+        var spellPort = inputManual.input_ports.Single(port => port.port_id.ToString() == "port_spell_played");
+        var originalEvent = spellPort.battle_event;
+        try
+        {
+            spellPort.battle_event = "invalid_event";
+            Check(FormationCircuitService.ValidateNodeAccess(FormationV1Catalog.InputNodeId, 5.0f,
+                    new[] { "manual_small_circulation_input" }).Any(issue => issue.Code == "invalid_port"),
+                "真实输入阵录端口语义错误会拒绝单元件资格");
+        }
+        finally
+        {
+            spellPort.battle_event = originalEvent;
+        }
+
+        var inputAt5 = FormationCircuitService.ValidateNodeAccess(
+            FormationV1Catalog.InputNodeId, 5.0f, new[] { "manual_small_circulation_input" });
+        var counterAt29 = FormationCircuitService.ValidateNodeAccess(
+            FormationV1Catalog.CounterNodeId, 29.0f, FullManuals());
+        var counterAt30 = FormationCircuitService.ValidateNodeAccess(
+            FormationV1Catalog.CounterNodeId, 30.0f, FullManuals());
+        Check(inputAt5.Count == 0, "单元件入口认可真实输入端口及造诣 5");
+        Check(counterAt29.Any(issue => issue.Code == "proficiency") && counterAt30.Count == 0,
+            "单元件入口与整阵入口共享候枢 29/30 资格规则");
+
+        var directDraft = FormationCircuitService.CloneForEditing(fullDraft);
+        var counterIndex = directDraft.nodes.ToList().FindIndex(node => node.node_id.ToString() == FormationV1Catalog.CounterNodeId);
+        directDraft.nodes.RemoveAt(counterIndex);
+        directDraft.pulse_wires.Clear();
+        directDraft.pulse_wires.Add(Wire(FormationV1Catalog.InputNodeId, FormationV1Catalog.ActuatorNodeId));
+        directDraft.required_formation_proficiency = 999.0f;
+        directDraft.required_manual_ids.Clear();
+        var directAt5 = FormationCircuitService.Validate(directDraft, 5.0f, FullManuals());
+        Check(directAt5.IsValid && directAt5.Metrics.UsedSlots == 2
+              && directAt5.Metrics.Complexity == 2 && directAt5.Metrics.RequiredProficiency == 5.0f,
+            "感应→护持直连按实际两件元件在造诣 5 通过");
+
+        var empty = FormationV1Catalog.CreateDefaultDraft();
+        empty.nodes.Clear();
+        empty.pulse_wires.Clear();
+        var emptyResult = FormationCircuitService.Validate(empty, 30.0f, FullManuals());
+        Check(!emptyResult.IsValid && HasCode(emptyResult, "invalid_node"), "空节点/空脉纹输入安全拒绝且不抛异常");
+
+        var disconnected = FormationV1Catalog.CreateDefaultDraft();
+        disconnected.pulse_wires.Clear();
+        Check(HasCode(FormationCircuitService.Validate(disconnected, 30.0f, FullManuals()), "disconnected"),
+            "缺边链路被判为断连");
+
+        var cycle = FormationV1Catalog.CreateDefaultDraft();
+        cycle.pulse_wires.Add(Wire(FormationV1Catalog.ActuatorNodeId, FormationV1Catalog.InputNodeId));
+        Check(HasCode(FormationCircuitService.Validate(cycle, 30.0f, FullManuals()), "cycle"),
+            "回接脉纹被判为环路");
+
+        var bypass = FormationV1Catalog.CreateDefaultDraft();
+        bypass.pulse_wires.Add(Wire(FormationV1Catalog.InputNodeId, FormationV1Catalog.ActuatorNodeId));
+        Check(HasCode(FormationCircuitService.Validate(bypass, 30.0f, FullManuals()), "invalid_wire"),
+            "三节点链增加感应→护持旁路会被拒绝");
+
+        var noLayers = FormationV1Catalog.CreateDefaultDraft();
+        noLayers.hardware!.pulse_layers = 0;
+        Check(HasCode(FormationCircuitService.Validate(noLayers, 30.0f, FullManuals()), "invalid_hardware"),
+            "带脉纹的阵盘至少需要一层脉纹承载");
+
+        var tooFewSlots = FormationV1Catalog.CreateDefaultDraft();
+        tooFewSlots.hardware!.component_slots = 3;
+        Check(HasCode(FormationCircuitService.Validate(tooFewSlots, 30.0f, FullManuals()), "slots"),
+            "三候链路超出阵盘格位会被拒绝");
+        var tooLittleComplexity = FormationV1Catalog.CreateDefaultDraft();
+        tooLittleComplexity.hardware!.eye_complexity = 3;
+        Check(HasCode(FormationCircuitService.Validate(tooLittleComplexity, 30.0f, FullManuals()), "complexity"),
+            "三候链路超出阵眼复杂度会被拒绝");
+
+        var exhausted = FormationV1Catalog.CreateDefaultDraft();
+        exhausted.hardware!.source_capacity = 0;
+        exhausted.hardware.source_recharge_per_turn = 0;
+        exhausted.hardware.source_peak_output = 0;
+        exhausted.hardware.spirit_link_peak_output = 0;
+        exhausted.hardware.board_peak_load = 0;
+        exhausted.hardware.board_material_tags.Clear();
+        exhausted.hardware.ink_material_tags.Clear();
+        exhausted.hardware.eye_material_tags.Clear();
