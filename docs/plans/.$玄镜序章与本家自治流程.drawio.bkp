<mxfile host="app.diagrams.net" modified="2026-08-07T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="mirror-prologue-household-flow" name="玄镜序章与本家自治">
    <mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="玄镜序章与本家自治流程（拟定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f4d43;strokeColor=#d4b46a;fontColor=#fff2cc;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="30" width="980" height="64" as="geometry"/></mxCell>
        <mxCell id="legend_done" value="已实现 / 现有流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="190" height="42" as="geometry"/></mxCell>
        <mxCell id="legend_plan" value="待实现 / 待确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="190" height="42" as="geometry"/></mxCell>

        <mxCell id="start" value="序章开始&#xa;玄镜苏醒&#xa;&#xa;玩家：失忆的现代穿越者&#xa;状态：无法行动、被困镜中&#xa;时间：已不知过去多少年" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="pickup" value="孩童拾镜&#xa;&#xa;在溪边/山路捡起玄镜&#xa;带回普通山村宅院&#xa;&#xa;不直接说明玄镜能力&#xa;只让玩家确认：自己终于被带离原处" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=16;" vertex="1" parent="1"><mxGeometry x="410" y="180" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="routine" value="本家日常自动运行&#xa;&#xa;薄田、家务、休整已自成惯性&#xa;本家方针默认：维持生计&#xa;玩家无需逐人排日程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=16;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="observe" value="短旁观期（半日内完成）&#xa;&#xa;玩家可查看：&#xa;• 行止：劳作 / 家务 / 休整&#xa;• 宅院：亲属与居住关系&#xa;• 玄镜：体弱、心绪、亲近感（模糊）&#xa;&#xa;左侧目标：留意这户人家" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="160" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="trigger_observe" value="触发条件&#xa;到当夜&#xa;或任意查看一次行止/宅院" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#c29b50;fontColor=#473314;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1490" y="205" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="father_event" value="第一处异常：父亲察觉&#xa;&#xa;无光处镜面微亮；孩童拿镜时微热&#xa;父亲不懂修行、不跪拜、不认主&#xa;&#xa;他将镜子收进内屋，叮嘱孩子：&#xa;别带出去，也别同旁人说。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1730" y="160" width="350" height="210" as="geometry"/></mxCell>

        <mxCell id="father_role" value="父亲的定位&#xa;&#xa;普通山民的谨慎，而非知情修士&#xa;• 以家中旧物为由藏镜&#xa;• 不卖、不毁、不泄露&#xa;• 先保护家人与秘密&#xa;&#xa;→ 他是第一个主动维护玄镜的人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1730" y="450" width="350" height="190" as="geometry"/></mxCell>
        <mxCell id="free_observe" value="序章第一段结束：自由观察&#xa;&#xa;镜已在内屋，本家仍是普通农户&#xa;玄镜不知道自己能做什么&#xa;只开放有限的“感应族人”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1320" y="455" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="child_event" value="次日自然事件：幼子异状&#xa;&#xa;劳累、旧疾或睡梦不安&#xa;玄镜第一次看见他身上&#xa;一处可以触及的“空缺”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="try" value="玩家操作：触及异状&#xa;&#xa;仅出现一个无说明的“感应”操作&#xa;不显示灵根、命数或成功率&#xa;玩家只是在确认：镜子似乎能回应幼子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="330" height="170" as="geometry"/></mxCell>
        <mxCell id="fate_change" value="首次改命&#xa;&#xa;镜纹短亮，幼子发热/梦醒&#xa;玄镜意外改易其资质与命数&#xa;&#xa;本家特殊性来源：玄镜的介入&#xa;不是天生特殊血脉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="460" width="330" height="170" as="geometry"/></mxCell>

        <mxCell id="method" value="心念成法&#xa;&#xa;改命后，玄镜心中浮出陌生内容&#xa;玩家也不知其是否可靠&#xa;《明微抱元经》直接传入幼子心中&#xa;不作为仓房掉落物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="study" value="幼子研读与父亲遮掩&#xa;&#xa;幼子梦中得法、尝试记下文字&#xa;父亲只见异状与孩子变化&#xa;安排安静时间、遮掩外人耳目&#xa;&#xa;本家方针可切为：研读优先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="760" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="first_practice" value="第一卷学成&#xa;&#xa;幼子可开始吐纳&#xa;解锁：修行优先方针、卡牌装配&#xa;玄镜仍只拥有有限的观察与干预" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8eadc;strokeColor=#b67b4a;fontColor=#4a2d18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="900" y="760" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="family_arc" value="进入家族崛起主循环&#xa;&#xa;本家自治：方针决定方向，族人自动分工&#xa;玩家处理：玄镜干预、关键人物、异常事件&#xa;&#xa;后续解锁：日月精华 → 推演 / 加速 / 养成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1315" y="760" width="380" height="180" as="geometry"/></mxCell>

        <mxCell id="policy" value="本家自治（贯穿全程）&#xa;&#xa;维持生计：农事与休整&#xa;积材备工：劳作与采集&#xa;研读优先：有研读对象者自动研读&#xa;修行优先：可修行者自动修行&#xa;&#xa;“个体覆写”只给重点培养对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0e4;strokeColor=#6e8a70;fontColor=#1f3522;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1730" y="760" width="350" height="180" as="geometry"/></mxCell>

        <mxCell id="dialogue_title" value="对话框预览（序章）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3f4d43;strokeColor=#d4b46a;fontColor=#fff2cc;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="dialogue_1" value="心念微澜&#xa;&#xa;……&#xa;&#xa;我醒来已经很久了。久到连过了多少年都说不清。&#xa;&#xa;点击 / 空格继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101820;strokeColor=#c9a55b;fontColor=#e6edf0;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="1100" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="dialogue_2" value="心念微澜&#xa;&#xa;我动不了，只能困在这面镜子里。&#xa;&#xa;点击 / 空格继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101820;strokeColor=#c9a55b;fontColor=#e6edf0;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="540" y="1100" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="dialogue_3" value="心念微澜&#xa;&#xa;今天，有个孩子把我从溪边捡起，正带着我往一处山村走。&#xa;&#xa;点击 / 空格继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101820;strokeColor=#c9a55b;fontColor=#e6edf0;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1100" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="dialogue_4" value="心念微澜&#xa;&#xa;这孩子身上，有什么地方不太对。&#xa;&#xa;镜面似乎有了回应。&#xa;&#xa;［感应］" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101820;strokeColor=#c9a55b;fontColor=#e6edf0;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1460" y="1100" width="420" height="170" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6e8a70;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="pickup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6e8a70;endArrow=block;endFill=1;" edge="1" parent="1" source="pickup" target="routine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6e8a70;endArrow=block;endFill=1;" edge="1" parent="1" source="routine" target="observe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="observe" target="trigger_observe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="trigger_observe" target="father_event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="father_event" target="father_role"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="father_event" target="free_observe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="free_observe" target="child_event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="child_event" target="try"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="try" target="fate_change"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="fate_change" target="method"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="method" target="study"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b67b4a;endArrow=block;endFill=1;" edge="1" parent="1" source="study" target="first_practice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6e8a70;endArrow=block;endFill=1;" edge="1" parent="1" source="first_practice" target="family_arc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6e8a70;endArrow=block;endFill=1;" edge="1" parent="1" source="family_arc" target="policy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c9a55b;endArrow=block;endFill=1;" edge="1" parent="1" source="dialogue_1" target="dialogue_2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c9a55b;endArrow=block;endFill=1;" edge="1" parent="1" source="dialogue_2" target="dialogue_3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c9a55b;endArrow=block;endFill=1;" edge="1" parent="1" source="dialogue_3" target="dialogue_4"><mxGeometry relative="1" as="geometry"/></mxCell>
