<mxfile host="Electron" agent="Codex"><diagram id="base-deck-unlock" name="基础技能库总览"><mxGraphModel dx="1207" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f0df;strokeColor=#8b6f47;fontSize=22;fontStyle=1;" value="公共基础技能池总览&#xA;所有角色共用三项基础技能，不按路径分库" vertex="1"><mxGeometry height="80" width="680" x="620" y="30" as="geometry" /></mxCell><mxCell id="start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=left;spacingLeft=16;" value="所有角色&#xA;使用同一公共基础技能池&#xA;学会后按需装入技能槽；更换主修、辅修不切换技能池" vertex="1"><mxGeometry height="140" width="380" x="760" y="160" as="geometry" /></mxCell><mxCell id="common" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;align=left;spacingLeft=16;" value="公共基础技能池&#xA;&#xA;应敌、架招、痛击" vertex="1"><mxGeometry height="160" width="1100" x="410" y="360" as="geometry" /></mxCell><mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=16;spacingTop=10;" value="构筑与行动规则&#xA;① 所有角色共用一套公共基础技能池；技能学习后进入可装配池，由玩家安排技能槽。&#xA;② 秘籍卷章可授予主动技能；学会不等于自动装配。&#xA;③ 化法可追加公共基础技能池或本秘籍技能的效果，并保留原有效果。&#xA;④ 休整是所有角色自带的队列行动，不占技能栏或技能槽；回复 2 点体力，占一个行动位且不支付资源。战斗没有通用法力回复行动。&#xA;⑤ 气血、血炉、游骸、身法、炁、念等是公共构筑机制，由明确的技能、心法或秘籍调用，不与基础技能池绑定。" vertex="1"><mxGeometry height="220" width="800" x="560" y="580" as="geometry" /></mxCell><mxCell id="e1" edge="1" parent="1" source="start" style="endArrow=block;html=1;" target="common"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" edge="1" parent="1" source="common" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;" target="rules"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>