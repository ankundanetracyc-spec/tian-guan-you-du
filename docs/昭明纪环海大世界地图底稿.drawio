<mxfile host="app.diagrams.net" modified="2026-08-25T00:00:00.000Z" agent="Codex" version="26.0.16"><diagram id="zhaoming-5x5" name="昭明纪环海大世界"><mxGraphModel dx="1900" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="昭明纪 5×5 环海大世界地点表现底稿" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="note" value="25格仅为美术／加载格。地图只标可定位的实体地点与野外区域：坊市、客栈、委托等归入所属地点内部；道路与航路以线性标注呈现；临时异象不占永久节点。金色为州际共边，蓝色为州域止于海岸。" style="text;html=1;fontSize=13;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="1500" height="35" as="geometry"/></mxCell><mxCell id="terrain_master" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png;base64,;movable=0;resizable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="1500" height="1500" as="geometry"/></mxCell><mxCell id="cell0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillOpacity=0;strokeOpacity=0;fontSize=0;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="300" height="300" as="geometry"/></mxCell><mxCell id="cell1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillOpacity=0;strokeOpacity=0;fontSize=0;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="300" height="300" as="geometry"/></mxCell><mxCell id="cell2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillOpacity=0;strokeOpacity=0;fontSize=0;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="300" height="300" as="geometry"/></mxCell><mxCell id="cell3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillOpacity=0;strokeOpacity=0;fontSize=0;" vertex="1" parent="1"><mxGeometry x="950" y="110" width="300" height="300" as="geometry"/></mxCell><mxCell id="cell4"