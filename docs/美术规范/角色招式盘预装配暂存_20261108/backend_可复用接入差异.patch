+using Godot;
+using System.Text.Json;
+
+/// <summary>命名方案、预装配、真实战斗载入及隔离存档往返；不打开玩家旅程。</summary>
+public partial class CombatBoardPreparationSmoke : Node
+{
+    private const string Pill = "res://resources/entities/items/alchemy/huichun_1.tres";
+    private const string Folder = "res://docs/美术规范/角色招式盘预装配正式接入_20261108/";
+    private readonly List<object> _checks = [];
+    private Character _world = null!;
+    private Node2D? _battleScene;
+    private string _failure = "";
+    private void Check(bool passed, string name)
+    {
+        _checks.Add(new { name, passed });
+        if (!passed) throw new InvalidOperationException(name);
+        GD.Print("BOARD_PREPARATION_OK " + name);
+    }
+    private static string Stamp(CombatBoardLayout? layout) => layout is null ? "null" :
+        $"{layout.ResourceName}|{layout.size}|{layout.confirmed}|" + string.Join(";", layout.placements.Select(p =>
+            $"{p.placement_id}/{p.kind}/{p.source_key}/{p.cell}/{p.quarter_turns}/{p.rewrite_direction}/{p.expended}"));
+    private static string Plans(Character actor) => string.Join("\n", CombatBoardPreparationService.GetPlans(actor).Select(Stamp));
+    private static string Resources(Character actor) => $"{actor.current_health}|{actor.current_mana}|{actor.current_stamina}|{actor.used_spirit_perception}|{actor.current_world_stamina}|{actor.PillToxicity}|"
+        + string.Join(",", actor.pack_items) + "|" + string.Join(",", actor.pack_counts)
+        + "|" + actor.main_gongfa?.ResourcePath + "|" + string.Join(",", actor.sub_gongfa_list.Select(book => book.ResourcePath));
+    private async Task Frames(int count = 3)
+    { for (int i = 0; i < count; i++) await ToSignal(GetTree(), SceneTree.SignalName.ProcessFrame); }
+    private Character Actor(bool xuan = false)
+    {
+        var books = GongfaAvailability.EnabledBooks().Where(book => new[]
+            { "玄枢含章经", "斫基损契玄经", "百骸衍枝化生宝册", "太和感物养元宝册", "舒卷天章" }.Contains(book.gongfa_name));
+        var data = NpcCombatBuildPlanner.TestLearning(books);
+        data.main_gongfa_path = xuan ? HumanData.XuanShuBookPath : "";
+        data.sub_gongfa_paths.Clear();
+        var actor = new Character(); AddChild(actor); actor.load_from_data(data); actor.Hide(); return actor;
+    }
+    private static CombatBoardPlacement Skill(CombatBoardCatalog catalog, string title, int x, int y, string id) => new()
+    { placement_id = id, source_key = catalog.skills.First(s => s.skill_name == title).get_board_skill_key(), cell = new(x, y) };
+    private static CombatBoardPlacement Bottle(int x, int y, string id, bool expended = false) => new()
+    { placement_id = id, kind = CombatBoardPlacement.ObjectKind.Pill, source_key = Pill, cell = new(x, y), expended = expended };
+
+    public override void _Ready() => CallDeferred(nameof(Run));
+    private async void Run()
+    {
+        await RunChecks();
+        if (GodotObject.IsInstanceValid(_battleScene)) _battleScene!.QueueFree();
+        _battleScene = null;
+        if (GodotObject.IsInstanceValid(_world)) _world.QueueFree();
+        _world = null!;
+        await Frames(4);
+        // Release the completed scenario's native Array wrappers while the engine
+        // is still alive, after all of its async locals have left their task.
+        GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect();
+        await Frames(2);
+        GetTree().Quit(_failure.Length == 0 ? 0 : 1);
+    }
+    private async Task RunChecks()
+    {
+        try
