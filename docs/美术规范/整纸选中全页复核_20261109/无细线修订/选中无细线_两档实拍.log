await (async page=>{
 const root='http://127.0.0.1:8876/docs/美术规范/',out='output/playwright/整纸选中排查_20261109/';
 const states=[],errors=[],missing=[];
 page.on('pageerror',e=>errors.push(e.message));page.on('response',r=>{if(r.status()>=400)missing.push(r.url());});
 const client=await page.context().newCDPSession(page);await client.send('Network.setCacheDisabled',{cacheDisabled:true});
 async function load(path){
  await page.goto(root+path);await page.reload();await page.waitForFunction(()=>window.Materials&&document.querySelector('#stage [data-skinned]'));
  await page.evaluate(()=>document.fonts.ready);
  await page.addStyleTag({content:'.preview-tools,.review-bar,.preview-bar{display:none!important}#viewport{height:100vh!important}'});
  await page.evaluate(()=>window.dispatchEvent(new Event('resize')));
 }
 async function record(label,full=false){
  await page.mouse.move(2,2);await page.waitForTimeout(240);
  const controls=await page.locator('#stage :is(button,a)[data-skin]').evaluateAll(items=>items.filter(el=>el.matches('.is-selected,.is-selected-true,.selected,[aria-pressed="true"],[aria-selected="true"]')&&el.getClientRects().length).map(el=>({text:el.innerText.trim().slice(0,60),class:el.className,filter:getComputedStyle(el.querySelector(':scope>.skin-layer')).filter,center:[...el.querySelectorAll(':scope>.skin-layer .skin-center')].map(c=>getComputedStyle(c).filter),caption:[...el.querySelectorAll('.button-content,.tab-caption')].map(c=>getComputedStyle(c).backgroundColor)})));
  states.push({width:page.viewportSize().width,page:label,controls});
  if(full)await page.screenshot({path:out+label+'_'+page.viewportSize().width+'.png'});
 }
 for(const [width,height] of [[1920,1080],[1280,720]]){
  await page.setViewportSize({width,height});
  await load('角色与静室纸墨木石样稿_20261108/index.html#character/battle');
  for(const [id,name] of [['overview','人物概览'],['attributes','人物属性'],['battle','人物战斗'],['manuals','人物功法'],['proficiency','人物造诣'],['equipment','人物装备'],['relations','人物关系']]){
   await page.locator('[data-page="'+id+'"]').click();await record(name,id==='battle');
   if(id==='battle')await page.locator('[data-rf-owned-tab="skill"]').screenshot({path:out+'招式分类_'+width+'.png'});
  }
  await load('角色与静室纸墨木石样稿_20261108/index.html#quiet/practice');
  for(const [id,name] of [['practice','静室修行'],['study','静室研读'],['breakthrough','静室突破']]){
   await page.locator('[data-page="'+id+'"]').click();await record(name,id==='study');
  }
  await load('休息纸墨木石样稿_20261108/index.html');await record('休息',true);
  await load('炼丹纸墨木石样稿_20261108/index.html');await record('炼丹',true);
  await load('见闻任务纸墨木石样稿_20261108/index.html');
  for(const [id,name] of [['lore','见闻'],['tasks','任务'],['records','记录']]){
   await page.locator('[data-section="'+id+'"]').click();await record(name,true);
   await page.locator('.folder-tab[aria-selected="true"]').screenshot({path:out+name+'分类_'+width+'.png'});
  }
 }
 return {states:states.length,selectedControls:states.reduce((n,s)=>n+s.controls.length,0),unexpectedCenterFilters:states.flatMap(s=>s.controls.filter(c=>c.center.some(f=>f!=='none')).map(c=>({page:s.page,width:s.width,...c}))),errors,missing,details:states};
}
)(page);
