  "notices": {
    "city": {
      "title": "城中去处",
      "lines": [
        "南街多客栈，东市有坊市与书坊。看告示、寻城务，都到府前街。",
        "讲法在城守府前院，后侧另有研习处。西城旧巷多是民居，别随意闯人家的院门。"
      ]
    },
    "admission": {
      "title": "问道须知",
      "lines": [
        "在白石听过讲法、验过灵根，不等于已经拜入哪家宗门。",
        "要去玉虚问道，须自己到山门说明来意。资质与入门事宜，由山门照例核验。"
      ]
    }
  },
  "conversations": {
    "street_south": [
      {
        "id": "directions",
        "label": "问问城中去处",
        "lines": [
          "找买卖就往东市走，问城里的事去府前街。你若是为讲法来的，进城守府前院便是。",
          "第一次来，先把这几条街认清，往后就好走了。"
        ]
      }
    ],
    "street_east": [
      {
        "id": "market",
        "label": "打听这里的买卖",
        "lines": [
          "楼里楼外都有做买卖的，也有带东西来换的散修。东西在谁手里，就找谁当面谈。",
          "想看看书目，旁边书坊也能去坐坐。"
        ]
      }
    ],
    "street_fuqian": [
      {
        "id": "court",
        "label": "问问城守府",
        "lines": [
          "石阶上就是城守府。城里日常事务有城务人员处理，修士轮值驻守是另一回事。",
          "讲法前院与研习处也在府里，进了前厅再往侧院去。"
        ]
      }
    ],
    "street_west": [
      {
        "id": "lane",
        "label": "问问巷里的路",
        "lines": [
          "这里多是老宅，巷口看着窄，转出去仍接着南街。",
          "若是找讲法的地方，得去府前街。这边安静些，没什么大买卖。"
        ]
      }
    ],
    "inn": [
      {
        "id": "town",
        "label": "问问白石城",
        "lines": [
          "城里来往的客人不少，有赶路的，也有专为求道来的。",
          "你若还没定去处，先去告示所看看，再到东市找人打听。别只听一家就急着作决定。"
        ]
      }
    ],
    "market": [
      {
        "id": "bargain",
        "label": "问问交易规矩",
        "lines": [
          "想换什么，先跟人说清楚。双方出的东西都列明白了，合意再成交。",
          "也别只看桌上摆着什么，真正能拿来换的，得看对方愿意出手的货。"
        ]
      }
    ],
    "bookshop": [
      {
        "id": "firstbook",
        "label": "问问初学功法",
        "lines": [
          "挑功法，先看看首卷练什么、要什么条件。书名听着厉害，不见得现在就读得成。",
          "这期讲法的初学首卷，要先验灵，再向主持修士问清楚。书目归书目，能不能研习还得看来源和自身条件。"
        ]
      }
    ],
    "notice_hall": [
      {
        "id": "notices",
        "label": "问问告示上的事",
        "lines": [
          "城里公示的去处和办事安排，都在这边看。要听讲法，去城守府前院。",
          "告示是告示，入哪家宗门仍得自己决定，也要走人家山门的规矩。"
        ]
      }
    ],
    "city_office": [
      {
        "id": "rotation",
        "label": "问问轮值驻守",
        "lines": [
          "城里的日常事务由城务人员操持，宗门派来驻守的修士负责护持，也会按安排讲法。",
          "白石按城约由玉虚、镇岳观和抱朴山轮值。来这里听课，不是当场替哪家宗门收徒。"
        ]
      }
    ],
    "lecture_study": [
      {
        "id": "study",
        "label": "问问初学研习",
        "lines": [
          "先把自己选的首卷读明白，再依功法试着引气。不会的，回前院找当值修士问。",
          "别为了赶进度把该办的事拖着。与你同来的朋友若要返乡，也先说一声。"
        ]
      }
    ]
  }
