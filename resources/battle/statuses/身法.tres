[resource]
script = ExtResource("1")
effect_id = "身法"
name = "身法"
description = "持续增益，最多20层、持续1回合。每层使自身基础身法（dodge）提高1%；获得新层时刷新整个状态的持续时间；受击不消耗层数。获得状态的回合不扣时长，从下一完整回合结束时递减。"
max_stacks = 20
duration_default = 1
duration_type = 0
