script = ExtResource("1")
skill_name = "云岚三叠"
skill_type = 0
slot_category = "active"
source_gongfa_name = "舒卷天章"
description = "造成A点物理伤害。首段命中后，依次按C、D、E判定最多3段追加攻击；判定失败后仍继续检查下一项既有概率，判定成功时结算对应追加段。追加攻击未命中或目标离场时，后续攻击停止。每段追加攻击均攻击原目标，造成B点物理伤害。计算公式：A=round(8 + 体魄×0.50 + 剑道造诣×0.60)；B=round(4 + 体魄×0.30 + 剑道造诣×0.50 + max(本次行动开始时剑意层数−6,0)×4)；C=clamp(40% + 本次行动开始时剑意层数×5% + 剑道造诣×0.5%,40%,80%)；D=max(0%,C−20个百分点)；E=max(0%,C−40个百分点)。\n化法追加：追加判定失败后仍继续检查下一项既有概率；追加段数和C、D、E概率不变。"
tags = Array[String](["剑", "剑意"])
energy_cost = 2
mana_cost = 0
target_type = 2
attack_style = "melee"
damage_type = "physical"
damage_formula = "round(8 + 体魄×0.50 + 剑道造诣×0.60)"
uses_per_round = 0
icon_path = "res://textures/ui/combat/board_skill_icons/yunlan.png"
