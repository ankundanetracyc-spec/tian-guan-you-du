[resource]
script = ExtResource("1")
tags = Array[String](["生命","闪避","精力"])
skill_name = "补虚行血"
skill_type = 6
description = "主修或辅修槽位中的《补虚行血诀》自动提供本心法被动；开战时由战斗快照生效，不设心法槽位。本场首次气血由1层降至0层时，下一次由自身主动施放的催血技能少耗1点精力并额外获得气血1层。主修额外追加：该催血结算后获得身法1层。"
source_gongfa_name = "补虚行血诀"
keywords = Array[String](["固有"])
slot_category = "passive"
