description = "位于队首且受到敌方物理攻击时，获得 A 层化解；每层抵消本次攻击1点物理伤害，攻击结算后消散。A = 3 + floor(体魄/4) + floor(min(体魄*0.25,神魂*0.20))。本次架招抵消至少1点物理伤害后，攻击者失去 B 点护盾。B = min(攻击者当前护盾值, 本次架招实际抵消的物理伤害总点数)。"
energy_cost = 1
target_type = 0
range_min = 0
range_max = 0
stacks_formula = "3 + floor(physique/4) + floor(min(physique*0.25,soul*0.20))"
