skill_name = "赤阳参同"
skill_type = 6
description = "本心法由当前主修或辅修秘籍自动提供；战斗开始时作为常驻被动显示于Buff栏，持续至战斗结束。自身主动使气血下降时，本次不回复生命，改为获得血炉值，数值 = 本次气血下降层数×当前气血回落回复率R。其他气血回落效果仍触发。每当赤阳化法技能实际消耗血炉时，辅修每点消耗使该招物理伤害倍率提高1%，主修提高1.5%；仅作用于本招，不改血炉通用效果。技能结算后剩余血炉仍按公共规则每2点提高1%物理伤害。"
source_gongfa_name = "赤阳参同经"
keywords = Array[String](["固有"])
slot_category = "passive"
