script = ExtResource("1")
tags = Array[String](["生命","增伤"])
skill_name = "赤阳参同"
skill_type = 6
description = "主修或辅修槽位中的《赤阳参同经》自动提供本心法被动；开战时由战斗快照生效，不设心法槽位。自身主动使气血下降时，不回复生命，改为获得血炉值=下降层数×当前气血回落回复率R；其他气血回落效果仍触发。主修额外追加：本场首次实际消耗不少于20点血炉时，对该技能原目标追加1段物理伤害；伤害=round(4+体魄×0.25+体道造诣×0.15+实际消耗血炉×0.20)。"
source_gongfa_name = "赤阳参同经"
keywords = Array[String](["固有"])
slot_category = "passive"
