[gd_resource type="Resource" script_class="ActiveSkillData" format=3]

[ext_resource type="Script" path="res://csharp/gongfa/ActiveSkillData.cs" id="1"]

[resource]
script = ExtResource("1")
skill_name = "百骸衍枝化生"
skill_type = 6
slot_category = "passive"
source_gongfa_name = "百骸衍枝化生宝册"
icon_path = "res://textures/ui/combat/status_icons/心法_百骸衍枝化生_v3.png"
tags = Array[String](["气血"])
description = "心法被动：百骸衍枝化生\n关键词：气血\n效果：自身气血层数达到5层时显化1只手臂，最多显化1只。每次近身物理攻击结算时，显化的手臂追加一段A点（A=round(1 + 气血层数×0.15 + 体魄×0.10 + 体道造诣×0.15)）物理伤害；气血层数变化后立即重新判定显化状态。\n主修额外效果：手臂追加攻击伤害提高20%。"
