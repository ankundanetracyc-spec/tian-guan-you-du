[resource]
script = ExtResource("1")
skill_name = "玄枢含章"
skill_type = 6
slot_category = "passive"
icon_path = "res://textures/ui/combat/status_icons/心法_玄枢含章_v1.png"
source_gongfa_name = "玄枢含章经"
tags = Array[String](["周天"])
description = "心法被动：玄枢含章\n关键词：周天\n效果：招式盘内默认放置一枚单格周天指示，可移动转向、不能卸下。指向共边紧邻的一份非应对招式；每回合允许其在普通扫格之外，由周天额外施放一次，照常支付费用并检查原次数及冷却。无效指向或无合法目标时不施放、不付费。额外施放中再次周天只清炁、回满法力，不递归施放。"
