[sub_resource type="Resource" id="ChapterBingZhu"]
script = ExtResource("2")
chapter_id = "zhuo_ji_1"
chapter_name = "秉烛"
description = "以燃烧法力上限补足法力费用，开篇授予折锋。"
order = 1
required_study_progress = 24.0
required_realm = "凡人"
required_attributes = {"intelligence":5.0}
learn_permanent_bonuses = {"intelligence":0.5, "magic_proficiency":0.5}
left_branch_name = "修持"
right_branch_name = "化法"
learned_active_skills = Array[Resource]([ExtResource("5_zhefeng")])
combat_tempering_bonuses = {"max_mana_yunxi":1.0}
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("RewriteZheFengFirst")])
heart_method_description = "效果：法力不足的部分，可燃烧等量法力上限支付，至少保留1点法力上限；无法补足费用时，不可施展。\n主修额外效果：曾以燃烧法力上限支付过费用的技能，本场后续施展时，以等量体力替代法力费用。"

