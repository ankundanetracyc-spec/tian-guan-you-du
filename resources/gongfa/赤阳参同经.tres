[sub_resource type="Resource" id="ChapterFuHuo"]
script = ExtResource("2_chapter")
chapter_id = "fu_huo"
chapter_name = "伏火"
description = "立参同之炉，将主动气血回落炼为血炉；本卷起，赤阳化法消耗血炉时同时激发身法。"
order = 1
required_study_progress = 24.0
required_attributes = {"physique": 6.0}
learn_permanent_bonuses = {"physique": 1.0, "body_proficiency": 0.5}
left_branch_name = "修持"
right_branch_name = "化法"
combat_tempering_bonuses = {"max_health_percent": 15, "qi_blood_cap": 1}
sub_deck_rewrites = Array[ExtResource("7_rewrite")]([SubResource("RewritePingxi")])
heart_method_description = "效果：自身主动使气血层数降低时，本次气血回落不回复生命，改为获得血炉值：实际降低的气血层数×当前气血回落回复率R；其他气血回落效果照常触发。赤阳化法消耗血炉强化本招伤害时，每实际消耗1点血炉，本招伤害倍率提高1%。\n主修额外效果：赤阳化法每实际消耗1点血炉强化本招，本招伤害倍率再提高0.5个百分点；不改变血炉的公共效果。"


learn_bonus_revision = "study-balance-20261012"
previous_learn_permanent_bonuses = {"physique": 1.0}

