school_tags = Array[String](["body"])
body_nourish_rate_per_day = 0.8
body_nourish_weights = {"skin": 0.10, "sinew": 0.10, "bone": 0.10, "blood": 0.35, "viscera": 0.15, "heart": 0.20}
