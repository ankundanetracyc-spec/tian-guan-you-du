[sub_resource type="Resource" id="ChapterShouZhong"]
script = ExtResource("2_chapter")
chapter_id = "shou_zhong"
chapter_name = "守中"
description = "气血未尽时回落可积身法，气血归零时转得借力；主修在零气血时消耗身法与借力，以攻击换回气血。"
order = 1
required_study_progress = 24.0
required_attributes = {"physique": 5.0}
learn_permanent_bonuses = {"physique": 1.0, "body_proficiency": 0.5}
learned_active_skills = Array[Resource]([ExtResource("4_fanzhao")])
left_branch_name = "修持"
right_branch_name = "化法"
sub_deck_rewrites = Array[ExtResource("8_rewrite")]([SubResource("RewriteMissing1")])
combat_tempering_bonuses = {"max_health_percent": 15}
heart_method_description = "效果：自身主动使气血减少后，若仍有气血，获得身法1层；若气血降至0层，获得借力1层。\n主修额外效果：自身气血为0层且拥有身法时，本经给予的借力被自身物理伤害技能（《挟势》除外）消耗后，消耗身法1层并恢复气血1层。每回合限一次。"


learn_bonus_revision = "study-balance-20261012"
previous_learn_permanent_bonuses = {"physique": 1.0}

