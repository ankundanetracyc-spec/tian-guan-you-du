[resource]
script = ExtResource("1_gongfa")
gongfa_name = "黄庭养形篇"
description = "锻躯主修法。以主动气血回落换取身法与精力，再催血续接循环。"
wuxing = 0
can_be_main = true
can_be_sub = true
bearing_compatibility = Array[int]([1])
school_tags = Array[String](["body"])
body_nourish_rate_per_day = 0.8
body_nourish_weights = {"skin": 0.20, "sinew": 0.15, "bone": 0.15, "blood": 0.20, "viscera": 0.15, "heart": 0.15}
main_realm_start = "凡人"
main_realm_end = "云息十三层"
heart_method_skill = ExtResource("3_heart")
default_unlocked_chapter_count = 1
chapters = Array[ExtResource("2_chapter")]([SubResource("ChapterShouZhong"), SubResource("ChapterBaoYi"), SubResource("ChapterZhouXing"), SubResource("ChapterGuiCang")])
