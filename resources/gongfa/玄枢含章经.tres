[sub_resource type="Resource" id="ChapterJingzhe"]
script = ExtResource("2")
chapter_id = "shou_shu_1"
chapter_name = "蛰雷"
description = "完成周天时，使周天指示所指招式额外施放；每回合最多一次。"
order = 1
required_study_progress = 24.0
required_attributes = {"intelligence":5.0}
left_branch_name = "修持"
right_branch_name = "化法"
learn_permanent_bonuses = {"intelligence":0.5, "magic_proficiency":0.5}
learned_active_skills = Array[Resource]([ExtResource("5_jingzhe")])
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("RewriteJingzheC1")])
heart_method_description = "心法被动：玄枢含章\n关键词：周天\n效果：招式盘内默认放置一枚单格周天指示，可移动转向、不能卸下。指向共边紧邻的一份非应对招式；每回合允许其在普通扫格之外，由周天额外施放一次，照常支付费用并检查原次数及冷却。无效指向或无合法目标时不施放、不付费。额外施放中再次周天只清炁、回满法力，不递归施放。"

