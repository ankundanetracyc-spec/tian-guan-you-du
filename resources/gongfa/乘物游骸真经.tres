[resource]
script = ExtResource("1")
gongfa_name = "乘物游骸真经"
description = "气血、游骸与身法并行的锻躯真经：以肉身根基压住敌方，游骸整张避伤，再把已耗游骸化为反击。"
wuxing = 0
can_be_main = true
can_be_sub = true
bearing_compatibility = Array[int]([1])
school_tags = Array[String](["body"])
body_nourish_rate_per_day = 0.8
body_nourish_weights = {"skin": 0.25, "sinew": 0.40, "bone": 0.10, "blood": 0.10, "viscera": 0.05, "heart": 0.10}
main_realm_start = "凡人"
main_realm_end = "云息十三层"
heart_method_skill = ExtResource("3")
default_unlocked_chapter_count = 1
chapters = Array[Resource]([SubResource("one"), SubResource("two"), SubResource("three"), SubResource("four")])
