[sub_resource type="Resource" id="ChapterYangLuo"]
script = ExtResource("2")
chapter_id = "yang_luo"
chapter_name = "养络"
description = "引气血入络，显化第一只手臂。"
order = 1
required_study_progress = 24.0
required_realm = "凡人"
required_attributes = {"physique":5.0,"body_proficiency":0.0}
learn_permanent_bonuses = {"body_proficiency":0.5}
left_branch_name = "修持"
right_branch_name = "化法"
combat_tempering_bonuses = {"max_health_percent":5.0}
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("RewriteCuixueFirst")])
heart_method_description = "心法被动：百骸衍枝化生\n效果：自身气血层数达到5层时显化1只手臂，最多显化1只。每次近身攻击结算时，显化的手臂追加一段A点物理伤害；气血层数变化后立即重新判定显化状态。\n主修额外效果：手臂追加攻击伤害提高20%。\n计算公式：A=round(1 + 气血层数×0.15 + 体魄×0.10 + 体道造诣×0.15)。"

