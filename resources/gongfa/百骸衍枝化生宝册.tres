script = ExtResource("2")
chapter_id = "sheng_zhi"
chapter_name = "生枝"
description = "降低显化门槛，以单臂强化近身攻势。"
order = 2
required_study_progress = 48.0
required_realm = "云息三层"
required_attributes = {"physique":6.0,"body_proficiency":0.5}
required_chapter_ids = Array[String](["yang_luo"])
learn_permanent_bonuses = {"body_proficiency":0.5}
left_branch_name = "修持"
right_branch_name = "化法"
learned_active_skills = Array[Resource]([ExtResource("5_cuishan")])
combat_tempering_bonuses = {"physical_damage_percent":3.0}
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("RewriteCuishan")])
heart_method_upgrade_id = "baihai_c2"
heart_method_upgrade_description = "气血层数达到4层时显化1只手臂。"
heart_method_description = "心法被动：百骸衍枝化生\n效果：自身气血层数达到4层时显化1只手臂，最多显化1只。每次近身攻击结算时，显化的手臂追加一段A点物理伤害；气血层数变化后立即重新判定显化状态。\n主修额外效果：手臂追加攻击伤害提高20%。\n计算公式：A=round(1 + 气血层数×0.15 + 体魄×0.10 + 体道造诣×0.15)。"

[sub_resource type="Resource" id="ChapterShuangQing"]
script = ExtResource("2")
chapter_id = "shuang_qing"
chapter_name = "双擎"
description = "显化双臂，以自动应对化解近身来袭。"
order = 3
required_study_progress = 84.0
required_realm = "云息六层"
required_attributes = {"physique":8.0,"body_proficiency":1.0}
required_chapter_ids = Array[String](["sheng_zhi"])
learn_permanent_bonuses = {"body_proficiency":1.0}
left_branch_name = "修持"
right_branch_name = "化法"
combat_tempering_bonuses = {"max_health_percent":5.0}
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("RewriteJiazhaoThird")])
heart_method_upgrade_id = "baihai_c3"
heart_method_upgrade_description = "气血层数达到4层时显化第一只手臂，达到8层时显化第二只。双臂显化时，近身物理攻击可触发自动应对。"
heart_method_description = "心法被动：百骸衍枝化生\n效果：自身气血层数达到4层时显化第1只手臂，达到8层时显化第2只，最多显化2只。每次近身攻击结算时，每只显化手臂各追加一段A点物理伤害；气血层数变化后立即重新判定显化状态。双臂显化时，受到近身物理攻击并进入伤害结算前，每个来袭技能至多判定一次：以B概率自动应对，获得C层化解；触发后，本次来袭攻击结算完毕时气血层数降低1层，并触发气血层数降低时的回复效果。\n主修额外效果：每段手臂追加攻击伤害提高20%。\n计算公式：A=round(1 + 气血层数×0.20 + 体魄×0.12 + 体道造诣×0.20)；B=clamp(30% + 4%×(自身气血层数−攻击者气血层数) + 0.5%×自身体魄 + 1%×体道造诣 − 0.5%×攻击者体魄, 5%, 80%)；C=round(1 + 气血层数×0.20 + 体魄×0.10 + 体道造诣×0.20)。"

