[sub_resource type="Resource" id="Chapter1"]
script = ExtResource("2")
chapter_id = "yusui_c1"
chapter_name = "涤络"
order = 1
required_study_progress = 24.0
required_realm = "凡人"
required_attributes = {"physique": 5, "body_proficiency": 0}
required_chapter_ids = Array[String]([])
learn_permanent_bonuses = {"physique": 0.5, "body_proficiency": 0.5}
combat_tempering_bonuses = {"max_health_percent": 10.0}
heart_method_upgrade_id = "yusui_c1"
heart_method_upgrade_description = "心法被动：玉髓回澜\n关键词：气血、护盾\n效果：气血层数降低产生回复时，超出生命缺口的回复量的50%转为A点护盾。\n主修额外效果：自身护盾被敌方攻击耗尽后，获得气血1层；每回合限一次。\n计算公式：A=floor(max(0,本次气血回落应回复量−本次实际回复量)×0.50)。"
heart_method_description = "心法被动：玉髓回澜\n关键词：气血、护盾\n效果：气血层数降低产生回复时，超出生命缺口的回复量的50%转为A点护盾。\n主修额外效果：自身护盾被敌方攻击耗尽后，获得气血1层；每回合限一次。\n计算公式：A=floor(max(0,本次气血回落应回复量−本次实际回复量)×0.50)。"
sub_deck_rewrites = Array[ExtResource("3")]([SubResource("Rewrite1")])
learned_active_skills = Array[Resource]([ExtResource("skill0")])

