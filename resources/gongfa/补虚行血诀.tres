[sub_resource type="Resource" id="a"]
script=ExtResource("2")
chapter_id="buxu"
chapter_name="补虚"
description="以气血见底为转机，建立零层回填循环。"
order=1
combat_tempering_bonuses = {"max_health_percent": 15, "qi_blood_cap": 1}
required_study_progress=24.0
required_attributes = {"physique": 5.0}
learn_permanent_bonuses = {"physique": 1.0, "body_proficiency": 0.5}
learned_active_skills=Array[Resource]([ExtResource("4")])
learned_world_spells=Array[Resource]([ExtResource("world_spell_buxu")])
sub_deck_rewrites = Array[ExtResource("5_rewrite")]([SubResource("RewriteMissing4")])
heart_method_description = "效果：自身主动使气血由1层降至0层后，下一次主动施展的催血少耗精力1点，且额外获得气血1层；强化待触发期间不叠加，催血结算后清除，可由之后新的1层降至0层再次准备。\n主修额外效果：受本心法强化的催血结算后，额外获得身法2层。"


learn_bonus_revision = "study-balance-20261012"
previous_learn_permanent_bonuses = {"physique": 1.0}

