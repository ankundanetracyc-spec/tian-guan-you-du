[sub_resource type="Resource" id="Guard"]
script = ExtResource("2")
upgrade_id = "body_guard"
branch_group = "body_style"
upgrade_name = "卸劲"
description = "体术造诣达到14后，锻躯技能库中的部分卸力替换为避锋。"
