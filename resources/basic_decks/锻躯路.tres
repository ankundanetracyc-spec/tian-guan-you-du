[resource]
script = ExtResource("1")
deck_name = "锻躯基础技能库"
deck_description = "当前主修侧重为锻躯时使用；更换主修可切换基础技能库，三途养成进度保留；以精力维持应对、以气血调度肉身；包含发劲、催血、平息、卸力、撼山。"
required_dao_bearing = 1
upgrade_branches = Array[ExtResource("2")]([SubResource("Heavy"), SubResource("Guard")])
skill_entries = Array[Dictionary]([{ "path": "res://resources/activeskills/发劲.tres", "count": 5 }, { "path": "res://resources/activeskills/催血.tres", "count": 2 }, { "path": "res://resources/activeskills/平息.tres", "count": 1 }, { "path": "res://resources/activeskills/卸力.tres", "count": 4 }, { "path": "res://resources/activeskills/撼山.tres", "count": 1 }])
