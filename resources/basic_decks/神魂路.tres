[gd_resource type="Resource" script_class="BasicDeckResource" format=3]

[ext_resource type="Script" path="res://csharp/gongfa/BasicDeckResource.cs" id="1"]
[ext_resource type="Script" path="res://csharp/gongfa/BasicDeckUpgradeConfig.cs" id="2"]

[sub_resource type="Resource" id="Break"]
script = ExtResource("2")
upgrade_id = "soul_break"
branch_group = "soul_style"
upgrade_name = "裂识"
description = "神魂达到16后，解锁摄魂技能。"
required_attributes = {"soul": 16.0}
additions = Array[Dictionary]([{ "path": "res://resources/activeskills/摄魂.tres", "count": 1 }])

[sub_resource type="Resource" id="Guard"]
script = ExtResource("2")
upgrade_id = "soul_guard"
branch_group = "soul_style"
upgrade_name = "守念"
description = "灵慧达到14后，蕴神技能库中的护元可替换为避锋。"
required_attributes = {"intelligence": 14.0}
replacements = Array[Dictionary]([{ "source_path": "res://resources/activeskills/护元.tres", "result_path": "res://resources/activeskills/避锋.tres", "count": 2 }])

[resource]
script = ExtResource("1")
deck_name = "蕴神基础技能库"
deck_description = "当前主修侧重为蕴神时使用；更换主修可切换基础技能库，三途养成进度保留；以行炁底板为基础，使用魂刺、聚息、避锋、护元与摄魂。"
required_dao_bearing = 3
upgrade_branches = Array[ExtResource("2")]([SubResource("Break"), SubResource("Guard")])
skill_entries = Array[Dictionary]([{
"path": "res://resources/activeskills/魂刺.tres",
"count": 5
}, {
"path": "res://resources/activeskills/聚息.tres",
"count": 2
}, {
"path": "res://resources/activeskills/避锋.tres",
"count": 1
}, {
"path": "res://resources/activeskills/护元.tres",
"count": 4
}, {
"path": "res://resources/activeskills/摄魂.tres",
"count": 1
}])
