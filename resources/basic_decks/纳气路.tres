[ext_resource type="Script" path="res://csharp/gongfa/BasicDeckUpgradeConfig.cs" id="2"]

[sub_resource type="Resource" id="Burst"]
script = ExtResource("2")
upgrade_id = "qi_burst"
branch_group = "qi_style"
upgrade_name = "聚爆"
description = "灵慧达到14后，解锁灵爆技能。"
required_attributes = {"intelligence": 14.0}
additions = Array[Dictionary]([{ "path": "res://resources/activeskills/灵爆.tres", "count": 1 }])

[sub_resource type="Resource" id="Guard"]
script = ExtResource("2")
upgrade_id = "qi_guard"
branch_group = "qi_style"
upgrade_name = "灵盾"
description = "术法造诣达到14后，行炁技能库中的护元可替换为避锋。"
required_attributes = {"magic_proficiency": 14.0}
replacements = Array[Dictionary]([{ "source_path": "res://resources/activeskills/护元.tres", "result_path": "res://resources/activeskills/避锋.tres", "count": 2 }])

[resource]
script = ExtResource("1")
deck_name = "纳气基础技能库"
deck_description = "当前主修侧重为行炁时使用；更换主修可切换基础技能库，三途养成进度保留；以灵击、聚息、避锋、护元与灵爆组成。"
required_dao_bearing = 2
upgrade_branches = Array[ExtResource("2")]([SubResource("Burst"), SubResource("Guard")])
skill_entries = Array[Dictionary]([{
"path": "res://resources/activeskills/灵击.tres",
"count": 5
}, {
"path": "res://resources/activeskills/聚息.tres",
"count": 2
}, {
"path": "res://resources/activeskills/避锋.tres",
"count": 1
}, {
"path": "res://resources/activeskills/护元.tres",
"count": 4
}, {
