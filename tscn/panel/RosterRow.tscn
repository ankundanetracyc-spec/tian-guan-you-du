theme_override_colors/font_color = Color(0.1, 0.09, 0.07, 1)
theme_override_font_sizes/font_size = 25
text = "李"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Frame" type="TextureRect" parent="Columns/Avatar"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_portrait_frame")
expand_mode = 1
stretch_mode = 5
z_index = 2


[node name="Person" type="VBoxContainer" parent="Columns"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
size_flags_vertical = 3

[node name="Name" type="Label" parent="Columns/Person"]
