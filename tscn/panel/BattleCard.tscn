[sub_resource type="Shader" id="card_icon_round_mask"]
code = "shader_type canvas_item;

// 直接在图标自身上写透明度蒙版；不会影响纹理颜色，也不会裁掉整张图标。
void fragment() {
	vec2 point = UV - vec2(0.5);
	float radius = 0.055;
	vec2 half_size = vec2(0.5 - radius);
	vec2 corner = abs(point) - half_size;
	float distance_to_corner = length(max(corner, vec2(0.0))) + min(max(corner.x, corner.y), 0.0) - radius;
	vec4 texel = texture(TEXTURE, UV);
	texel.a *= 1.0 - smoothstep(0.0, 0.004, distance_to_corner);
	COLOR = texel * COLOR;
}
"

