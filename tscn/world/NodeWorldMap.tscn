[node name="Roads" type="Node2D" parent="WorldMapViewport/MapRoot/BaiChuanMapLayers" unique_id=1758944708]
editor_description = "百川道路层：使用浅色窄幅路面单位纹理，折线路径沿河谷与山前缓坡布置，避开峰脊；路线之间不交叉，所有换向与汇合都落在场景节点上。道路绘制与角色移动共用同一点列；编辑器中只调整各路线的 *_Ink 点列。"
z_index = 1
script = ExtResource("18_7vko0")

